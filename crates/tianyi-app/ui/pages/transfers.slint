// 传输任务中心：筛选 + 虚拟化列表 + 暂停/继续/取消/重试/移除
//
// 任务状态完全由 Rust 侧状态机给出（status 字段），本页只做展示与派发，
// 不自行推断"能不能暂停"，避免界面与真实任务状态不一致。

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { FluentButton } from "../components/button.slint";
import { FluentSegmented } from "../components/segmented.slint";
import { TransferRow } from "../components/transfer-row.slint";
import { FluentEmptyState } from "../components/state-view.slint";
import { TransferEntry, TooltipState } from "../types.slint";

export component TransfersPage inherits Rectangle {
    in property <[TransferEntry]> rows: [];
    in-out property <int> filter: 0;
    in property <string> status-text: "";
    in property <int> active-count: 0;
    in property <int> finished-count: 0;

    callback filter-changed(int);
    callback pause-task(int);
    callback resume-task(int);
    callback cancel-task(int);
    callback retry-task(int);
    callback remove-task(int);
    callback reveal-task(int);
    callback clear-finished();
    callback open-download-dir();

    background: Theme.window-bg;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // ---------------- 标题栏 ----------------
        HorizontalLayout {
            height: Theme.header-height;
            spacing: Theme.space-3;
            cross-axis-alignment: center;

            Text {
                text: "传输任务";
                font-family: Theme.font-family;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            FluentSegmented {
                width: 300px;
                items: ["全部", "进行中", "已完成", "失败/取消"];
                current: root.filter;
                changed(idx) => {
                    root.filter = idx;
                    root.filter-changed(idx);
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 1px;
                background: transparent;
            }

            FluentButton {
                text: "打开下载目录";
                icon: IconName.folder-open;
                subtle: true;
                clicked => {
                    root.open-download-dir();
                }
            }

            FluentButton {
                text: "清理已完成";
                icon: IconName.delete;
                subtle: true;
                enabled: root.finished-count > 0;
                clicked => {
                    root.clear-finished();
                }
            }
        }

        // ---------------- 列表（超宽窗口下限制内容宽度并居中） ----------------
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            Rectangle {
                width: Math.min(parent.width, Theme.content-max-width);
                vertical-stretch: 1;
                border-radius: Theme.radius-card;
                background: Theme.layer-bg;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;

                ListView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;

                    // 滚动即收起 Tooltip：行被回收时行内按钮不会收到 has-hover=false，
                    // 气泡会挂在旧位置指着已回收的行。滚轮/拖动滚动条/触摸板滑动都会
                    // 改 viewport-y，不必另加覆盖全窗的 TouchArea 去截 MouseWheel。
                    changed viewport-y => {
                        TooltipState.visible = false;
                    }

                    for task in root.rows : TransferRow {
                        entry: task;
                        pause-clicked => {
                            root.pause-task(task.id);
                        }
                        resume-clicked => {
                            root.resume-task(task.id);
                        }
                        cancel-clicked => {
                            root.cancel-task(task.id);
                        }
                        retry-clicked => {
                            root.retry-task(task.id);
                        }
                        remove-clicked => {
                            root.remove-task(task.id);
                        }
                        reveal-clicked => {
                            root.reveal-task(task.id);
                        }
                    }
                }

                if root.rows.length == 0: FluentEmptyState {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    icon: IconName.transfer;
                    title: root.filter == 0 ? "还没有传输任务" : "该分类下没有任务";
                    description: root.filter == 0
                        ? "上传或下载文件后，任务进度会显示在这里，可随时暂停与继续"
                        : "切换到“全部”查看其他任务";
                    action-text: root.filter == 0 ? "" : "查看全部";
                    action => {
                        root.filter = 0;
                        root.filter-changed(0);
                    }
                }
            }
        }

        // ---------------- 状态栏 ----------------
        HorizontalLayout {
            height: Theme.statusbar-height;
            spacing: Theme.space-3;
            cross-axis-alignment: center;

            Text {
                text: root.status-text;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: "进行中 " + root.active-count + " · 已结束 " + root.finished-count;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }
}