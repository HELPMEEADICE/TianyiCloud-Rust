// 下载直链页
//
// 说明：当前客户端只实现了“解析文件下载直链”（getDownloadUrl）这一能力，
// 并未实现分享链接的创建/管理接口，因此页面标题、导航项与文案都按真实能力命名，
// 不使用“分享链接”这类与实际能力不符的名称。

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { FluentButton } from "../components/button.slint";
import { FluentIconButton } from "../components/icon-button.slint";
import { FluentEmptyState } from "../components/state-view.slint";
import { TooltipState } from "../types.slint";

export struct DirectLink {
    name: string,
    url: string,
}

export component LinksPage inherits Rectangle {
    in property <[DirectLink]> links: [];
    in property <string> status-text: "";

    callback copy-link(string);
    /// 用系统默认浏览器打开某条直链
    callback open-link(string);
    /// 把列表里的全部直链按行拼起来复制到剪贴板
    callback copy-all-links();
    callback go-personal();
    callback clear-links();

    background: Theme.window-bg;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            height: Theme.header-height;
            spacing: Theme.space-3;
            cross-axis-alignment: center;

            Text {
                text: "下载直链";
                font-family: Theme.font-family;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            Text {
                text: "从云盘文件解析出的下载直链，可复制到浏览器或下载工具使用";
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            FluentButton {
                text: "复制全部";
                icon: IconName.copy;
                subtle: true;
                enabled: root.links.length > 0;
                clicked => {
                    root.copy-all-links();
                }
            }

            FluentButton {
                text: "清理列表";
                subtle: true;
                enabled: root.links.length > 0;
                clicked => {
                    root.clear-links();
                }
            }

            FluentButton {
                text: "返回云盘";
                icon: IconName.back;
                subtle: true;
                clicked => {
                    root.go-personal();
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            Rectangle {
                width: Math.min(parent.width, Theme.content-max-width);
                vertical-stretch: 1;
                border-radius: Theme.radius-card;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;

                ListView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;

                    // 滚动即收起 Tooltip：行被回收时行尾的图标按钮不会收到 has-hover=false，
                    // 气泡会挂在旧位置指着已回收的行。滚轮/拖动滚动条/触摸板滑动都会
                    // 改 viewport-y，不必另加覆盖全窗的 TouchArea 去截 MouseWheel。
                    changed viewport-y => {
                        TooltipState.visible = false;
                    }

                    for item in root.links : Rectangle {
                        height: 56px;
                        background: link-ta.has-hover ? Theme.hover-bg : transparent;

                        link-ta := TouchArea {
                            mouse-cursor: pointer;

                            // 行单击 = 在浏览器中打开（不可用时由控制器弹 error 提示）。
                            // 复制仍是显式动作：行尾复制按钮 + 顶部“复制全部”，
                            // 不存在双击/长按这类隐式手势。
                            clicked => {
                                root.open-link(item.url);
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-2;
                                spacing: Theme.space-3;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    border-radius: 8px;
                                    background: Theme.accent-soft;

                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: IconName.link;
                                        size: Theme.icon-sm;
                                        icon-color: Theme.accent;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: item.name;
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-body;
                                        font-weight: Theme.weight-semibold;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: item.url;
                                        font-family: Theme.mono-font-family;
                                        font-size: Theme.font-caption;
                                        color: Theme.text-tertiary;
                                        overflow: elide;
                                    }
                                }

                                FluentIconButton {
                                    icon: IconName.copy;
                                    tooltip: "复制直链";
                                    clicked => {
                                        root.copy-link(item.url);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.links.length == 0: FluentEmptyState {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    icon: IconName.link;
                    title: "还没有提取过直链";
                    description: "在个人云或家庭云中选中文件，使用“提取直链”即可在这里看到结果";
                    action-text: "去个人云";
                    action => {
                        root.go-personal();
                    }
                }
            }
        }

        HorizontalLayout {
            height: Theme.statusbar-height;
            cross-axis-alignment: center;

            Text {
                text: root.status-text;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}