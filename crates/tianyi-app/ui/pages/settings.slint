// 设置页：外观 / 传输 / 账号 / 关于
//
// 版式对齐 Windows 11 设置应用：
//   页面标题 → 单列分组卡片（最大宽度 settings-max-width 居中）→ 统一设置行
// 每个 SettingsRow 都是"左名称/说明 + 右控件"，行高、分隔线、间距只在
// components/settings-section.slint 里定义一次。
//
// 只放真正生效的开关：主题、减少动画、默认下载目录、并发分片数、退出登录。
// 每一项都直接调用控制器，不存在"点了没反应"的控件。
//
// 「并发分片数」的 −/+ 只是上报"用户点了一下"，钳制到 1..=8、写回 AppConfig、
// 回填显示值全部在控制器里完成（`Controller::set_thread_counts`）：如果这里自己也
// 钳制一遍，两边规则迟早会漂移，界面上就会出现"显示 9 但实际按 8 跑"的情况。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { TooltipState } from "../types.slint";
import { FluentButton } from "../components/button.slint";
import { FluentIconButton } from "../components/icon-button.slint";
import { FluentSegmented } from "../components/segmented.slint";
import { FluentSwitch } from "../components/switch.slint";
import { SettingsSection, SettingsRow, SettingsDivider } from "../components/settings-section.slint";

// 只读路径行：等宽字体 + 省略 + 悬停显示完整路径 + 复制按钮 + 可选的同行操作按钮
//
// 路径与操作放在同一行：长路径走省略号，右侧按钮永不被挤出窗口。
component PathRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";
    /// 同行操作按钮文案（空则不显示）
    in property <string> action-text: "";

    callback copy();
    callback action();

    alignment: space-between;
    spacing: Theme.space-3;
    cross-axis-alignment: center;

    VerticalLayout {
        max-width: 560px;
        spacing: Theme.space-1;
        alignment: center;

        Text {
            text: root.label;
            font-family: Theme.font-family;
            font-size: Theme.font-body-large;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        // 省略显示 + 悬停完整性查看，避免长路径把右侧按钮挤出窗口。
        // 用 max-width 而不是 Math.min(parent.width, ...)：后者会与父布局的首选宽度
        // 形成绑定环（width → layoutinfo-h → width）。
        path-box := Rectangle {
            height: 24px;
            max-width: 520px;
            background: transparent;

            Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.value;
                font-family: Theme.mono-font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                overflow: elide;
            }

            hover := TouchArea {
                // 抢占 + 归属判定：先认领归属键再点亮，收尾只关自己点亮的那盏
                changed has-hover => {
                    if (self.has-hover && root.value != "") {
                        TooltipState.owner = "path:" + root.label;
                        TooltipState.text = root.value + (root.hint == "" ? "" : (" · " + root.hint));
                        TooltipState.x = self.absolute-position.x;
                        TooltipState.y = self.absolute-position.y + self.height + 4px;
                        TooltipState.visible = true;
                    } else if (TooltipState.owner == "path:" + root.label) {
                        TooltipState.visible = false;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-1;
        cross-axis-alignment: center;

        if root.action-text != "": FluentButton {
            text: root.action-text;
            clicked => {
                root.action();
            }
        }

        FluentIconButton {
            icon: IconName.copy;
            tooltip: @tr("复制路径");
            enabled: root.value != "";
            clicked => {
                root.copy();
            }
        }
    }
}

// 并发分片数步进器：标签 + 「−」+ 数值 + 「+」
//
// 为什么用 FluentButton(subtle) 而不是自绘按钮：
// * 高度沿用 Theme.control-height（32px），离 SettingsRow 的 48px 行高还有余量，
//   因此设置行的高度与分隔线节奏完全不变；
// * 悬停/按下/禁用/动画与页面其它按钮共用同一份实现，不新增任何颜色字面量；
// * 边界用 `enabled` 表达，用户一眼能看到"到顶了"，而不是点了没反应。
component ThreadStepper inherits HorizontalLayout {
    in property <string> label: "";
    /// 显示用的数字（控制器按 AppConfig 回填，字符串形态避免二次格式化）
    in property <string> value: "";
    /// 数值形态：只用于判断 −/+ 是否已经到达 1 / 8 边界
    in property <int> count: 1;

    /// 用户点了方向：-1 = 减一，+1 = 加一（越界钳制在控制器里做）
    callback step(int);

    spacing: Theme.space-1;
    cross-axis-alignment: center;

    Text {
        text: root.label;
        font-family: Theme.font-family;
        font-size: Theme.font-small;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    FluentButton {
        text: "−";
        subtle: true;
        enabled: root.count > 1;
        clicked => {
            root.step(-1);
        }
    }

    Text {
        text: root.value;
        min-width: 16px;
        horizontal-alignment: center;
        font-family: Theme.font-family;
        font-size: Theme.font-small;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    FluentButton {
        text: "+";
        subtle: true;
        enabled: root.count < 8;
        clicked => {
            root.step(1);
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <string> account-name: "";
    /// 0 = 跟随系统，1 = 浅色，2 = 深色
    in-out property <int> theme-index: 0;
    /// 0 = 自动（跟随系统），1 = 简中，2 = 繁中，3 = 英文，4 = 日文
    in-out property <int> language-index: 0;
    in property <bool> reduce-motion: false;
    in property <string> download-dir: "";
    in property <string> upload-thread: "";
    in property <string> download-thread: "";
    /// 并发分片数的数值形态：只用来决定 −/+ 的可用边界（1..=8），
    /// 显示仍然取上面的字符串，避免同一数字被格式化两次
    in property <int> upload-thread-count: 3;
    in property <int> download-thread-count: 4;
    /// 速度限制的分段索引：0..=4 是预设档，**-1 = 配置里是非预设值**（五段都不高亮）
    in-out property <int> speed-limit-index: 0;
    /// 非预设档时的行内小字（含真实速率，如「当前 3.00 MB/s（自定义）」）；
    /// 预设档为空串。文案由控制器按当前语种拼好推来，`@tr` 绑不住它。
    in property <string> speed-limit-text: "";
    in property <string> version-text: "";
    in property <string> config-dir: "";
    /// 日志目录（配置目录下的 logs/），由控制器在初始化时回填
    in property <string> log-dir: "";

    callback theme-changed(int);
    /// 0=自动 1=简中 2=繁中 3=英文 4=日文；落盘与切包由控制器负责
    callback language-changed(int);
    callback reduce-motion-changed(bool);
    callback choose-download-dir();
    /// (下载分片数, 上传分片数)：值可能越界，钳制由控制器负责
    callback thread-count-changed(int, int);
    /// 速度限制的分段索引；映射成字节/秒、落盘、回填都由控制器负责
    callback speed-limit-changed(int);
    callback open-config-dir();
    callback open-log-dir();
    callback copy-text(string);
    callback logout();

    background: Theme.window-bg;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // ---------------- 页面标题 ----------------
        HorizontalLayout {
            height: Theme.header-height;
            cross-axis-alignment: center;

            Text {
                text: @tr("设置");
                font-family: Theme.font-family;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // ---------------- 内容（单列居中，最大宽度 880px） ----------------
        ScrollView {
            vertical-stretch: 1;

            HorizontalLayout {
                alignment: center;
                // 内容列不参与**纵向**弹性分配（D-26）。这一行决定了四张卡片的高度只由内容
                // 决定，而不是由视口高度决定。
                //
                // 弹性分配发生在两层，缺一不可：
                //  1. `ScrollView` 的内容盒会被拉到「至少和视口一样高」（内容比视口矮时）；
                //  2. `HorizontalLayout` 的交叉轴对齐默认 `stretch`，于是这一列被撑成内容盒
                //     的高度（实测 1920×1080 下是 1008px，而卡片按内容只需要 873px）；
                //  3. 列里的 `VerticalLayout`（`alignment` 默认 `stretch`）再把这 135px 余量
                //     均摊给四张卡片（`i-slint-core/layout.rs::solve_box_layout` →
                //     `adjust_items`），每张 +33.8px，卡片内部于是多出大块空白，反方向
                //     （内容比视口高）又会把卡片压扁、末行被卡片下缘切掉。
                // 改成 `start` 后这一列只拿自己的首选高度，纵向余量与溢出全部还给 ScrollView：
                // 矮窗口照旧滚动，高窗口在卡片下方留一块背景（Win11 设置页同样如此，列表
                // 靠上排列、不拉伸）。
                //
                // 为什么不是给四个 `SettingsSection` 加 `vertical-stretch: 0`：盒布局在
                // **所有**子项 stretch 都为 0 时会退化成「把余量平均分给每个可增长项」
                // （`adjust_items` 里 `total_stretch <= 0` 的兜底分支），实测那四行一句
                // 都没起作用，卡片照旧各自 +33.8px。
                cross-axis-alignment: start;

                VerticalLayout {
                    // 用页面根宽度而不是 parent.width：ScrollView 的视口宽度由内容宽度驱动，
                    // 反向引用 parent.width 会形成 (width → viewport-width → width) 绑定环。
                    width: Math.min(root.width - Theme.space-8, Theme.settings-max-width);
                    spacing: Theme.space-3;
                    padding-bottom: Theme.space-4;

                    // ---- 外观 ----
                    SettingsSection {
                        title: @tr("外观");
                        description: @tr("“跟随系统”会读取操作系统的浅色/深色偏好，系统切换时自动同步");

                        SettingsRow {
                            label: @tr("主题");

                            FluentSegmented {
                                width: 248px;
                                items: [@tr("跟随系统"), @tr("浅色"), @tr("深色")];
                                current: root.theme-index;
                                changed(idx) => {
                                    root.theme-index = idx;
                                    root.theme-changed(idx);
                                }
                            }
                        }

                        SettingsDivider {
                        }

                        // 语言：语言自称（简体中文 / 繁體中文 / English / 日本語）
                        // 一律不包 @tr —— 一种语言永远以自己的文字显示自己，否则在
                        // 英文界面上"简体中文"会被翻成 "Simplified Chinese"，用户反而
                        // 认不出自己母语那一项。只有「自动」是真正的界面文案，走 @tr。
                        SettingsRow {
                            label: @tr("语言");
                            description: @tr("“自动”按系统语言选择；切换后立即生效，无需重启");

                            // 420px 而不是 480px：设置列上限 880px，减去分组卡片左右
                            // 各 space-4 的 padding 只剩 848px，480px 的控件会把左侧
                            // 说明压到 352px（远低于 SettingsRow 给的 560px 上限），
                            // 这句 24 字的说明就要折行；420px 留出 412px，一行放得下，
                            // 而五段的文字总宽约 230px，420px 仍有余量不会被 elide。
                            FluentSegmented {
                                width: 420px;
                                items: [@tr("自动"), "简体中文", "繁體中文", "English", "日本語"];
                                current: root.language-index;
                                changed(idx) => {
                                    root.language-index = idx;
                                    root.language-changed(idx);
                                }
                            }
                        }

                        SettingsDivider {
                        }

                        SettingsRow {
                            label: @tr("减少动画");
                            description: @tr("关闭界面过渡与进度动画，适合远程桌面或低性能设备");

                            FluentSwitch {
                                checked: root.reduce-motion;
                                // 开关自己没有文字，可读名称由行标题提供
                                accessible-label: @tr("减少动画");
                                toggled => {
                                    root.reduce-motion-changed(!root.reduce-motion);
                                }
                            }
                        }
                    }

                    // ---- 传输 ----
                    SettingsSection {
                        title: @tr("传输");
                        description: @tr("下载目录与并发设置来源于本地配置文件");

                        PathRow {
                            label: @tr("默认下载目录");
                            value: root.download-dir;
                            hint: @tr("下载任务的默认保存位置");
                            action-text: @tr("更改目录");
                            copy => {
                                root.copy-text(root.download-dir);
                            }
                            action => {
                                root.choose-download-dir();
                            }
                        }

                        SettingsDivider {
                        }

                        SettingsRow {
                            label: @tr("并发分片数");
                            // 说明文案保持与改动前逐字一致：多出的"仅对新任务生效"写在
                            // 控制器注释里，避免窄窗口下说明折行把行高撑高
                            description: @tr("分片并发越高占用带宽越多，网络不稳定时建议下调");

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                cross-axis-alignment: center;

                                ThreadStepper {
                                    label: @tr("下载");
                                    value: root.download-thread;
                                    count: root.download-thread-count;
                                    step(delta) => {
                                        // 另一个方向的值原样带回，避免一次点击把两边都改掉
                                        root.thread-count-changed(root.download-thread-count + delta, root.upload-thread-count);
                                    }
                                }

                                ThreadStepper {
                                    label: @tr("上传");
                                    value: root.upload-thread;
                                    count: root.upload-thread-count;
                                    step(delta) => {
                                        root.thread-count-changed(root.download-thread-count, root.upload-thread-count + delta);
                                    }
                                }
                            }
                        }

                        SettingsDivider {
                        }

                        // 速度限制：分段控件的索引由控制器按 config.json 的 speed_limit 反算。
                        //
                        // 「不许显示与实际不符的选中项」的做法：配置里是非预设值（用户手改过
                        // config.json）时索引给 **-1**，`FluentSegmented` 只在
                        // `current == idx` 时点亮某一段，于是五段一个都不亮，行内再用一段
                        // 小字写出真正生效的数值（`speed-limit-text`）。绝不退到「最接近的
                        // 预设」——那会让人以为高亮那一段就是真实设定，而真正生效的是
                        // config.json 里的值。
                        //
                        // 只对**新启动**的任务生效：在跑的任务持有的是启动时那个限速桶，
                        // 换档不会让在途传输突然变快或变慢（理由见控制器注释）。
                        SettingsRow {
                            label: @tr("速度限制");
                            description: @tr("限制上传与下载的总速率；更细的数值可直接编辑 config.json 的 speed_limit（字节/秒）");

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                cross-axis-alignment: center;

                                // 只在非预设档出现：预设档下高亮的那一段自己就说明了当前设定
                                if root.speed-limit-text != "": Text {
                                    text: root.speed-limit-text;
                                    font-family: Theme.font-family;
                                    font-size: Theme.font-small;
                                    color: Theme.text-tertiary;
                                    vertical-alignment: center;
                                }

                                FluentSegmented {
                                    // 320px：五段文字总宽约 265px（含 2px 内边距与段间距），
                                    // 留出余量后仍能让左侧说明保持 500px 以上不折行
                                    width: 320px;
                                    // "1 MB/s" 这类「数字 + 单位」四语一致，不包 @tr
                                    // （与语言行里的「简体中文 / English」同一个取舍）
                                    items: [@tr("不限速"), "1 MB/s", "5 MB/s", "10 MB/s", "20 MB/s"];
                                    current: root.speed-limit-index;
                                    changed(idx) => {
                                        root.speed-limit-index = idx;
                                        root.speed-limit-changed(idx);
                                    }
                                }
                            }
                        }
                    }

                    // ---- 账号 ----
                    SettingsSection {
                        title: @tr("账号");

                        SettingsRow {
                            label: @tr("当前账号");

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                cross-axis-alignment: center;

                                Text {
                                    text: root.account-name == "" ? @tr("未登录") : root.account-name;
                                    font-family: Theme.font-family;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    max-width: 220px;
                                    overflow: elide;
                                }

                                FluentButton {
                                    text: @tr("退出登录");
                                    icon: IconName.logout;
                                    danger: true;
                                    subtle: true;
                                    enabled: root.account-name != "";
                                    clicked => {
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }

                    // ---- 关于 ----
                    SettingsSection {
                        title: @tr("关于");

                        SettingsRow {
                            label: @tr("版本");

                            Text {
                                text: root.version-text;
                                font-family: Theme.font-family;
                                font-size: Theme.font-small;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        SettingsDivider {
                        }

                        PathRow {
                            label: @tr("配置目录");
                            value: root.config-dir;
                            hint: @tr("账号、任务与配置文件的存放位置");
                            action-text: @tr("打开");
                            copy => {
                                root.copy-text(root.config-dir);
                            }
                            action => {
                                root.open-config-dir();
                            }
                        }

                        SettingsDivider {
                        }

                        // 用户报问题时需要拿到日志文件：这里给出真实路径，并提供
                        // “打开”与“复制”，省掉“日志到底在哪”的来回确认。
                        PathRow {
                            label: @tr("日志目录");
                            value: root.log-dir;
                            hint: @tr("运行日志按天滚动保存，只保留最近 7 天");
                            action-text: @tr("打开");
                            copy => {
                                root.copy-text(root.log-dir);
                            }
                            action => {
                                root.open-log-dir();
                            }
                        }
                    }
                }
            }
        }
    }
}