// 设置页：外观 / 传输 / 账号 / 关于
//
// 版式对齐 Windows 11 设置应用：
//   页面标题 → 单列分组卡片（最大宽度 settings-max-width 居中）→ 统一设置行
// 每个 SettingsRow 都是"左名称/说明 + 右控件"，行高、分隔线、间距只在
// components/settings-section.slint 里定义一次。
//
// 只放真正生效的开关：主题、减少动画、下载目录、退出登录。
// 每一项都直接调用控制器，不存在"点了没反应"的控件。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons } from "../theme/icons.slint";
import { TooltipState } from "../types.slint";
import { FluentButton } from "../components/button.slint";
import { FluentIconButton } from "../components/icon-button.slint";
import { FluentSegmented } from "../components/segmented.slint";
import { FluentSwitch } from "../components/switch.slint";
import { SettingsSection, SettingsRow, SettingsDivider } from "../components/settings-section.slint";

// 只读路径行：等宽字体 + 省略 + 悬停显示完整路径 + 复制按钮 + 可选的同行操作按钮
//
// 路径与操作放在同一行：长路径走省略号，右侧按钮永不被挤出窗口。
component PathRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";
    /// 同行操作按钮文案（空则不显示）
    in property <string> action-text: "";

    callback copy();
    callback action();

    alignment: space-between;
    spacing: Theme.space-3;
    cross-axis-alignment: center;

    VerticalLayout {
        max-width: 560px;
        spacing: Theme.space-1;
        alignment: center;

        Text {
            text: root.label;
            font-family: Theme.font-family;
            font-size: Theme.font-body-large;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        // 省略显示 + 悬停完整性查看，避免长路径把右侧按钮挤出窗口。
        // 用 max-width 而不是 Math.min(parent.width, ...)：后者会与父布局的首选宽度
        // 形成绑定环（width → layoutinfo-h → width）。
        path-box := Rectangle {
            height: 24px;
            max-width: 520px;
            background: transparent;

            Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.value;
                font-family: Theme.mono-font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                overflow: elide;
            }

            hover := TouchArea {
                changed has-hover => {
                    if (self.has-hover && root.value != "") {
                        TooltipState.text = root.value + (root.hint == "" ? "" : (" · " + root.hint));
                        TooltipState.x = self.absolute-position.x;
                        TooltipState.y = self.absolute-position.y + self.height + 4px;
                        TooltipState.visible = true;
                    } else {
                        TooltipState.visible = false;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-1;
        cross-axis-alignment: center;

        if root.action-text != "": FluentButton {
            text: root.action-text;
            clicked => {
                root.action();
            }
        }

        FluentIconButton {
            glyph: Icons.copy;
            tooltip: "复制路径";
            enabled: root.value != "";
            clicked => {
                root.copy();
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <string> account-name: "";
    /// 0 = 跟随系统，1 = 浅色，2 = 深色
    in-out property <int> theme-index: 0;
    in property <bool> reduce-motion: false;
    in property <string> download-dir: "";
    in property <string> upload-thread: "";
    in property <string> download-thread: "";
    in property <string> version-text: "";
    in property <string> config-dir: "";

    callback theme-changed(int);
    callback reduce-motion-changed(bool);
    callback choose-download-dir();
    callback open-config-dir();
    callback copy-text(string);
    callback logout();

    background: Theme.window-bg;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // ---------------- 页面标题 ----------------
        HorizontalLayout {
            height: Theme.header-height;
            cross-axis-alignment: center;

            Text {
                text: "设置";
                font-family: Theme.font-family;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // ---------------- 内容（单列居中，最大宽度 880px） ----------------
        ScrollView {
            vertical-stretch: 1;

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    // 用页面根宽度而不是 parent.width：ScrollView 的视口宽度由内容宽度驱动，
                    // 反向引用 parent.width 会形成 (width → viewport-width → width) 绑定环。
                    width: Math.min(root.width - Theme.space-8, Theme.settings-max-width);
                    spacing: Theme.space-3;
                    padding-bottom: Theme.space-4;

                    // ---- 外观 ----
                    SettingsSection {
                        title: "外观";
                        description: "“跟随系统”会读取操作系统的浅色/深色偏好，系统切换时自动同步";

                        SettingsRow {
                            label: "主题";

                            FluentSegmented {
                                width: 248px;
                                items: ["跟随系统", "浅色", "深色"];
                                current: root.theme-index;
                                changed(idx) => {
                                    root.theme-index = idx;
                                    root.theme-changed(idx);
                                }
                            }
                        }

                        SettingsDivider {
                        }

                        SettingsRow {
                            label: "减少动画";
                            description: "关闭界面过渡与进度动画，适合远程桌面或低性能设备";

                            FluentSwitch {
                                checked: root.reduce-motion;
                                toggled => {
                                    root.reduce-motion-changed(!root.reduce-motion);
                                }
                            }
                        }
                    }

                    // ---- 传输 ----
                    SettingsSection {
                        title: "传输";
                        description: "下载目录与并发设置来源于本地配置文件";

                        PathRow {
                            label: "默认下载目录";
                            value: root.download-dir;
                            hint: "下载任务的默认保存位置";
                            action-text: "更改目录";
                            copy => {
                                root.copy-text(root.download-dir);
                            }
                            action => {
                                root.choose-download-dir();
                            }
                        }

                        SettingsDivider {
                        }

                        SettingsRow {
                            label: "并发分片数";
                            description: "分片并发越高占用带宽越多，网络不稳定时建议下调";

                            Text {
                                text: "下载 " + root.download-thread + " 线程 · 上传 " + root.upload-thread + " 线程";
                                font-family: Theme.font-family;
                                font-size: Theme.font-small;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // ---- 账号 ----
                    SettingsSection {
                        title: "账号";

                        SettingsRow {
                            label: "当前账号";

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                cross-axis-alignment: center;

                                Text {
                                    text: root.account-name == "" ? "未登录" : root.account-name;
                                    font-family: Theme.font-family;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    max-width: 220px;
                                    overflow: elide;
                                }

                                FluentButton {
                                    text: "退出登录";
                                    glyph: Icons.logout;
                                    danger: true;
                                    subtle: true;
                                    enabled: root.account-name != "";
                                    clicked => {
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }

                    // ---- 关于 ----
                    SettingsSection {
                        title: "关于";

                        SettingsRow {
                            label: "版本";

                            Text {
                                text: root.version-text;
                                font-family: Theme.font-family;
                                font-size: Theme.font-small;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        SettingsDivider {
                        }

                        PathRow {
                            label: "配置目录";
                            value: root.config-dir;
                            hint: "账号、任务与配置文件的存放位置";
                            action-text: "打开";
                            copy => {
                                root.copy-text(root.config-dir);
                            }
                            action => {
                                root.open-config-dir();
                            }
                        }
                    }
                }
            }
        }
    }
}
