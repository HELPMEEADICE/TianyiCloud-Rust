// 云盘工作区（个人云 / 家庭云共用）
//
// 结构（自上而下）：
//   命令栏（返回 + 面包屑 + 搜索 + 刷新 + 新建 + 上传）
//   → 操作栏（固定高度：无选中时显示统计/全选，有选中时切换为批量操作，避免布局跳动）
//   → 提示条（错误 / 搜索态）
//   → 文件明细列表（ListView 虚拟化）
//   → 状态栏
//
// 列表状态由 Rust 侧的单一 list-state 派生，不再用多个布尔变量互相组合：
//   loading=首次加载、refreshing=已有数据的静默刷新、ready、empty、empty-search、error

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { FluentButton } from "../components/button.slint";
import { FluentIconButton } from "../components/icon-button.slint";
import { FluentProgressBar } from "../components/progress-bar.slint";
import { FluentSearchBox } from "../components/search-box.slint";
import { FileRow, FileColumns } from "../components/file-row.slint";
import { FluentEmptyState, FluentLoadingState, FluentErrorState } from "../components/state-view.slint";
import { DropOverlay } from "../components/drop-overlay.slint";
import { ListView } from "std-widgets.slint";
import { FileEntry, CrumbEntry, ModifiersApi, TooltipState } from "../types.slint";

export component CloudPage inherits Rectangle {
    in property <string> space-label: "个人云";
    in property <[CrumbEntry]> crumbs: [];
    in property <[FileEntry]> rows: [];
    in property <string> renaming-id: "";
    in property <bool> searching: false;
    /// 列表状态：loading / refreshing / ready / empty / empty-search / error / idle
    in property <string> list-state: "idle";
    /// 次要列级别：0=仅名称 1=+大小 2=+时间 3=+类型
    in property <int> detail-level: 3;
    in property <string> status-text: "";
    in property <string> capacity-text: "";
    in property <int> active-transfers: 0;
    in property <int> selected-count: 0;
    in property <bool> drop-active: false;
    in property <string> drop-target-name: "";
    /// 右键菜单是否打开（由外壳传入）：菜单关闭时把键盘焦点还给文件列表
    in property <bool> context-menu-open: false;
    in property <string> error-text: "";
    /// 排序：0=名称 1=大小 2=修改时间
    in property <int> sort-key: 0;
    in property <bool> sort-asc: true;
    /// 当前选中行在 `rows` 里的下标（-1 = 没有选中）。**唯一写入点**是控制器
    /// `controller/files.rs::set_selection`：选择集的事实来源在 Rust 侧，UI 只负责
    /// 把这一行滚进视口，不自己维护"看起来选中了哪一行"。
    in property <int> selection-index: -1;

    callback select-item(string, bool, bool);
    /// 方向键 / Home / End / PageUp / PageDown 移动当前行；extend = Shift 按下（扩选）
    callback move-selection(int, bool);
    callback select-all();
    callback clear-selection();
    callback open-item(string, string, bool);
    /// 打开当前唯一选中项（Enter 键）：选择集的事实来源在 Rust 侧，UI 不自行挑行
    callback open-selected();
    callback context-requested(string, string, bool, length, length);
    callback navigate-crumb(int);
    callback navigate-up();
    callback refresh();
    /// 取消在途加载（只丢弃结果，不新增取消网络请求的机制）
    callback cancel-loading();
    callback upload();
    callback create-folder();
    callback search-changed(string);
    callback search-submitted(string);
    callback search-cleared();
    callback download-selected();
    callback rename-selected();
    callback copy-selected();
    callback move-selected-up();
    callback delete-selected();
    callback link-selected();
    callback rename-submitted(string, string);
    callback rename-cancelled(string);
    callback toggle-transfers();
    callback sort-changed(int);
    pure callback make-drag-data(string, string, bool) -> data-transfer;
    callback drop-can-accept(DropEvent, string) -> DragAction;
    callback drop-requested(DropEvent, string) -> DragAction;

    in-out property <string> search-text: "";

    property <bool> has-selection: root.selected-count > 0;
    property <bool> narrow: root.width < 760px;
    property <bool> show-loading: root.list-state == "loading" && root.rows.length == 0;
    property <bool> show-error: root.list-state == "error" && root.rows.length == 0;
    property <bool> show-empty: root.rows.length == 0 && !root.show-loading && !root.show-error;
    property <bool> refreshing: root.list-state == "refreshing";
    /// 有行数据时的错误提示（占一行 InfoBar，不接管整页）
    property <bool> inline-error: root.list-state == "error" && root.rows.length > 0;
    /// 一屏能完整放下的行数：PageUp/PageDown 的步长。
    ///
    /// 量的是列表视口自己的高度（= ListView 的高度），不是页面高度——表头、提示条、
    /// 状态栏都不属于可滚动区域。减一留一行重叠：翻页后仍能看到上一页的最后一行，
    /// 和 WinUI 文件列表的翻页手感一致。`Math.max(1, …)` 保证极矮窗口下也是"至少一行"。
    property <int> page-rows: Math.max(1, Math.round(list-body.height / Theme.row-height) - 1);

    /// 列表视口的滚动偏移（`ListView.viewport-y` 的桥）。
    ///
    /// 为什么要绕一层：ListView 只在本页有行时才存在（`if rows.length > 0`），而
    /// `if` 内部的元素 id 在组件外层不可见（编译器直接报 `Cannot access id`）。
    /// 视口跟随又必须挂在 CloudPage 的 `selection-index` 上，所以用一条双向绑定
    /// 把 `viewport-y` 引到本页属性：ListView 不存在时它保留旧值，此时
    /// `selection-index` 必为 -1，不会被读到。
    private property <length> list-viewport-y: 0px;

    background: Theme.window-bg;

    // 右键菜单打开期间焦点被菜单拿走（菜单需要焦点才能收 Esc）。
    // 菜单一关就把焦点还给文件列表，否则 F5 / Delete / Enter 这些快捷键
    // 会在关掉菜单之后集体失效，直到用户又点中某一行。
    changed context-menu-open => {
        if (!root.context-menu-open) {
            list-area.focus();
        }
    }

    // ---------------- 视口跟随 ----------------
    //
    // 键盘选行时必须让那一行看得见，否则"选中了但屏幕上没变化"和没选中一样。
    //
    // 换算依据：ListView 继承 ScrollView，`viewport-y` 是它的 **in-out** 属性
    // （i-slint-compiler-1.17.1 widgets/fluent/scrollview.slint:157
    // `in-out property <length> viewport-y <=> flickable.viewport-y;`），内容向上滚
    // （看后面的行）时为负值，内容偏移 = -viewport-y。std-widgets 内部用
    // `-viewport_y / item-height` 反算首个可见行，本处沿用同一个约定：只读写这一个
    // 属性，不另包滚动容器（自建容器会绕过 ListView 的行回收，虚拟化就废了）。
    // 越界值由 ScrollView 自己钳制，这里不需要也不应该再算一次最大偏移。
    private property <length> sel-top: root.selection-index * Theme.row-height;

    changed selection-index => {
        if (root.selection-index >= 0) {
            if (root.sel-top < -root.list-viewport-y) {
                // 目标行在视口上方：直接把它顶到视口第一行
                root.list-viewport-y = -root.sel-top;
            } else if (root.sel-top + Theme.row-height > -root.list-viewport-y + list-body.height) {
                // 目标行在视口下方：只补足不够的那一段，滚动手感与"逐行跟随"一致
                root.list-viewport-y = -(root.sel-top + Theme.row-height - list-body.height);
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // ---------------- 主命令栏 ----------------
        HorizontalLayout {
            height: Theme.header-height;
            spacing: Theme.space-2;
            // 明确用 Stretch：由面包屑吸收剩余宽度，其余控件保持自身首选宽度
            alignment: stretch;
            cross-axis-alignment: center;

            FluentIconButton {
                icon: IconName.back;
                tooltip: "返回上级目录 (Alt+←)";
                enabled: root.crumbs.length > 1 && !root.searching;
                clicked => {
                    root.navigate-up();
                }
            }

            // 面包屑：占据剩余宽度并在超长时裁剪，保证右侧搜索框永不被挤出窗口
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-height;
                clip: true;
                background: transparent;

                HorizontalLayout {
                    spacing: 2px;
                    cross-axis-alignment: center;

                    for crumb[idx] in root.crumbs : HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;

                        crumb-btn := Rectangle {
                            height: 26px;
                            max-width: 200px;
                            border-radius: Theme.radius-control;
                            background: crumb-ta.has-hover ? Theme.control-bg-hover : transparent;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: crumb.name;
                                    font-family: Theme.font-family;
                                    font-size: Theme.font-body;
                                    color: idx == root.crumbs.length - 1 ? Theme.text-primary : Theme.text-secondary;
                                    font-weight: idx == root.crumbs.length - 1 ? Theme.weight-semibold : Theme.weight-regular;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            crumb-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.navigate-crumb(idx);
                                }
                            }
                        }

                        if idx < root.crumbs.length - 1: Icon {
                            name: IconName.chevron-right;
                            size: Theme.icon-xs;
                            icon-color: Theme.text-tertiary;
                        }
                    }

                    if root.crumbs.length == 0: Text {
                        text: "根目录";
                        font-family: Theme.font-family;
                        font-size: Theme.font-body;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            search := FluentSearchBox {
                width: root.narrow ? 172px : 232px;
                text <=> root.search-text;
                placeholder: "搜索云盘文件";
                search(t) => {
                    root.search-changed(t);
                }
                submitted(t) => {
                    root.search-submitted(t);
                }
                cleared => {
                    root.search-cleared();
                }
            }

            FluentIconButton {
                icon: IconName.refresh;
                tooltip: "刷新 (F5)";
                enabled: root.list-state != "loading" && !root.refreshing;
                clicked => {
                    root.refresh();
                }
            }

            // 窄窗口：次要操作折叠为图标按钮，核心操作（上传）始终可见
            if root.narrow: FluentIconButton {
                icon: IconName.folder;
                tooltip: "新建文件夹";
                enabled: root.list-state != "loading";
                clicked => {
                    root.create-folder();
                }
            }

            if !root.narrow: FluentButton {
                text: "新建文件夹";
                icon: IconName.add;
                enabled: root.list-state != "loading";
                clicked => {
                    root.create-folder();
                }
            }

            FluentButton {
                text: "上传";
                icon: IconName.upload;
                accent: true;
                enabled: root.list-state != "loading";
                clicked => {
                    root.upload();
                }
            }
        }

        // ---------------- 操作栏（高度固定，内容随选中态切换） ----------------
        // 高度固定 + space-between 两端对齐：切换选中态时不会引起整页布局跳动，
        // 也不会出现"按钮被拉伸到整行"的异常宽度。
        Rectangle {
            height: 36px;
            border-radius: Theme.radius-control;
            background: root.has-selection ? Theme.accent-soft : transparent;

            HorizontalLayout {
                padding-left: root.has-selection ? Theme.space-3 : 0px;
                padding-right: Theme.space-1;
                spacing: Theme.space-2;
                alignment: space-between;
                cross-axis-alignment: center;

                // ---- 左组：选择状态与批量操作 ----
                // 窄窗口（内容区 < 760px）下这些按钮只留图标：文字被清空后，
                // 悬停说明与可读名称都只能由 tooltip 提供，因此每个按钮都固定传一份，
                // 与 text 的窄窗口取值无关（tooltip 恒定，不是 root.narrow 的三元式）。
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-2;
                    cross-axis-alignment: center;

                    if root.has-selection: Text {
                        text: "已选择 " + root.selected-count + " 项";
                        font-family: Theme.font-family;
                        font-size: Theme.font-small;
                        font-weight: Theme.weight-semibold;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }

                    if !root.has-selection: Text {
                        text: root.rows.length > 0 ? ("共 " + root.rows.length + " 个项目") : "";
                        font-family: Theme.font-family;
                        font-size: Theme.font-small;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if root.has-selection: FluentButton {
                        text: "下载";
                        tooltip: "下载";
                        icon: IconName.download;
                        subtle: true;
                        clicked => {
                            root.download-selected();
                        }
                    }

                    if root.has-selection && root.selected-count == 1: FluentButton {
                        text: "重命名";
                        tooltip: "重命名";
                        icon: IconName.rename;
                        subtle: true;
                        clicked => {
                            root.rename-selected();
                        }
                    }

                    if root.has-selection: FluentButton {
                        text: root.narrow ? "" : "复制";
                        tooltip: "复制";
                        icon: IconName.copy;
                        subtle: true;
                        clicked => {
                            root.copy-selected();
                        }
                    }

                    if root.has-selection: FluentButton {
                        text: root.narrow ? "" : "移动到上级";
                        tooltip: "移动到上级";
                        icon: IconName.folder;
                        subtle: true;
                        enabled: root.crumbs.length > 1;
                        clicked => {
                            root.move-selected-up();
                        }
                    }

                    if root.has-selection: FluentButton {
                        text: root.narrow ? "" : "提取直链";
                        tooltip: "提取直链";
                        icon: IconName.link;
                        subtle: true;
                        clicked => {
                            root.link-selected();
                        }
                    }

                    if root.has-selection: FluentButton {
                        text: root.narrow ? "" : "删除";
                        tooltip: "删除";
                        icon: IconName.delete;
                        danger: true;
                        subtle: true;
                        clicked => {
                            root.delete-selected();
                        }
                    }

                    if root.has-selection: FluentButton {
                        text: root.narrow ? "" : "取消选择";
                        tooltip: "取消选择";
                        subtle: true;
                        clicked => {
                            root.clear-selection();
                        }
                    }
                }

                // ---- 右组：提示与全选 ----
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-2;
                    cross-axis-alignment: center;

                    if !root.has-selection: Text {
                        text: root.narrow ? "" : "Ctrl+单击多选 · Shift+单击范围选择";
                        font-family: Theme.font-family;
                        font-size: Theme.font-caption;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if !root.has-selection: FluentButton {
                        text: "全选";
                        subtle: true;
                        enabled: root.rows.length > 0;
                        clicked => {
                            root.select-all();
                        }
                    }
                }
            }
        }

        // ---------------- 搜索提示条 ----------------
        if root.searching: Rectangle {
            height: 32px;
            border-radius: Theme.radius-card;
            background: Theme.accent-soft;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-1;
                spacing: Theme.space-2;
                cross-axis-alignment: center;

                Icon {
                    name: IconName.search;
                    size: Theme.icon-sm;
                    icon-color: Theme.accent;
                }

                Text {
                    text: root.status-text;
                    font-family: Theme.font-family;
                    font-size: Theme.font-small;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                FluentButton {
                    text: "退出搜索";
                    subtle: true;
                    clicked => {
                        root.search-cleared();
                    }
                }
            }
        }

        // ---------------- 行内错误提示（有数据时不清空列表） ----------------
        if root.inline-error: Rectangle {
            height: 40px;
            border-radius: Theme.radius-card;
            background: Theme.danger-soft;
            border-width: 1px;
            border-color: Theme.danger;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                spacing: Theme.space-2;
                cross-axis-alignment: center;

                Icon {
                    name: IconName.warning;
                    size: Theme.icon-sm;
                    icon-color: Theme.danger;
                }

                Text {
                    text: root.error-text;
                    font-family: Theme.font-family;
                    font-size: Theme.font-small;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                FluentButton {
                    text: "重试";
                    subtle: true;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }

        // ---------------- 文件列表 ----------------
        list-area := FocusScope {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            init => {
                self.focus();
            }

            // 快捷键总表
            //
            // 一律用 `enabled:` 而不是在 activated 里 if：KeyBinding 在**捕获阶段**判定，
            // 匹配上就吃掉这次按键，焦点所在的行内输入框（重命名框）再也收不到。
            // 把开关放到 enabled 上，不适用时按键会正常往下传——
            // 重命名时 Enter 才能提交、Delete 才能删字、Esc 才能取消。
            KeyBinding {
                keys: @keys(Return);
                enabled: root.renaming-id == "" && root.selected-count == 1;
                activated => {
                    root.open-selected();
                }
            }

            KeyBinding {
                keys: @keys(F2);
                enabled: root.renaming-id == "" && root.selected-count == 1;
                activated => {
                    root.rename-selected();
                }
            }
            KeyBinding {
                keys: @keys(Delete);
                enabled: root.renaming-id == "" && root.has-selection;
                activated => {
                    root.delete-selected();
                }
            }
            KeyBinding {
                keys: @keys(F5);
                activated => {
                    root.refresh();
                }
            }
            KeyBinding {
                keys: @keys(Alt+LeftArrow);
                activated => {
                    root.navigate-up();
                }
            }
            KeyBinding {
                keys: @keys(Control+A);
                enabled: root.renaming-id == "";
                activated => {
                    root.select-all();
                }
            }
            KeyBinding {
                keys: @keys(Escape);
                enabled: root.renaming-id == "" && root.has-selection;
                activated => {
                    root.clear-selection();
                }
            }
            KeyBinding {
                keys: @keys(Control+F);
                activated => {
                    search.focus-input();
                }
            }

            // —— 键盘选行 ——
            // 这张表原本只有"对已选中项做动作"的键（Enter / F2 / Delete…），没有任何
            // "移动选择"的键：纯键盘用户根本没法定出第一行，只能用鼠标点。
            // 六个键把当前行沿 rows 前后移动，Shift = 扩选（与单击时 Ctrl/Shift 的
            // 语义对齐，由 Rust 侧 range_selection 完成区间计算）。
            //
            // 条件一律放在 enabled 上（同上面的总表）：重命名输入中按键必须下传给
            // TextInput（否则方向键会被这里吃掉、光标动不了）；没有行时也不该有动作。
            KeyBinding {
                keys: @keys(DownArrow);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(1, ModifiersApi.shift);
                }
            }
            KeyBinding {
                keys: @keys(UpArrow);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(-1, ModifiersApi.shift);
                }
            }
            // Home / End 用 ±rows.length 表达"跳到两端"：钳制在 Rust 侧统一做，
            // 这里不需要为"第一行/最后一行"单独开一条回调。
            KeyBinding {
                keys: @keys(Home);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(-root.rows.length, ModifiersApi.shift);
                }
            }
            KeyBinding {
                keys: @keys(End);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(root.rows.length, ModifiersApi.shift);
                }
            }
            KeyBinding {
                keys: @keys(PageDown);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(root.page-rows, ModifiersApi.shift);
                }
            }
            KeyBinding {
                keys: @keys(PageUp);
                enabled: root.renaming-id == "" && root.rows.length > 0;
                activated => {
                    root.move-selection(-root.page-rows, ModifiersApi.shift);
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: Theme.radius-card;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;

                VerticalLayout {
                    spacing: 0px;

                    // 刷新指示：只占 2px，不清空列表（非侵入式加载反馈）
                    // 用不确定态进度条而不是"宽度线性增长后归零"的矩形：后者是锯齿式拉扯，
                    // 读不出"正在加载"，而 FluentProgressBar 自带滑块循环且尊重 reduce-motion
                    if root.refreshing: FluentProgressBar {
                        indeterminate: true;
                        bar-height: 2px;
                        // 这条只是"正在刷新"的细指示，不需要轨道底色：轨道会在这里
                        // 画出一条与卡片等宽的浅灰线，看起来像一条多余的分隔线。
                        track-color: transparent;
                    }

                    // 表头
                    Rectangle {
                        height: FileColumns.header-height;
                        background: Theme.layer-bg;

                        HorizontalLayout {
                            padding-left: FileColumns.pad-left;
                            padding-right: FileColumns.pad-right;
                            spacing: FileColumns.gap;
                            // 名称列吸收剩余宽度，其余列保持固定宽度并逐个对齐
                            alignment: stretch;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: FileColumns.icon;
                                horizontal-stretch: 0;
                                background: transparent;
                            }

                            // 名称（可排序）
                            name-header := Rectangle {
                                horizontal-stretch: 1;
                                height: parent.height;
                                background: name-ta.has-hover ? Theme.hover-bg : transparent;
                                border-radius: Theme.radius-control;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    // 指示器放在标签前面：不受横向布局剩余空间分配的影响
                                    if root.sort-key == 0: Icon {
                                        name: root.sort-asc ? IconName.sort-asc : IconName.sort-desc;
                                        size: Theme.icon-sm;
                                        icon-color: Theme.accent;
                                    }

                                    Text {
                                        text: "名称";
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-caption;
                                        font-weight: root.sort-key == 0 ? Theme.weight-semibold : Theme.weight-regular;
                                        color: root.sort-key == 0 ? Theme.text-secondary : Theme.text-tertiary;
                                        vertical-alignment: center;
                                    }
                                }

                                name-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.sort-changed(0);
                                    }
                                }
                            }

                            // 大小（可排序）
                            if root.detail-level >= 1: size-header := Rectangle {
                                width: FileColumns.size;
                                horizontal-stretch: 0;
                                height: parent.height;
                                background: size-ta.has-hover ? Theme.hover-bg : transparent;
                                border-radius: Theme.radius-control;

                                HorizontalLayout {
                                    alignment: end;
                                    cross-axis-alignment: center;
                                    spacing: 4px;

                                    if root.sort-key == 1: Icon {
                                        name: root.sort-asc ? IconName.sort-asc : IconName.sort-desc;
                                        size: Theme.icon-sm;
                                        icon-color: Theme.accent;
                                    }

                                    Text {
                                        text: "大小";
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-caption;
                                        font-weight: root.sort-key == 1 ? Theme.weight-semibold : Theme.weight-regular;
                                        color: root.sort-key == 1 ? Theme.text-secondary : Theme.text-tertiary;
                                        vertical-alignment: center;
                                    }
                                }

                                size-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.sort-changed(1);
                                    }
                                }
                            }

                            // 修改时间（可排序）
                            if root.detail-level >= 2: time-header := Rectangle {
                                width: FileColumns.time;
                                horizontal-stretch: 0;
                                height: parent.height;
                                background: time-ta.has-hover ? Theme.hover-bg : transparent;
                                border-radius: Theme.radius-control;

                                HorizontalLayout {
                                    spacing: 4px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "修改时间";
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-caption;
                                        font-weight: root.sort-key == 2 ? Theme.weight-semibold : Theme.weight-regular;
                                        color: root.sort-key == 2 ? Theme.text-secondary : Theme.text-tertiary;
                                        vertical-alignment: center;
                                    }

                                    if root.sort-key == 2: Icon {
                                        name: root.sort-asc ? IconName.sort-asc : IconName.sort-desc;
                                        size: Theme.icon-sm;
                                        icon-color: Theme.accent;
                                    }
                                }

                                time-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.sort-changed(2);
                                    }
                                }
                            }

                            if root.detail-level >= 3: kind-header := Text {
                                width: FileColumns.kind;
                                text: "类型";
                                font-family: Theme.font-family;
                                font-size: Theme.font-caption;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // 列表主体
                    list-body := Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        if root.rows.length > 0: ListView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;

                            // 视口偏移引到本页属性，供 selection-index 的跟随逻辑使用
                            // （`if` 内部的 id 在外层不可见，见 list-viewport-y 的说明）
                            viewport-y <=> root.list-viewport-y;

                            // 滚动即收起 Tooltip：行被 ListView 回收时行内按钮不会收到
                            // has-hover=false，气泡会挂在旧位置指着已回收的行。
                            // 滚轮 / 拖动滚动条 / 触摸板滑动都会改 viewport-y，因此不必
                            // 另加一层覆盖全窗的 TouchArea 去截 MouseWheel（那会吞点击）。
                            changed viewport-y => {
                                TooltipState.visible = false;
                            }

                            for row in root.rows : FileRow {
                                entry: row;
                                renaming: row.id == root.renaming-id;
                                detail-level: root.detail-level;
                                is-drop-target: row.is_dir && !root.searching;
                                drag-data: root.make-drag-data(row.id, row.name, row.is_dir);

                                item-clicked(ctrl, shift) => {
                                    list-area.focus();
                                    root.select-item(row.id, ctrl, shift);
                                }
                                item-double-clicked => {
                                    root.open-item(row.id, row.name, row.is_dir);
                                }
                                context-requested(id, name, is-dir, x, y) => {
                                    list-area.focus();
                                    root.context-requested(id, name, is-dir, x, y);
                                }
                                rename-submitted(name) => {
                                    root.rename-submitted(row.id, name);
                                }
                                rename-cancelled => {
                                    root.rename-cancelled(row.id);
                                }
                                drop-can-accept(event, folder-id) => {
                                    root.drop-can-accept(event, folder-id);
                                }
                                drop-requested(event, folder-id) => {
                                    root.drop-requested(event, folder-id);
                                }
                            }
                        }

                        // ---- 状态：首次加载 / 加载失败 / 空 ----
                        if root.show-loading: FluentLoadingState {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            title: root.searching ? "正在搜索…" : "正在加载目录…";
                            description: root.searching ? "正在云端检索匹配的文件" : "正在从云端读取目录内容";
                            // 加载态原来没有出口：目录读不出来时用户只能干等（或关窗口）。
                            // 取消只递增代数让在途结果被丢弃，列表状态就地归一。
                            cancel-text: "取消";
                            cancel => {
                                root.cancel-loading();
                            }
                        }

                        if root.show-error: FluentErrorState {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            title: "加载失败";
                            description: root.error-text;
                            retry-text: "重试";
                            retry => {
                                root.refresh();
                            }
                        }

                        if root.show-empty && !root.searching: FluentEmptyState {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            icon: IconName.folder;
                            title: "这里还没有文件";
                            description: "把文件拖到这里即可上传，或使用右上角的“上传”“新建文件夹”";
                            action-text: "上传文件";
                            secondary-text: "新建文件夹";
                            action => {
                                root.upload();
                            }
                            secondary => {
                                root.create-folder();
                            }
                        }

                        if root.show-empty && root.searching: FluentEmptyState {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            icon: IconName.search;
                            title: "没有找到匹配的文件";
                            description: "换个关键词试试，或退出搜索回到当前目录";
                            action-text: "退出搜索";
                            action => {
                                root.search-cleared();
                            }
                        }
                    }
                }
            }

            // 拖入上传遮罩
            DropOverlay {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                active: root.drop-active;
                target-name: root.drop-target-name;
            }
        }

        // ---------------- 状态栏 ----------------
        HorizontalLayout {
            height: Theme.statusbar-height;
            spacing: Theme.space-3;
            cross-axis-alignment: center;

            Text {
                text: root.status-text;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            task-chip := Rectangle {
                height: 24px;
                horizontal-stretch: 0;
                border-radius: 12px;
                background: chip-ta.has-hover ? Theme.control-bg-hover : Theme.control-bg;
                border-width: 1px;
                border-color: chip-ta.has-hover ? Theme.stroke-strong : Theme.stroke;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Icon {
                        name: IconName.transfer;
                        size: Theme.icon-sm;
                        icon-color: root.active-transfers > 0 ? Theme.accent : Theme.text-tertiary;
                    }

                    Text {
                        text: root.active-transfers > 0 ? ("传输中 " + root.active-transfers) : "传输任务";
                        font-family: Theme.font-family;
                        font-size: Theme.font-caption;
                        color: root.active-transfers > 0 ? Theme.accent : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                chip-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-transfers();
                    }
                }
            }

            if root.capacity-text != "" && !root.narrow: Text {
                text: root.capacity-text;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }
}