    out property <string> chevron-up: "M4.5 15.5 L12 8 L19.5 15.5";
    // 首页
    out property <string> home: "M3 11 L12 3 L21 11 M5.5 9.5 L5.5 20 L18.5 20 L18.5 9.5 M10 20 L10 14.5 L14 14.5 L14 20";
    // 家庭 / 多人
