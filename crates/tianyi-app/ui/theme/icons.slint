/// 统一图标组件。
///
/// 调用方只描述语义与尺寸，不接触任何 SVG 细节：
///
/// ```slint
/// Icon { name: IconName.settings; size: Theme.icon-md; }
/// Icon { name: IconName.home; filled: root.selected; }
/// ```
///
/// 尺寸体系（与 WinUI 3 一致，见 tokens.slint）：
///  * Theme.icon-sm 16px —— 工具栏 / 行内操作 / 输入框内
///  * Theme.icon-md 20px —— 导航栏 / 列表项 / 主要按钮
///  * Theme.icon-lg 32px —— 空状态
///  * Theme.icon-xl 48px —— 大号空状态 / 引导页
///
/// 无论传入哪种尺寸，SVG 都以目标尺寸重新栅格化（不是位图缩放），
/// 因此高 DPI 下依旧清晰；24×24 画布统一，图标之间视觉大小一致。
export component Icon inherits Image {
    /// 语义名
    in property <IconName> name: IconName.none;
    /// 选中/激活态用官方 Filled 变体
    in property <bool> filled: false;
    /// 禁用态：统一降级为 Theme.text-disabled，调用方不必自己算颜色
    in property <bool> disabled: false;
    /// 着色。默认次级文字色，强调场景由调用方传 Theme.accent 等令牌
    in property <brush> icon-color: Theme.text-secondary;
    /// 视觉尺寸（正方形）
    in property <length> size: Theme.icon-md;

    width: root.size;
    height: root.size;
    /// 官方 SVG 全部为正方形 24×24 画布，contain 保证任何尺寸下都不拉伸、
    /// 不裁切、不失真；组件布局留白与 SVG 自身留白严格分离。
    image-fit: contain;
    image-rendering: smooth;
    /// none 直接不绘制；调用方都用显式坐标把它放在固定尺寸的容器里，
    /// 因此隐藏后不会引起布局跳动（不要把它放进 LinearLayout 依赖占位）
    visible: root.name != IconName.none;
    // <generated:source>
    source: root.name == IconName.none ? IconAssets.placeholder
        : root.name == IconName.home ? (root.filled ? IconAssets.home-filled : IconAssets.home-regular)
        : root.name == IconName.people ? (root.filled ? IconAssets.people-filled : IconAssets.people-regular)
        : root.name == IconName.transfer ? (root.filled ? IconAssets.transfer-filled : IconAssets.transfer-regular)
        : root.name == IconName.link ? (root.filled ? IconAssets.link-filled : IconAssets.link-regular)
        : root.name == IconName.settings ? (root.filled ? IconAssets.settings-filled : IconAssets.settings-regular)
        : root.name == IconName.folder ? (root.filled ? IconAssets.folder-filled : IconAssets.folder-regular)
        : root.name == IconName.file ? (root.filled ? IconAssets.file-filled : IconAssets.file-regular)
        : root.name == IconName.image ? (root.filled ? IconAssets.image-filled : IconAssets.image-regular)
        : root.name == IconName.video ? (root.filled ? IconAssets.video-filled : IconAssets.video-regular)
        : root.name == IconName.audio ? (root.filled ? IconAssets.audio-filled : IconAssets.audio-regular)
        : root.name == IconName.archive ? (root.filled ? IconAssets.archive-filled : IconAssets.archive-regular)
        : root.name == IconName.pdf ? (root.filled ? IconAssets.pdf-filled : IconAssets.pdf-regular)
        : root.name == IconName.text ? (root.filled ? IconAssets.text-filled : IconAssets.text-regular)
        : root.name == IconName.search ? (root.filled ? IconAssets.search-filled : IconAssets.search-regular)
        : root.name == IconName.refresh ? (root.filled ? IconAssets.refresh-filled : IconAssets.refresh-regular)
        : root.name == IconName.upload ? (root.filled ? IconAssets.upload-filled : IconAssets.upload-regular)
        : root.name == IconName.download ? (root.filled ? IconAssets.download-filled : IconAssets.download-regular)
        : root.name == IconName.folder-add ? (root.filled ? IconAssets.folder-add-filled : IconAssets.folder-add-regular)
        : root.name == IconName.delete ? (root.filled ? IconAssets.delete-filled : IconAssets.delete-regular)
        : root.name == IconName.rename ? (root.filled ? IconAssets.rename-filled : IconAssets.rename-regular)
        : root.name == IconName.copy ? (root.filled ? IconAssets.copy-filled : IconAssets.copy-regular)
        : root.name == IconName.move ? (root.filled ? IconAssets.move-filled : IconAssets.move-regular)
        : root.name == IconName.folder-open ? (root.filled ? IconAssets.folder-open-filled : IconAssets.folder-open-regular)
        : root.name == IconName.select-all ? (root.filled ? IconAssets.select-all-filled : IconAssets.select-all-regular)
        : root.name == IconName.back ? (root.filled ? IconAssets.back-filled : IconAssets.back-regular)
        : root.name == IconName.chevron-right ? (root.filled ? IconAssets.chevron-right-filled : IconAssets.chevron-right-regular)
        : root.name == IconName.chevron-down ? (root.filled ? IconAssets.chevron-down-filled : IconAssets.chevron-down-regular)
        : root.name == IconName.chevron-up ? (root.filled ? IconAssets.chevron-up-filled : IconAssets.chevron-up-regular)
        : root.name == IconName.more ? (root.filled ? IconAssets.more-filled : IconAssets.more-regular)
        : root.name == IconName.close ? (root.filled ? IconAssets.close-filled : IconAssets.close-regular)
        : root.name == IconName.check ? (root.filled ? IconAssets.check-filled : IconAssets.check-regular)
        : root.name == IconName.add ? (root.filled ? IconAssets.add-filled : IconAssets.add-regular)
        : root.name == IconName.filter ? (root.filled ? IconAssets.filter-filled : IconAssets.filter-regular)
        : root.name == IconName.sort ? (root.filled ? IconAssets.sort-filled : IconAssets.sort-regular)
        : root.name == IconName.sort-asc ? (root.filled ? IconAssets.sort-asc-filled : IconAssets.sort-asc-regular)
        : root.name == IconName.sort-desc ? (root.filled ? IconAssets.sort-desc-filled : IconAssets.sort-desc-regular)
        : root.name == IconName.pause ? (root.filled ? IconAssets.pause-filled : IconAssets.pause-regular)
        : root.name == IconName.play ? (root.filled ? IconAssets.play-filled : IconAssets.play-regular)
        : root.name == IconName.cancel ? (root.filled ? IconAssets.cancel-filled : IconAssets.cancel-regular)
        : root.name == IconName.retry ? (root.filled ? IconAssets.retry-filled : IconAssets.retry-regular)
        : root.name == IconName.success ? (root.filled ? IconAssets.success-filled : IconAssets.success-regular)
        : root.name == IconName.error ? (root.filled ? IconAssets.error-filled : IconAssets.error-regular)
        : root.name == IconName.warning ? (root.filled ? IconAssets.warning-filled : IconAssets.warning-regular)
        : root.name == IconName.account ? (root.filled ? IconAssets.account-filled : IconAssets.account-regular)
