    out property <string> search: "M4 10.5 A6.5 6.5 0 1 0 17 10.5 A6.5 6.5 0 1 0 4 10.5 Z M15.5 15.5 L21 21";
    // 关闭
    out property <string> close: "M5.5 5.5 L18.5 18.5 M18.5 5.5 L5.5 18.5";
