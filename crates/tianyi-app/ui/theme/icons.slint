// 图标系统 —— Microsoft Fluent UI System Icons（微软官方开源图标库）
// =============================================================================
// 设计约束（本文件是整个应用唯一的图标入口，禁止绕过它自绘图标）：
//
//  * 所有图标都是微软官方仓库的**原始 SVG 静态资源**，逐文件从
//    github.com/microsoft/fluentui-system-icons 下载，保存于 ui/assets/icons/。
//    来源、提交号与逐图标映射见 ui/assets/icons/SOURCES.md，许可证见同目录 LICENSE。
//  * 禁止：手写 SVG PathData、Slint Path、多矩形/线段拼装、Unicode/Emoji 冒充图标、
//    自制图标字体、为了微调而改官方路径。语义不够就换官方图标，不改路径。
//  * @image-url 是**编译期**构造，路径必须是字面量，不能运行期拼文件名。
//    因此「图标名 → 资源」的映射只能是静态表：下面的 IconAssets 就是那张表，
//    它由 tools/fetch-fluent-icons.ps1 依据真实存在的文件生成并回填，
//    保证 enum 成员、image 属性、磁盘文件三者永远一致（缺一个都编译不过）。
//  * 着色用 Slint 原生 Image.colorize：它把图像当作 alpha 蒙版并按给定颜色绘制
//    （见 i-slint-compiler builtins.slint 中 Image.colorize 的说明），
//    所以官方 SVG 保持微软原始字节，深浅色/选中/禁用全部在 Slint 侧着色，
//    不需要为每种颜色复制一份图标，也不存在彩色图标被染坏的情况。
//  * 风格规范（Fluent Design 2）：默认 Regular，选中态用 Filled。
//    同一图标的两种风格 canvas 完全一致，切换时不会改变尺寸或位置。
//
//  * 画布尺寸：绝大多数图标是官方 24×24 画布，按目标尺寸重新栅格化。
//    唯一例外是「登录」：上游没有 24px 的 Sign In / Arrow Enter（逐文件实测 404），
//    因此改用官方 20×20 的 arrow_enter。它在 20px 下显示时笔画视觉重量与
//    24 画布缩放到 20px 的图标略有差异（WinUI 允许的取舍），若将来上游补上
//    24px 版本，改 tools/fetch-fluent-icons.ps1 清单里的 size 即可。
//
// 修改图标清单：改 tools/fetch-fluent-icons.ps1 里的 $manifest，重跑该脚本，
// 它会下载缺失资源、更新 SOURCES.md，并回填下面两个 generated 区块。
// =============================================================================

import { Theme } from "tokens.slint";

/// 图标语义名。
///
/// 成员名 = 语义，不是形状：`settings` 表示「设置」这个含义，
/// 而不是「齿轮画法」。改名请同步 tools/fetch-fluent-icons.ps1 的清单。
// <generated:enum>
export enum IconName {
    none,
    home,
    people,
    transfer,
    link,
    settings,
    folder,
    file,
    image,
    video,
    audio,
    archive,
    pdf,
    text,
    search,
    refresh,
    upload,
    download,
    folder-add,
    delete,
    rename,
    copy,
    move,
    folder-open,
    select-all,
    back,
    chevron-right,
    chevron-down,
    chevron-up,
    more,
    close,
    check,
    add,
    filter,
    sort,
    sort-asc,
    sort-desc,
    pause,
    play,
    cancel,
    retry,
    success,
    error,
    warning,
    account,
    password-show,
    password-hide,
    login,
    logout,
    info,
    cloud,
    cloud-off,
    storage,
    clock,
    light,
    dark,
    qr,
}
// </generated:enum>

