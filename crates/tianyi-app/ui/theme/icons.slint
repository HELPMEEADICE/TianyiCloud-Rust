// 图标系统
//
// 使用矢量路径（24x24 viewbox）而不是图标字体：
//  * 与 Fluent 线条风格一致，不依赖额外字体文件，删除 MaterialIcons-Regular.ttf 的 348KB 体积
//  * 单色、可着色、任意 DPI 下清晰
//  * 线宽在 viewbox 坐标系中给定，随尺寸等比缩放
//
// 所有图标默认按“描边线条”渲染；少数实心图标（播放、更多）通过 filled 开关填充。

import { Theme } from "tokens.slint";

/// 图标字形表：24x24 坐标系下的 SVG path 数据
export global Icons {
    // 文件夹
    out property <string> folder: "M3 7.5 A2.5 2.5 0 0 1 5.5 5 L9 5 L11.5 7.5 L18.5 7.5 A2.5 2.5 0 0 1 21 10 L21 17.5 A2.5 2.5 0 0 1 18.5 20 L5.5 20 A2.5 2.5 0 0 1 3 17.5 Z";
    // 通用文件
    out property <string> file: "M6 3 L13 3 L19 9 L19 20 A1 1 0 0 1 18 21 L6 21 A1 1 0 0 1 5 20 L5 4 A1 1 0 0 1 6 3 Z M13 3 L13 9 L19 9";
    // 图片
    out property <string> image: "M4 4 L20 4 A1 1 0 0 1 21 5 L21 19 A1 1 0 0 1 20 20 L4 20 A1 1 0 0 1 3 19 L3 5 A1 1 0 0 1 4 4 Z M3.5 16.5 L9 10.5 L14 16.5 M13.5 14.5 L16.5 11.5 L20.5 15.5";
    // 视频
    out property <string> video: "M3 6 A2 2 0 0 1 5 4 L15 4 A2 2 0 0 1 17 6 L17 18 A2 2 0 0 1 15 20 L5 20 A2 2 0 0 1 3 18 Z M17 10 L21 7 L21 17 L17 14";
    // 音频
    out property <string> audio: "M9 18 A3 3 0 1 1 3 18 A3 3 0 1 1 9 18 Z M9 18 L9 5 L20 3 L20 15 M20 15 A3 3 0 1 1 14 15 A3 3 0 1 1 20 15 Z";
    // PDF / 文档
    out property <string> pdf: "M6 3 L13 3 L19 9 L19 20 A1 1 0 0 1 18 21 L6 21 A1 1 0 0 1 5 20 L5 4 A1 1 0 0 1 6 3 Z M13 3 L13 9 L19 9 M8.5 13 L15.5 13 M8.5 16.5 L13.5 16.5";
    // 压缩包
    out property <string> archive: "M6 3 L13 3 L19 9 L19 20 A1 1 0 0 1 18 21 L6 21 A1 1 0 0 1 5 20 L5 4 A1 1 0 0 1 6 3 Z M13 3 L13 9 L19 9 M9 6 L11 6 M9 9 L11 9 M9 12 L11 12 M9 15.5 L11 15.5 M10 15.5 L10 18.5";
    // 文本 / 代码
    out property <string> text-file: "M6 3 L13 3 L19 9 L19 20 A1 1 0 0 1 18 21 L6 21 A1 1 0 0 1 5 20 L5 4 A1 1 0 0 1 6 3 Z M13 3 L13 9 L19 9 M8 12.5 L12 12.5 M8 16 L14 16";
    // 上传
    out property <string> upload: "M12 16 L12 3 M7.5 7.5 L12 3 L16.5 7.5 M4 20 L20 20";
    // 下载
    out property <string> download: "M12 3 L12 16 M7.5 11.5 L12 16 L16.5 11.5 M4 20 L20 20";
    // 刷新
    out property <string> refresh: "M20.5 12 A8.5 8.5 0 1 1 17.6 5.6 M17.6 3 L17.6 6.4 L21 6.4";
