    out property <string> settings: "M4 7 L9 7 M15 7 L20 7 M4 12 L13 12 M19 12 L20 12 M4 17 L11 17 M17 17 L20 17 M10 5.5 A1.8 1.8 0 1 0 14 5.5 A1.8 1.8 0 1 0 10 5.5 Z M13 10.5 A1.8 1.8 0 1 0 17 10.5 A1.8 1.8 0 1 0 13 10.5 Z M11 15.5 A1.8 1.8 0 1 0 15 15.5 A1.8 1.8 0 1 0 11 15.5 Z";
    // 暂停
    out property <string> pause: "M9 5 L9 19 M15 5 L15 19";
    // 继续（实心三角）
    out property <string> play: "M8 4.8 L19 12 L8 19.2 Z";
    // 取消 / 停止
    out property <string> cancel: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    // 删除垃圾桶
    out property <string> trash: "M4.5 7 L19.5 7 M9.5 7 L9.5 4.6 A1.6 1.6 0 0 1 11.1 3 L12.9 3 A1.6 1.6 0 0 1 14.5 4.6 L14.5 7 M6.3 7 L7.3 19.6 A1.6 1.6 0 0 0 8.9 21 L15.1 21 A1.6 1.6 0 0 0 16.7 19.6 L17.7 7 M10 11 L10 17 M14 11 L14 17";
    // 重命名（铅笔）
    out property <string> pencil: "M4 20 L4.6 15.8 L15.8 4.6 A2.2 2.2 0 0 1 19.4 8.2 L8.2 19.4 Z M14 6.4 L17.6 10";
    // 复制
    out property <string> copy: "M8.5 3.5 L18.5 3.5 L18.5 15.5 M5.5 7.5 L14.5 7.5 L14.5 20.5 L5.5 20.5 Z";
    // 更多（三个实心点）
    out property <string> more: "M5 10.6 A1.4 1.4 0 1 0 5 13.4 A1.4 1.4 0 1 0 5 10.6 Z M12 10.6 A1.4 1.4 0 1 0 12 13.4 A1.4 1.4 0 1 0 12 10.6 Z M19 10.6 A1.4 1.4 0 1 0 19 13.4 A1.4 1.4 0 1 0 19 10.6 Z";
    // 勾
    out property <string> check: "M4.5 12.5 L9.5 17.5 L19.5 6.5";
    // 警告
    out property <string> warning: "M12 3.5 L21.5 20.5 L2.5 20.5 Z M12 9 L12 14 M12 17 L12 17.6";
    // 信息
    out property <string> info: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 10.8 L12 16.8 M12 7.4 L12 8";
    // 云
    out property <string> cloud: "M7 18.5 A4.6 4.6 0 0 1 7 9.3 A5.6 5.6 0 0 1 17.4 8.8 A4.3 4.3 0 0 1 17 18.5 Z";
    // 存储
    out property <string> storage: "M3 7.5 A2 2 0 0 1 5 5.5 L19 5.5 A2 2 0 0 1 21 7.5 L21 16.5 A2 2 0 0 1 19 18.5 L5 18.5 A2 2 0 0 1 3 16.5 Z M3 12 L21 12 M6.5 15.2 L8.5 15.2";
    // 退出登录
    out property <string> logout: "M13 4 L6 4 A1 1 0 0 0 5 5 L5 19 A1 1 0 0 0 6 20 L13 20 M17 8 L21 12 L17 16 M10.5 12 L21 12";
    // 用户
    out property <string> person: "M12 4 A4 4 0 1 0 12 12 A4 4 0 1 0 12 4 Z M4 21 A8 8 0 0 1 20 21";
    // 显示密码
    out property <string> eye: "M12 5.5 C6 5.5 2 12 2 12 C2 12 6 18.5 12 18.5 C18 18.5 22 12 22 12 C22 12 18 5.5 12 5.5 Z M12 9.2 A2.8 2.8 0 1 0 12 14.8 A2.8 2.8 0 1 0 12 9.2 Z";
    // 隐藏密码
    out property <string> eye-off: "M3 3 L21 21 M12 5.5 C6 5.5 2 12 2 12 C2 12 3.4 14.2 5.7 16 M12 18.5 C18 18.5 22 12 22 12 C22 12 20.7 9.9 18.4 8 M10 10 A2.8 2.8 0 0 0 14 14";
    // 浅色
    out property <string> sun: "M12 7.5 A4.5 4.5 0 1 0 12 16.5 A4.5 4.5 0 1 0 12 7.5 Z M12 2 L12 4.2 M12 19.8 L12 22 M2 12 L4.2 12 M19.8 12 L22 12 M4.9 4.9 L6.5 6.5 M17.5 17.5 L19.1 19.1 M19.1 4.9 L17.5 6.5 M6.5 17.5 L4.9 19.1";
    // 深色
    out property <string> moon: "M20 15.2 A9 9 0 0 1 8.8 4 A9 9 0 1 0 20 15.2 Z";
    // 二维码
    out property <string> qr: "M4 4 L9 4 L9 9 L4 9 Z M15 4 L20 4 L20 9 L15 9 Z M4 15 L9 15 L9 20 L4 20 Z M14.5 14.5 L18 14.5 L18 18.5 L14.5 18.5 Z M20.5 14.5 L20.5 16 M14.5 20.5 L16.5 20.5 M20.5 19 L20.5 20.5";
    // 面向上箭头（展开）
    out property <string> arrow-up: "M12 20 L12 5 M6.5 10.5 L12 5 L17.5 10.5";
    // 排序
    out property <string> sort: "M4 6.5 L20 6.5 M7 12 L17 12 M10 17.5 L14 17.5";
}

/// 通用图标：按尺寸绘制上面字形表中的路径
export component Icon inherits Rectangle {
    in property <string> glyph: Icons.file;
    in property <brush> icon-color: Theme.text-secondary;
    in property <length> size: 16px;
    in property <length> thickness: 1.6px;
    /// 实心图标（播放、更多等）置 true
    in property <bool> filled: false;

    width: size;
    height: size;
    background: transparent;

    Path {
        commands: root.glyph;
        width: root.size;
        height: root.size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fit: contain;
        stroke: root.filled ? transparent : root.icon-color;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.icon-color : transparent;
    }
}
