// 共享数据结构与全局接口
//
// 所有页面/组件都从这里导入结构体，避免 main.slint 成为全局状态集散地。

/// 布局度量：把「宽度 → 布局档位」这类纯计算从组件里抽出来，便于单独断言
export global LayoutMetrics {
    /// 依据**内容区可用宽度**（整窗宽度 − 左侧导航栏宽度）决定文件列表显示几列
    /// 次要信息：0=仅名称 1=+大小 2=+修改时间 3=+类型。
    ///
    /// 断点必须量内容区宽度：导航栏展开时占 248px（`Theme.nav-width`），
    /// 用整窗宽度当基准会把默认 1180px 窗口（内容区只有 932px）判成四列。
    /// 首个断点取 640px：最小窗口 900px（导航折叠，内容区 844px）仍显示"大小"列，
    /// 却不显示"修改时间"列。
    public pure function detail-level-of(content-width: length) -> int {
        content-width < 640px ? 0
            : content-width < 1120px ? 1
            : content-width < 1300px ? 2
            : 3
    }

    /// 导航栏是否折叠成图标栏（等价于整窗宽度 < 960px）。
    ///
    /// 断点以代码为唯一来源：README 与文档写过的 1040px 是历史值，实测校准后是 960px。
    /// 数值本身不要凭手感改——`detail-level-of` 的三档断言与 ui_tests 的几何断言都
    /// 建立在这个值上，牵一发动全身。判断量是**整窗宽度**（导航栏自己占多宽取决于
    /// 是否折叠，用内容区宽度判会自相矛盾）。
    public pure function nav-compact-of(window-width: length) -> bool {
        window-width < 960px
    }
}

/// 文件列表项（个人云 / 家庭云 / 搜索结果共用）
export struct FileEntry {
    id: string,
    name: string,
    size: int,
    size_text: string,
    is_dir: bool,
    modified: string,
    /// 分类键：folder/image/video/audio/pdf/text/archive/office/other
    kind: string,
    /// 类型列展示文案（文件夹 / 图片 / 视频 …）
    kind_text: string,
    /// 是否被选中。多选状态由 Rust 侧作为唯一事实来源写入本字段，
    /// UI 只读不写，避免"界面显示已选中、后端只操作一个文件"的状态分裂。
    selected: bool,
}

/// 传输任务项
export struct TransferEntry {
    id: int,
    name: string,
    /// upload / download
    direction: string,
    size_text: string,
    /// 0..100
    progress: float,
    /// pending/running/paused/completed/failed/canceled
    status: string,
    /// 本地化状态文案
    status_text: string,
    speed: string,
    /// “1.2 MB / 5.0 MB · 剩余 12 秒”
    detail: string,
    error: string,
}

/// 面包屑路径项
export struct CrumbEntry {
    /// 目录 id（根目录为 "-11"）
    id: string,
    name: string,
}

/// 轻量 Tooltip 状态（由组件在悬停时写入，主窗口统一渲染）
///
/// 不使用声明式 `Tooltip` 元素：它在部分容器中会干扰同级的命中测试，
/// 这里用全局状态 + 窗口顶层浮层实现，行为可控且没有额外开销。
export global TooltipState {
    in-out property <string> text: "";
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <bool> visible: false;
    /// 当前 Tooltip 的归属键：写入方在点亮 Tooltip 时填自己的唯一键
    /// （icon-button / button 用「tip:文案@x,y」——带实例绝对位置，同文案不互相干扰；
    /// nav-item 用「nav:标签」；设置页路径用「path:标签」；存储指示用「storage」）。
    ///
    /// 解决的是"互相抢占"：鼠标从 A 移到 B 时，两个 `changed has-hover` 谁先谁后
    /// 不确定——若 B 先点亮、A 的收尾再无条件 `visible = false`，B 刚弹出的
    /// Tooltip 会被 A 关掉，表现为"Tooltip 时有时无"。有了归属键，写入方只在
    /// "当前这盏灯还是我点亮的"时才负责熄灭，别人的灯不动。
    in-out property <string> owner: "";
}

/// 键盘修饰键状态
///
/// Slint 的 TouchArea 不提供点击时的修饰键信息，因此由 Rust 侧的窗口事件
/// （winit ModifiersChanged）写入，列表行在点击回调里读取，用于实现
/// Ctrl+点击切换、Shift+点击范围选择。
export global ModifiersApi {
    in-out property <bool> ctrl: false;
    in-out property <bool> shift: false;
    in-out property <bool> alt: false;
}

/// 浮层遮罩是否正在阻止背景控件进入 Tab 序列
///
/// 只回答一个问题："现在有模态浮层挡在上面吗"。判定累在 `main.slint` 的窗口根部
/// （唯一的写入点），消费方只有 `ActivateScope`：
///   `enabled: active && (!ModalsApi.blocking || modal)`
///
/// 为什么需要它：Slint 的 `FocusScope` **不拦 Tab**——`window.rs` 的 Tab 分支直接调
/// `focus_next_item()` / `move_focus()`，后者沿整棵 item 树找下一个可聚焦元素
/// （i-slint-core-1.17.1 window.rs:1315-1343）。对话框/菜单只是视觉上的"模态"，
/// 不加这层判定时连按 Tab 就能走到背景导航项并被空格激活。
export global ModalsApi {
    in-out property <bool> blocking: false;
}

/// 拖出下载（Ctrl/Shift + 拖动文件行）的跨线程状态
export global DragOutApi {
    in property <bool> mod-pressed: false;
    in property <bool> active: false;
    in property <string> active-id: "";
    callback drag_out(string, string);
}

/// 最近一次交互来自键盘还是鼠标。焦点环只在键盘模式下显示（对齐 WinUI）。
///
/// Slint 自己的 `FocusScope` 只知道"谁有焦点"，不知道焦点是 Tab 键走到这儿的、
/// 还是鼠标点出来的；而 WinUI 规范要求鼠标点击不显示焦点环。控件里的焦点环
/// 因此统一绑到 `fs.has-focus && InputMode.keyboard`。
export global InputMode {
    in-out property <bool> keyboard: false;

    /// **唯一写入入口**：所有控件都通过它更新键盘模式，不得直接写 `keyboard`。
    ///
    /// 有两个驱动源，二者结论一致、互为兜底：
    /// 1. **主驱动**：`src/main.rs` 的 winit 钩子把原始输入事件映射过来——任何
    ///    `KeyboardInput` 置真，任何鼠标按下置假。它覆盖了 focus-reason 判断不到的
    ///    两种情况：点击空白处（没有可聚焦元素，不产生 focus 变化）、点击已聚焦的
    ///    同一控件（reason 不变）。
    /// 2. **兜底**：`track-focus(reason)` 用"焦点变化的原因"近似——Tab 进入 = 键盘，
    ///    其余 = 鼠标。没有 winit 窗口时（例如 `examples/ui_preview` 的软件渲染器）
    ///    仍能保持行为合理。
    /// 换驱动源时只改本函数体或 Rust 侧那一处（调用方一行都不用动）。
    public function track-focus(reason: FocusReason) {
        keyboard = reason == FocusReason.tab-navigation;
    }
}
