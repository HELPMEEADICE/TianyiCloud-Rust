// 天翼云盘客户端 UI

import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import "./fonts/MaterialIcons-Regular.ttf";

export struct FileEntry {
    id: string,
    name: string,
    size: int,
    size_text: string,
    is_dir: bool,
    thumb: string,
    modified: string,
}

export struct TransferEntry {
    id: int,
    name: string,
    direction: string,
    size_text: string,
    progress: float,
    status: string,
    speed: string,
}

// ===== 基础图标组件 =====
// 使用 Material Icons 字体，所有图标在 fonts/MaterialIcons-Regular.ttf
component Icon inherits Text {
    in property <string> glyph: "\u{e2bd}";
    in property <brush> icon-color: #1f2937;
    font-family: "Material Icons";
    text: glyph;
    color: icon-color;
    font-size: 20px;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// ===== 带图标的文字按钮 =====
component TextIconButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        cross-axis-alignment: center;
        alignment: center;

        Icon {
            glyph: root.icon;
            icon-color: root.enabled ? #1e3a8a : #cbd5e1;
            font-size: 16px;
        }

        Text {
            text: root.text;
            color: root.enabled ? #1e3a8a : #cbd5e1;
            font-size: 13px;
            font-weight: 500;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ===== 侧边栏导航按钮 =====
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    border-radius: 8px;
    background: active ? #ffffff : #1e3a8a;

    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Icon {
            glyph: root.icon;
            icon-color: root.active ? #2563eb : #ffffff;
            font-size: 20px;
        }

        Text {
            text: root.label;
            color: root.active ? #1e3a8a : #e2e8f0;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// ===== 文件列表项 =====
component FileItem inherits Rectangle {
    in property <FileEntry> entry;
    in property <bool> selected: false;
    in property <bool> renaming: false;
    in property <data-transfer> drag-data;
    in property <bool> is-drop-target: false;
    callback item_clicked();
    callback item_double_clicked();
    callback item_context_requested(string, string, bool, length, length);
    callback rename_submitted(string);
    callback drop_can_accept(DropEvent, string) -> DragAction;
    callback drop_requested(DropEvent, string) -> DragAction;

    height: 52px;
    border-radius: 8px;
    background: selected ? #e0f2fe : (da.has-drag ? #eff6ff : transparent);
    border-width: 1px;
    border-color: da.has-drag ? #93c5fd : transparent;

    DragArea {
        enabled: !root.renaming;
        data: root.drag-data;
        allow-move: true;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            cross-axis-alignment: center;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                background: entry.is_dir ? #fef3c7 : #e0f2fe;
                Icon {
                    glyph: entry.is_dir ? "\u{e2c7}" : "\u{e24d}";
                    icon-color: entry.is_dir ? #d97706 : #2563eb;
                    font-size: 20px;
                }
            }

            if !root.renaming: Text {
                text: entry.name;
                color: #111827;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }

            rename-input := LineEdit {
                visible: root.renaming;
                text: entry.name;
                font-size: 14px;
                horizontal-stretch: 1;
                accepted => {
                    root.rename_submitted(rename-input.text);
                }
            }

            Text {
                text: entry.size_text;
                color: #9ca3af;
                font-size: 12px;
                width: 80px;
            }

            Text {
                text: entry.modified;
                color: #9ca3af;
                font-size: 12px;
                width: 130px;
            }
        }

        ta := TouchArea {
            enabled: !root.renaming;
            clicked => {
                root.item_clicked();
            }
            double-clicked => {
                root.item_double_clicked();
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    root.item_context_requested(
                        entry.id,
                        entry.name,
                        entry.is_dir,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y
                    );
                }
            }
        }
    }

    da := DropArea {
        enabled: root.is-drop-target;
        can-drop(event) => { root.drop_can_accept(event, entry.id); }
        dropped(event) => { root.drop_requested(event, entry.id); }
    }

    changed renaming => {
        if (renaming) {
            rename-input.text = entry.name;
            rename-input.focus();
            rename-input.select-all();
        }
    }
}

// ===== 右键菜单项 =====
component ContextMenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback triggered();

    height: 34px;
    border-radius: 7px;
    background: touch-area.has-hover ? (root.danger ? #fee2e2 : #eff6ff) : transparent;
    animate background { duration: 110ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        Icon {
            glyph: root.icon;
            icon-color: root.danger ? #dc2626 : #475569;
            font-size: 18px;
        }

        Text {
            text: root.label;
            color: root.danger ? #dc2626 : #1f2937;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch-area := TouchArea {
        clicked => { root.triggered(); }
    }
}

// ===== 登录面板 =====
component LoginPanel inherits Rectangle {
    in property <string> error_text;
    in property <bool> show_captcha;
    in property <image> captcha_image;
    in property <image> qr_image;
    in property <string> qr_status_text;
    in property <bool> login_loading;
    in property <bool> qr_mode;
    in property <[string]> saved_accounts: [];

    callback do_login(string, string, string);
    callback do_switch_mode(bool);
    callback do_qr_refresh();
    callback do_quick_login(string);

    background: #ffffff;
    border-radius: 16px;
    border-width: 1px;
    border-color: #e2e8f0;

    VerticalLayout {
        padding-left: 48px;
        padding-right: 48px;
        padding-top: 40px;
        padding-bottom: 40px;
        spacing: 14px;
        alignment: center;

        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            background: #2563eb;
            Icon {
                glyph: "\u{e2bd}";
                icon-color: #ffffff;
                font-size: 40px;
            }
        }

        Text {
            text: "天翼云盘";
            font-size: 28px;
            font-weight: 700;
            color: #1e3a8a;
            horizontal-alignment: center;
        }

        Text {
            text: "登录以同步您的云端文件";
            font-size: 13px;
            color: #6b7280;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            Button {
                text: "密码登录";
                enabled: !login_loading;
                clicked => { root.do_switch_mode(false); }
            }
            Button {
                text: "扫码登录";
                enabled: !login_loading;
                clicked => { root.do_switch_mode(true); }
            }
        }

        VerticalLayout {
            visible: !qr_mode && saved_accounts.length > 0;
            spacing: 8px;

            Text {
                text: "已保存的账号";
                color: #6b7280;
                font-size: 12px;
                horizontal-alignment: center;
            }

            for account in saved_accounts : Button {
                text: account;
                enabled: !login_loading;
                width: 280px;
                clicked => { root.do_quick_login(account); }
            }
        }

        VerticalLayout {
            visible: !qr_mode;
            spacing: 12px;

            username-input := LineEdit {
                placeholder-text: "手机号 / 邮箱";
                width: 300px;
            }
            password-input := LineEdit {
                placeholder-text: "密码";
                width: 300px;
            }

            VerticalLayout {
                visible: show_captcha;
                spacing: 6px;
                Image {
                    source: captcha_image;
                    height: 52px;
                    width: 180px;
                }
                captcha-input := LineEdit {
                    placeholder-text: "验证码";
                    width: 180px;
                }
            }

            Button {
                text: login_loading ? "登录中..." : "登 录";
                enabled: !login_loading;
                width: 200px;
                clicked => {
                    root.do_login(username-input.text, password-input.text, captcha-input.text);
                }
            }
        }

        VerticalLayout {
            visible: qr_mode;
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 220px;
                height: 220px;
                background: #f8fafc;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e2e8f0;

                Image {
                    source: qr_image;
                    width: 190px;
                    height: 190px;
                }
            }

            Text {
                text: qr_status_text;
                color: #6b7280;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Button {
                text: "刷新二维码";
                enabled: !login_loading;
                clicked => {
                    root.do_qr_refresh();
                }
            }
        }

        Text {
            visible: error_text != "";
            text: error_text;
            color: #dc2626;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// ===== 工具栏图标按钮 =====
component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    width: 46px;
    border-radius: 8px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;

    Icon {
        glyph: root.icon;
        icon-color: root.enabled ? #1e3a8a : #cbd5e1;
        font-size: 20px;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ===== 页面标题与容量摘要 =====
component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> used_space: "0 B";
    in property <string> total_space: "0 B";
    in property <float> capacity_ratio: 0.0;

    height: 70px;
    background: #ffffff;
    border-radius: 14px;
    border-width: 1px;
    border-color: #e5e7eb;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: #dbeafe;
            Icon {
                glyph: "\u{e2bd}";
                icon-color: #2563eb;
                font-size: 22px;
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                color: #111827;
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: root.subtitle;
                color: #94a3b8;
                font-size: 12px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 230px;
            height: 46px;
            border-radius: 10px;
            background: #eff6ff;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 5px;

                HorizontalLayout {
                    Text {
                        text: "存储空间";
                        color: #1d4ed8;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.used_space + " / " + root.total_space;
                        color: #1e3a8a;
                        font-size: 12px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    height: 5px;
                    border-radius: 3px;
                    background: #bfdbfe;
                    progress-fill := Rectangle {
                        x: 0px;
                        width: parent.width * Math.min(1.0, Math.max(0.0, root.capacity_ratio));
                        height: 5px;
                        border-radius: 3px;
                        background: #2563eb;
                    }
                }
            }
        }
    }
}

component CapacityCard inherits Rectangle {
    in property <string> used_space: "0 B";
    in property <string> total_space: "0 B";
    in property <float> capacity_ratio: 0.0;

    height: 126px;
    border-radius: 12px;
    background: #2563eb;

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Icon {
                glyph: "\u{e2be}";
                icon-color: #ffffff;
                font-size: 22px;
            }
            Text {
                text: "云存储容量";
                color: #dbeafe;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.used_space;
            color: #ffffff;
            font-size: 20px;
            font-weight: 800;
        }

        Text {
            text: "已使用 / 总容量  ·  " + root.total_space;
            color: #bfdbfe;
            font-size: 11px;
        }

        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: #60a5fa;
            progress-fill := Rectangle {
                x: 0px;
                width: parent.width * Math.min(1.0, Math.max(0.0, root.capacity_ratio));
                height: 6px;
                border-radius: 3px;
                background: #ffffff;
            }
        }

        HorizontalLayout {
            Text {
                text: "0%";
                color: #dbeafe;
                font-size: 10px;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: Math.round(Math.min(1.0, Math.max(0.0, root.capacity_ratio)) * 100.0) + "% 已用";
                color: #ffffff;
                font-size: 10px;
                font-weight: 700;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: "100%";
                color: #dbeafe;
                font-size: 10px;
            }
        }
    }
}

// ===== 文件管理面板 =====
component FileListPanel inherits VerticalLayout {
    in property <[FileEntry]> files;
    in property <string> current_path;
    in property <string> status_text;
    in property <string> account_name;
    in property <string> total-space: "0 B";
    in property <string> used-space: "0 B";
    in property <string> selected_id: "";
    in property <string> renaming_id: "";

    callback item_open(string, string, bool);
    callback item_select(string);
    callback item_context_requested(string, string, bool, length, length);
    callback do_refresh();
    callback do_navigate_up();
    callback do_upload();
    callback do_create_folder();
    callback do_search(string);
    callback do_logout();
    callback do_switch_space(string);
    callback do_download(string, string);
    callback do_delete(string, string);
    callback do_rename(string, string);
    callback do_get_link(string, string);
    callback do_move(string, string);
    callback do_copy(string, string);
    pure callback make_drag_data(string, string, bool) -> data-transfer;
    callback drop_can_accept(DropEvent, string) -> DragAction;
    callback drop_requested(DropEvent, string) -> DragAction;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    padding: 16px;
    spacing: 12px;

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: #e0f2fe;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    Icon {
                        glyph: "\u{e853}";
                        icon-color: #2563eb;
                        font-size: 18px;
                    }
                    Text {
                        text: account_name == "" ? "未登录" : account_name;
                        color: #1e3a8a;
                        font-weight: 600;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            ToolButton {
                icon: "\u{e2c4}";
                label: "下载";
                enabled: root.selected_id != "";
                clicked => { root.do_download(root.selected_id, ""); }
            }
            ToolButton {
                icon: "\u{e872}";
                label: "删除";
                enabled: root.selected_id != "";
                clicked => { root.do_delete(root.selected_id, ""); }
            }
            ToolButton {
                icon: "\u{e3c9}";
                label: "重命名";
                enabled: root.selected_id != "";
                clicked => { root.do_rename(root.selected_id, ""); }
            }
            ToolButton {
                icon: "\u{e14d}";
                label: "复制";
                enabled: root.selected_id != "";
                clicked => { root.do_copy(root.selected_id, ""); }
            }
            ToolButton {
                icon: "\u{e157}";
                label: "提取链接";
                enabled: root.selected_id != "";
                clicked => { root.do_get_link(root.selected_id, ""); }
            }
            ToolButton {
                icon: "\u{e9ba}";
                label: "退出登录";
                clicked => { root.do_logout(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Button {
                text: "上传";
                clicked => { root.do_upload(); }
            }
            Button {
                text: "新建文件夹";
                clicked => { root.do_create_folder(); }
            }
            Button {
                text: "刷新";
                clicked => { root.do_refresh(); }
            }

            Rectangle {
                width: 1px;
                height: 24px;
                background: #e2e8f0;
            }

            TextIconButton {
                text: "个人云";
                icon: "\u{e853}";
                clicked => { root.do_switch_space("personal"); }
            }
            TextIconButton {
                text: "家庭云";
                icon: "\u{e7ef}";
                clicked => { root.do_switch_space("family"); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            search-input := LineEdit {
                placeholder-text: "搜索文件...";
                width: 200px;
                edited => {
                    if (search-input.text != "") {
                        root.do_search(search-input.text);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            TextIconButton {
                text: "上级";
                icon: "\u{e5c4}";
                enabled: current_path != "";
                clicked => { root.do_navigate_up(); }
            }
            Text {
                text: current_path == "" ? "根目录" : current_path;
                color: #374151;
                font-size: 14px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            background: #ffffff;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e5e7eb;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        padding: 6px;

                        for entry in files : FileItem {
                            entry: entry;
                            selected: entry.id == root.selected_id;
                            renaming: entry.id == root.renaming_id;
                            drag-data: root.make_drag_data(entry.id, entry.name, entry.is_dir);
                            is-drop-target: entry.is_dir;
                            item_clicked() => {
                                root.item_select(entry.id);
                            }
                            item_double_clicked() => {
                                root.item_open(entry.id, entry.name, entry.is_dir);
                            }
                            item_context_requested(id, name, is_dir, x, y) => {
                                root.item_context_requested(id, name, is_dir, x, y);
                            }
                            rename_submitted(name) => {
                                root.do_rename(entry.id, name);
                            }
                            drop_can_accept(event, folder_id) => {
                                root.drop_can_accept(event, folder_id);
                            }
                            drop_requested(event, folder_id) => {
                                root.drop_requested(event, folder_id);
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            Text {
                text: status_text;
                color: #6b7280;
                font-size: 12px;
                horizontal-stretch: 1;
            }
            Text {
                text: "容量 " + used-space + " / " + total-space;
                color: #9ca3af;
                font-size: 12px;
            }
        }
}

// ===== 传输任务项 =====
component TransferItem inherits Rectangle {
    in property <TransferEntry> entry;
    callback do_cancel();
    callback do_pause();

    height: 56px;
    border-radius: 8px;
    background: #ffffff;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: entry.direction == "upload" ? #dcfce7 : #dbeafe;
            Icon {
                glyph: entry.direction == "upload" ? "\u{e2c6}" : "\u{e2c4}";
                icon-color: entry.direction == "upload" ? #16a34a : #2563eb;
                font-size: 18px;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: entry.name;
                color: #1f2937;
                font-size: 13px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: Math.round(entry.progress) + "%";
                    color: #94a3b8;
                    font-size: 10px;
                    width: 24px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 6px;
                    border-radius: 3px;
                    background: #e5e7eb;
                    progress-fill := Rectangle {
                        x: 0px;
                        width: parent.width * Math.min(1.0, Math.max(0.0, entry.progress / 100.0));
                        height: 6px;
                        border-radius: 3px;
                        background: entry.direction == "upload" ? #16a34a : #2563eb;
                    }
                }

                Text {
                    text: "100%";
                    color: #94a3b8;
                    font-size: 10px;
                    width: 32px;
                }
            }
        }

        Text {
            text: entry.status;
            color: #6b7280;
            font-size: 12px;
            width: 70px;
        }

        Text {
            text: entry.speed;
            color: #16a34a;
            font-size: 12px;
            width: 80px;
        }

        Text {
            text: Math.round(entry.progress) + "%";
            color: #374151;
            font-size: 12px;
            width: 40px;
        }

        ToolButton {
            icon: "\u{e034}";
            label: "暂停";
            clicked => { root.do_pause(); }
        }
        ToolButton {
            icon: "\u{e5cd}";
            label: "取消";
            clicked => { root.do_cancel(); }
        }
    }
}

// ===== 传输面板 =====
component TransferPanel inherits Rectangle {
    in property <[TransferEntry]> transfers;
    callback cancel_task(int);
    callback pause_task(int);

    background: #ffffff;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Icon {
                glyph: "\u{e8b6}";
                icon-color: #2563eb;
                font-size: 18px;
            }
            Text {
                text: "传输任务 (" + transfers.length + ")";
                font-size: 14px;
                font-weight: 600;
                color: #374151;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: "实时进度";
                color: #9ca3af;
                font-size: 12px;
            }
        }

        Rectangle {
            background: #f8fafc;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e5e7eb;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        padding: 6px;
                        for t in transfers : TransferItem {
                            entry: t;
                            do_cancel() => { root.cancel_task(t.id); }
                            do_pause() => { root.pause_task(t.id); }
                        }
                    }
                }
            }
        }
    }
}

// ===== 拖拽上传悬浮遮罩 =====
component DropOverlay inherits Rectangle {
    in property <string> target_name: "";
    in property <bool> active: false;

    background: #2563eb22;
    border-radius: 12px;
    border-width: 2px;
    border-color: #2563eb;
    opacity: root.active ? 1.0 : 0.0;
    animate opacity { duration: 150ms; easing: ease-out; }

    Rectangle {
        border-radius: 10px;
        border-width: 2px;
        border-color: #2563eb;
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: #1e3a8a;
                Icon {
                    glyph: "\u{e2c6}";
                    icon-color: #ffffff;
                    font-size: 28px;
                }
            }
            Text {
                text: "松开上传到 " + (root.target_name == "" ? "当前目录" : root.target_name);
                color: #1e3a8a;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "支持文件与文件夹（文件夹将自动创建同名云端目录）";
                color: #3b5b9a;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }
}

// ===== 云盘工作区 =====
component CloudPage inherits Rectangle {
    in property <string> page_title;
    in property <string> page_subtitle;
    in property <[FileEntry]> files;
    in property <string> current_path;
    in property <string> status_text;
    in property <string> account_name;
    in property <string> total_space: "0 B";
    in property <string> used_space: "0 B";
    in property <float> capacity_ratio: 0.0;
    in property <string> selected_id: "";
    in property <string> renaming_id: "";
    in property <[TransferEntry]> transfers: [];
    in property <bool> searching: false;
    in property <string> search_keyword: "";
    in property <[FileEntry]> search_results: [];
    in property <bool> drop-active: false;
    in property <string> drop-target-name: "";

    callback open_item(string, string, bool);
    callback select_item(string);
    callback item_context_requested(string, string, bool, length, length);
    callback refresh_files();
    callback navigate_up();
    callback upload_files();
    callback create_folder();
    callback search_files(string);
    callback clear_search();
    callback logout();
    callback switch_space(string);
    callback download_file(string);
    callback delete_file(string);
    callback rename_file(string, string);
    callback copy_file(string);
    callback get_link(string);
    callback cancel_task(int);
    pure callback make_drag_data(string, string, bool) -> data-transfer;
    callback drop_can_accept(DropEvent, string) -> DragAction;
    callback drop_requested(DropEvent, string) -> DragAction;

    background: #f1f5f9;

    VerticalLayout {
        spacing: 10px;

        PageHeader {
            title: root.page_title;
            subtitle: root.page_subtitle;
            used_space: root.used_space;
            total_space: root.total_space;
            capacity_ratio: root.capacity_ratio;
        }

        if (root.searching): Rectangle {
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e5e7eb;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    TextIconButton {
                        text: "返回";
                        icon: "\u{e5c4}";
                        clicked => { root.clear_search(); }
                    }
                    Text {
                        text: "搜索: " + root.search_keyword;
                        color: #374151;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: #f8fafc;
                    border-radius: 8px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            padding: 6px;
                            for result in root.search_results : FileItem {
                                entry: result;
                                selected: result.id == root.selected_id;
                                item_clicked() => {
                                    root.open_item(result.id, result.name, result.is_dir);
                                }
                                item_double_clicked() => {
                                    root.open_item(result.id, result.name, result.is_dir);
                                }
                                item_context_requested(id, name, is_dir, x, y) => {
                                    root.item_context_requested(id, name, is_dir, x, y);
                                }
                            }
                        }
                    }
                }
            }
        }

        if (!root.searching): Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            FileListPanel {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                files: root.files;
                current_path: root.current_path;
                status_text: root.status_text;
                account_name: root.account_name;
                total-space: root.total_space;
                used-space: root.used_space;
                selected_id: root.selected_id;
                renaming_id: root.renaming_id;

                item_open(id, name, is_dir) => {
                    root.open_item(id, name, is_dir);
                }
                item_select(id) => {
                    root.select_item(id);
                }
                item_context_requested(id, name, is_dir, x, y) => {
                    root.item_context_requested(id, name, is_dir, x, y);
                }
                do_refresh() => { root.refresh_files(); }
                do_navigate_up() => { root.navigate_up(); }
                do_upload() => { root.upload_files(); }
                do_create_folder() => { root.create_folder(); }
                do_download(id, name) => { root.download_file(id); }
                do_delete(id, name) => { root.delete_file(id); }
                do_rename(id, name) => { root.rename_file(id, name); }
                do_copy(id, name) => { root.copy_file(id); }
                do_get_link(id, name) => { root.get_link(id); }
                do_search(keyword) => { root.search_files(keyword); }
                do_logout() => { root.logout(); }
                do_switch_space(space) => { root.switch_space(space); }
                make_drag_data(id, name, is_dir) => { root.make_drag_data(id, name, is_dir); }
                drop_can_accept(event, folder_id) => { root.drop_can_accept(event, folder_id); }
                drop_requested(event, folder_id) => { root.drop_requested(event, folder_id); }
            }

            DropOverlay {
                width: parent.width;
                height: parent.height;
                target_name: root.drop-target-name;
                active: root.drop-active;
            }
        }

        Rectangle {
            height: 174px;
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e5e7eb;

            TransferPanel {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                transfers: root.transfers;
                cancel_task(id) => { root.cancel_task(id); }
                pause_task(id) => { root.cancel_task(id); }
            }
        }
    }
}

// ===== 独立传输任务页 =====
component TransferPage inherits Rectangle {
    in property <string> used_space: "0 B";
    in property <string> total_space: "0 B";
    in property <float> capacity_ratio: 0.0;
    in property <[TransferEntry]> transfers: [];
    callback cancel_task(int);

    background: #f1f5f9;

    VerticalLayout {
        spacing: 10px;

        PageHeader {
            title: "传输任务";
            subtitle: "集中查看上传与下载进度";
            used_space: root.used_space;
            total_space: root.total_space;
            capacity_ratio: root.capacity_ratio;
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e5e7eb;

            TransferPanel {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                transfers: root.transfers;
                cancel_task(id) => { root.cancel_task(id); }
                pause_task(id) => { root.cancel_task(id); }
            }
        }
    }
}

// ===== 独立分享链接页 =====
component SharePage inherits Rectangle {
    in property <string> used_space: "0 B";
    in property <string> total_space: "0 B";
    in property <float> capacity_ratio: 0.0;
    callback go_personal();

    background: #f1f5f9;

    VerticalLayout {
        spacing: 10px;

        PageHeader {
            title: "分享链接";
            subtitle: "管理已创建的文件分享链接";
            used_space: root.used_space;
            total_space: root.total_space;
            capacity_ratio: root.capacity_ratio;
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e5e7eb;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                alignment: center;
                spacing: 12px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 20px;
                    background: #dbeafe;
                    Icon {
                        glyph: "\u{e157}";
                        icon-color: #2563eb;
                        font-size: 32px;
                    }
                }

                Text {
                    text: "暂无分享链接";
                    color: #1f2937;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "在个人云或家庭云中选择文件，使用工具栏的“提取链接”即可创建分享。";
                    color: #94a3b8;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                TextIconButton {
                    text: "返回个人云";
                    icon: "\u{e88a}";
                    clicked => { root.go_personal(); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "天翼云盘客户端";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 620px;
    background: #f1f5f9;

    in property <bool> logged_in: false;
    in property <[FileEntry]> file_list: [];
    in property <string> current_path: "";
    in property <string> status_text: "就绪";
    in property <string> account_name: "";
    in property <[TransferEntry]> transfer_list: [];
    in property <bool> searching: false;
    in property <string> search_keyword: "";
    in property <[FileEntry]> search_results: [];
    in property <string> selected_id: "";
    in property <string> renaming_id: "";
    in property <bool> qr_mode: false;

    in property <string> login_error: "";
    in property <bool> show_captcha: false;
    in property <image> captcha_image;
    in property <image> qr_image;
    in property <string> qr_status: "请使用天翼云盘App扫码";
    in property <bool> login_loading: false;
    in property <[string]> saved_accounts: [];

    in property <string> total_space: "0 B";
    in property <string> used_space: "0 B";
    in property <float> capacity_ratio: 0.0;
    property <int> current_page: 0;
    property <bool> context-menu-visible: false;
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;
    property <string> context-item-id: "";
    property <string> context-item-name: "";
    property <bool> context-item-is-dir: false;
    property <length> context-menu-height: context-item-is-dir ? 196px : 270px;

    in property <bool> drop-active: false;
    in property <string> drop-target-name: "";

    callback login_request(string, string, string);
    callback qr_refresh();
    callback switch_mode(bool);
    callback quick_login(string);
    callback open_item(string, string, bool);
    callback item_context_requested(string, string, bool, length, length);
    callback select_item(string);
    callback refresh_files();
    callback navigate_up();
    callback upload_files();
    callback create_folder();
    callback download_file(string);
    callback delete_file(string);
    callback rename_file(string, string);
    callback copy_file(string);
    callback get_link(string);
    callback search_files(string);
    callback clear_search();
    callback cancel_task(int);
    callback logout();
    callback switch_space(string);
    callback files_dropped(string);
    pure callback make_drag_data(string, string, bool) -> data-transfer;
    callback drop_can_accept(DropEvent, string) -> DragAction;
    callback drop_requested(DropEvent, string) -> DragAction;

    // ===== 四个独立页面与滑动淡入切换 =====
    HorizontalLayout {
        Rectangle {
            width: 216px;
            background: #1e3a8a;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding: 16px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: #2563eb;
                        Icon {
                            glyph: "\u{e2bd}";
                            icon-color: #ffffff;
                            font-size: 22px;
                        }
                    }
                    Text {
                        text: "天翼云盘";
                        color: #ffffff;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 18px;
                }

                NavItem {
                    icon: "\u{e88a}";
                    label: "首页";
                    active: root.current_page == 0;
                    enabled: root.logged_in;
                    clicked => {
                        root.current_page = 0;
                        root.switch_space("personal");
                    }
                }
                NavItem {
                    icon: "\u{e7ef}";
                    label: "家庭云";
                    active: root.current_page == 1;
                    enabled: root.logged_in;
                    clicked => {
                        root.current_page = 1;
                        root.switch_space("family");
                    }
                }
                NavItem {
                    icon: "\u{e2c4}";
                    label: "传输任务";
                    active: root.current_page == 2;
                    enabled: root.logged_in;
                    clicked => {
                        root.current_page = 2;
                    }
                }
                NavItem {
                    icon: "\u{e157}";
                    label: "分享链接";
                    active: root.current_page == 3;
                    enabled: root.logged_in;
                    clicked => {
                        root.current_page = 3;
                    }
                }

                Rectangle {
                    height: 16px;
                }

                CapacityCard {
                    used_space: root.used_space;
                    total_space: root.total_space;
                    capacity_ratio: root.capacity_ratio;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                NavItem {
                    icon: "\u{e9ba}";
                    label: "退出登录";
                    enabled: root.logged_in;
                    clicked => { root.logout(); }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: 0px;
            padding: 14px;

            if (!root.logged_in): HorizontalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                alignment: center;
                LoginPanel {
                    width: 420px;
                    height: 520px;
                    error_text: root.login_error;
                    show_captcha: root.show_captcha;
                    captcha_image: root.captcha_image;
                    qr_image: root.qr_image;
                    qr_status_text: root.qr_status;
                    login_loading: root.login_loading;
                    qr_mode: root.qr_mode;
                    saved_accounts: root.saved_accounts;

                    do_login(username, password, captcha) => {
                        root.login_request(username, password, captcha);
                    }
                    do_switch_mode(qr) => {
                        root.switch_mode(qr);
                    }
                    do_qr_refresh() => {
                        root.qr_refresh();
                    }
                    do_quick_login(username) => {
                        root.quick_login(username);
                    }
                }
            }

            if (root.logged_in): Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    x: root.current_page == 0 ? 0px : -28px;
                    opacity: root.current_page == 0 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-in-out; }
                    animate opacity { duration: 180ms; easing: ease-in-out; }

                    CloudPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.current_page == 0;
                        page_title: "个人云";
                        page_subtitle: "管理和同步您的个人文件";
                        files: root.file_list;
                        current_path: root.current_path;
                        status_text: root.status_text;
                        account_name: root.account_name;
                        total_space: root.total_space;
                        used_space: root.used_space;
                        capacity_ratio: root.capacity_ratio;
                        selected_id: root.selected_id;
                        renaming_id: root.renaming_id;
                        transfers: root.transfer_list;
                        searching: root.searching;
                        search_keyword: root.search_keyword;
                        search_results: root.search_results;
                        drop-active: root.drop-active;
                        drop-target-name: root.drop-target-name;

                        open_item(id, name, is_dir) => { root.open_item(id, name, is_dir); }
                        item_context_requested(id, name, is_dir, x, y) => {
                            root.context-item-id = id;
                            root.context-item-name = name;
                            root.context-item-is-dir = is_dir;
                            root.context-menu-x = clamp(x, 12px, root.width - 250px);
                            root.context-menu-y = clamp(y, 12px, root.height - root.context-menu-height - 12px);
                            root.context-menu-visible = true;
                            root.select_item(id);
                        }
                        select_item(id) => { root.select_item(id); }
                        refresh_files() => { root.refresh_files(); }
                        navigate_up() => { root.navigate_up(); }
                        upload_files() => { root.upload_files(); }
                        create_folder() => { root.create_folder(); }
                        search_files(keyword) => { root.search_files(keyword); }
                        clear_search() => { root.clear_search(); }
                        logout() => { root.logout(); }
                        switch_space(space) => {
                            root.switch_space(space);
                            root.current_page = space == "family" ? 1 : 0;
                        }
                        download_file(id) => { root.download_file(id); }
                        delete_file(id) => { root.delete_file(id); }
                        rename_file(id, name) => { root.rename_file(id, name); }
                        copy_file(id) => { root.copy_file(id); }
                        get_link(id) => { root.get_link(id); }
                        cancel_task(id) => { root.cancel_task(id); }
                        make_drag_data(id, name, is_dir) => {
                            root.make_drag_data(id, name, is_dir);
                        }
                        drop_can_accept(event, folder_id) => {
                            root.drop_can_accept(event, folder_id);
                        }
                        drop_requested(event, folder_id) => {
                            root.drop_requested(event, folder_id);
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    x: root.current_page == 1 ? 0px : (root.current_page > 1 ? -28px : 28px);
                    opacity: root.current_page == 1 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-in-out; }
                    animate opacity { duration: 180ms; easing: ease-in-out; }

                    CloudPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.current_page == 1;
                        page_title: "家庭云";
                        page_subtitle: "与家人共享和管理文件";
                        files: root.file_list;
                        current_path: root.current_path;
                        status_text: root.status_text;
                        account_name: root.account_name;
                        total_space: root.total_space;
                        used_space: root.used_space;
                        capacity_ratio: root.capacity_ratio;
                        selected_id: root.selected_id;
                        renaming_id: root.renaming_id;
                        transfers: root.transfer_list;
                        searching: root.searching;
                        search_keyword: root.search_keyword;
                        search_results: root.search_results;
                        drop-active: root.drop-active;
                        drop-target-name: root.drop-target-name;

                        open_item(id, name, is_dir) => { root.open_item(id, name, is_dir); }
                        item_context_requested(id, name, is_dir, x, y) => {
                            root.context-item-id = id;
                            root.context-item-name = name;
                            root.context-item-is-dir = is_dir;
                            root.context-menu-x = clamp(x, 12px, root.width - 250px);
                            root.context-menu-y = clamp(y, 12px, root.height - root.context-menu-height - 12px);
                            root.context-menu-visible = true;
                            root.select_item(id);
                        }
                        select_item(id) => { root.select_item(id); }
                        refresh_files() => { root.refresh_files(); }
                        navigate_up() => { root.navigate_up(); }
                        upload_files() => { root.upload_files(); }
                        create_folder() => { root.create_folder(); }
                        search_files(keyword) => { root.search_files(keyword); }
                        clear_search() => { root.clear_search(); }
                        logout() => { root.logout(); }
                        switch_space(space) => {
                            root.switch_space(space);
                            root.current_page = space == "family" ? 1 : 0;
                        }
                        download_file(id) => { root.download_file(id); }
                        delete_file(id) => { root.delete_file(id); }
                        rename_file(id, name) => { root.rename_file(id, name); }
                        copy_file(id) => { root.copy_file(id); }
                        get_link(id) => { root.get_link(id); }
                        cancel_task(id) => { root.cancel_task(id); }
                        make_drag_data(id, name, is_dir) => {
                            root.make_drag_data(id, name, is_dir);
                        }
                        drop_can_accept(event, folder_id) => {
                            root.drop_can_accept(event, folder_id);
                        }
                        drop_requested(event, folder_id) => {
                            root.drop_requested(event, folder_id);
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    x: root.current_page == 2 ? 0px : (root.current_page > 2 ? -28px : 28px);
                    opacity: root.current_page == 2 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-in-out; }
                    animate opacity { duration: 180ms; easing: ease-in-out; }

                    TransferPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.current_page == 2;
                        used_space: root.used_space;
                        total_space: root.total_space;
                        capacity_ratio: root.capacity_ratio;
                        transfers: root.transfer_list;
                        cancel_task(id) => { root.cancel_task(id); }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    x: root.current_page == 3 ? 0px : 28px;
                    opacity: root.current_page == 3 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-in-out; }
                    animate opacity { duration: 180ms; easing: ease-in-out; }

                    SharePage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.current_page == 3;
                        used_space: root.used_space;
                        total_space: root.total_space;
                        capacity_ratio: root.capacity_ratio;
                        go_personal() => {
                            root.current_page = 0;
                            root.switch_space("personal");
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        visible: root.context-menu-visible;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000000;

        TouchArea {
            clicked => { root.context-menu-visible = false; }
        }
    }

    Rectangle {
        visible: root.context-menu-visible;
        x: root.context-menu-x + 3px;
        y: root.context-menu-y + 5px;
        width: 238px;
        height: root.context-menu-height;
        border-radius: 12px;
        background: #0f172a;
        opacity: root.context-menu-visible ? 0.16 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
    }

    Rectangle {
        visible: root.context-menu-visible;
        x: root.context-menu-x;
        y: root.context-menu-visible ? root.context-menu-y : root.context-menu-y - 8px;
        width: 238px;
        height: root.context-menu-height;
        border-radius: 12px;
        background: #ffffff;
        border-width: 1px;
        border-color: #dbe3ef;
        opacity: root.context-menu-visible ? 1.0 : 0.0;
        animate y { duration: 170ms; easing: ease-out; }
        animate opacity { duration: 150ms; easing: ease-out; }

        VerticalLayout {
            padding: 8px;
            spacing: 3px;

            Text {
                text: root.context-item-name;
                color: #94a3b8;
                font-size: 11px;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                height: 1px;
                background: #eef2f7;
            }

            ContextMenuItem {
                icon: "\u{e89e}";
                label: root.context-item-is-dir ? "打开文件夹" : "预览 / 打开";
                triggered => {
                    root.context-menu-visible = false;
                    root.open_item(root.context-item-id, root.context-item-name, root.context-item-is-dir);
                }
            }

            if !root.context-item-is-dir : ContextMenuItem {
                icon: "\u{e2c4}";
                label: "下载到本地";
                triggered => {
                    root.context-menu-visible = false;
                    root.download_file(root.context-item-id);
                }
            }

            Rectangle {
                visible: !root.context-item-is-dir;
                height: 1px;
                background: #eef2f7;
            }

            ContextMenuItem {
                icon: "\u{e3c9}";
                label: "重命名";
                triggered => {
                    root.context-menu-visible = false;
                    root.rename_file(root.context-item-id, "");
                }
            }

            ContextMenuItem {
                icon: "\u{e14d}";
                label: "复制到当前目录";
                triggered => {
                    root.context-menu-visible = false;
                    root.copy_file(root.context-item-id);
                }
            }

            if !root.context-item-is-dir : ContextMenuItem {
                icon: "\u{e157}";
                label: "提取下载链接";
                triggered => {
                    root.context-menu-visible = false;
                    root.get_link(root.context-item-id);
                }
            }

            Rectangle {
                height: 1px;
                background: #eef2f7;
            }

            ContextMenuItem {
                icon: "\u{e872}";
                label: "删除";
                danger: true;
                triggered => {
                    root.context-menu-visible = false;
                    root.delete_file(root.context-item-id);
                }
            }
        }
    }
}
