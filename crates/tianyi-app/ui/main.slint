// 天翼云盘客户端主窗口
//
// 结构：
//   未登录 → LoginPage（整窗认证界面）
//   已登录 → NavigationView（可折叠）+ 内容区（个人云/家庭云/传输/直链/设置）
//            + 传输抽屉 + 上下文菜单 + 账号菜单 + 确认对话框 + Toast + Tooltip
//
// 保留系统原生标题栏：不自绘标题栏，确保窗口拖动、贴边、双击最大化、DPI 缩放
// 与系统快捷键完全由操作系统负责，避免自绘窗控带来的不可靠行为。
//
// 页面常驻 + visible 切换：切换页面不重建组件，滚动位置、搜索框输入、列表状态都不丢失。

import { ListView } from "std-widgets.slint";
import { Theme } from "theme/tokens.slint";
import { Icon, IconName } from "theme/icons.slint";
import { FileEntry, TransferEntry, CrumbEntry, ModalsApi, TooltipState, LayoutMetrics } from "types.slint";
import { FluentButton } from "components/button.slint";
import { FluentIconButton } from "components/icon-button.slint";
import { FluentNavItem } from "components/nav-item.slint";
import { FluentProgressBar } from "components/progress-bar.slint";
import { FluentMenuItem, FluentMenuDivider } from "components/menu.slint";
import { FluentContentDialog } from "components/dialog.slint";
import { TransferRow } from "components/transfer-row.slint";
import { LoginPage } from "pages/login.slint";
import { CloudPage } from "pages/cloud.slint";
import { TransfersPage } from "pages/transfers.slint";
import { LinksPage, DirectLink } from "pages/links.slint";
import { SettingsPage } from "pages/settings.slint";

// 把 UI 侧全局对象再导出一次，便于 Rust 侧通过 include_modules 访问
//
// `TooltipState` 也在导出列表里：ui_tests.rs 的 `check_tooltip_clears_on_page_switch`
// 必须能从 Rust 侧直接读写这个全局的两个状态位（点亮 / 切页后熄灭），否则那条断言
// 只能靠"气泡没渲染出来"这种多级推断。**导出不改变任何渲染**。
export { Theme } from "theme/tokens.slint";
export { DragOutApi, InputMode, ModalsApi, ModifiersApi, TooltipState } from "types.slint";

export component MainWindow inherits Window {
    title: @tr("天翼云盘");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 620px;
    background: Theme.window-bg;

    // 模态浮层的派生状态：对话框 / 账号菜单 / 右键菜单任意一个在场即为真。
    // 三个分支写在一起而不是嵌进各自的 `changed`：任何一处漏掉复位，
    // 背景控件就会永久退出 Tab 序列。
    property <bool> modals-blocking: root.dialog-open || root.account-menu-open || root.context-open;

    // 写入 `ModalsApi.blocking` 的**唯一赋值点**（消费方只有 ActivateScope，
    // 见 components/activate-scope.slint）。
    //
    // 为什么不是一条属性绑定：Slint 不允许在组件作用域写 `Global.prop: expr`（解析直接失败），
    // 全局属性只能从处理器里赋值。所以表达式留在本地属性上（仍然是响应式的），
    // 由 changed 把变化推给全局——全 UI 只有这一行写它。
    changed modals-blocking => {
        ModalsApi.blocking = root.modals-blocking;
    }

    // ==================== 会话 ====================
    in property <bool> logged-in: false;
    in property <string> account-name: "";
    in property <string> account-initial: "?";
    in property <string> status-text: "";
    in-out property <int> current-page: 0;
    in property <string> version-text: "";

    // ==================== 登录 ====================
    in property <string> login-error: "";
    in property <bool> show-captcha: false;
    in property <image> captcha-image;
    in property <image> qr-image;
    in property <string> qr-status: "";
    /// loading / waiting / scanned / confirmed / expired / error / success
    in property <string> qr-state: "loading";
    in property <bool> login-loading: false;
    in property <bool> qr-mode: false;
    in property <[string]> saved-accounts: [];

    // ==================== 文件浏览 ====================
    in property <[FileEntry]> file-list: [];
    in property <[CrumbEntry]> crumbs: [];
    in property <bool> searching: false;
    in-out property <string> search-keyword: "";
    in property <string> renaming-id: "";
    /// 列表状态：loading / refreshing / ready / empty / empty-search / error / idle
    in property <string> list-state: "idle";
    in property <string> file-error: "";
    /// 当前选中项数量（选择模型的唯一事实来源在 Rust 侧）
    in property <int> selected-count: 0;
    /// 排序：0=名称 1=大小 2=修改时间
    in property <int> sort-key: 0;
    in property <bool> sort-asc: true;
    /// 当前选中行在 file-list 里的下标（-1 = 无选中）。唯一写入点是控制器
    /// `controller/files.rs::set_selection`；窗口只把它透给云盘页做视口跟随。
    in property <int> selection-index: -1;

    // ==================== 容量 ====================
    in property <string> total-space: "";
    in property <string> used-space: "";
    in property <float> capacity-ratio: 0.0;

    // ==================== 传输 ====================
    in property <[TransferEntry]> transfer-list: [];
    in property <[TransferEntry]> active-transfer-list: [];
    in property <int> active-transfers: 0;
    in property <int> finished-transfers: 0;
    in-out property <int> transfer-filter: 0;
    in-out property <bool> transfer-panel-open: false;

    // ==================== 直链 ====================
    in property <[DirectLink]> links: [];

    // ==================== 设置 ====================
    in-out property <int> theme-index: 0;
    /// 0 = 自动（跟随系统），1 = 简中，2 = 繁中，3 = 英文，4 = 日文
    in-out property <int> language-index: 0;
    in property <bool> reduce-motion: false;
    in property <string> download-dir: "";
    in property <string> upload-thread: "";
    in property <string> download-thread: "";
    /// 并发分片数的数值形态：设置页 −/+ 用它判断 1..=8 的可用边界，由控制器回填
    in property <int> upload-thread-count: 3;
    in property <int> download-thread-count: 4;
    in property <string> config-dir: "";
    /// 日志目录（= 配置目录下的 logs/）：设置页「关于」分组里的只读路径行
    in property <string> log-dir: "";

    // ==================== 提示与拖拽 ====================
    in property <string> notice-text: "";
    in property <string> notice-kind: "info";
    /// 去重计数：同一段提示在 3 s 内重复出现时由控制器累加，Toast 用 " ×N" 呈现
    in property <int> notice-count: 1;
    in property <bool> drop-active: false;
    in property <string> drop-target-name: "";

    // ==================== 确认对话框 ====================
    in-out property <bool> dialog-open: false;
    in property <string> dialog-title: "";
    in property <string> dialog-message: "";
    in property <string> dialog-confirm-text: @tr("确定");
    in property <bool> dialog-danger: false;

    // ==================== Tooltip 浮层（渲染端私有状态） ====================
    /// 悬停是否已经持续到延迟结束。lit=false 时不渲染气泡，见文件末尾的 tip-delay
    private property <bool> tip-shown: false;
    /// `TooltipState.visible` 的镜像：Slint 的 `changed` 处理器只接受组件自身的
    /// 属性名（`changed a.b` 不是合法语法），要监听全局属性必须先镜像到本地。
    private property <bool> tip-visible: TooltipState.visible;

    // ==================== 登录回调 ====================
    callback login_request(string, string, string, bool);
    callback qr_refresh();
    callback switch_mode(bool);
    callback quick_login(string);

    // ==================== 文件回调 ====================
    callback open_item(string, string, bool);
    /// 打开当前唯一选中项（列表里按 Enter）
    callback open_selected();
    callback select_item(string, bool, bool);
    callback select_all();
    callback clear_selection();
    /// 方向键 / Home / End / PageUp / PageDown 移动当前行（extend = Shift 扩选）
    callback move_selection(int, bool);
    callback context_requested(string, string, bool, length, length);
    callback refresh_files();
    /// 取消云盘页在途加载（加载态上的"取消"）
    callback cancel_loading();
    callback navigate_up();
    callback navigate_crumb(int);
    callback switch_space(string);
    callback upload_files();
    callback create_folder();
    callback download_selected();
    callback rename_selected();
    callback rename_submitted(string, string);
    callback rename_cancelled(string);
    callback copy_selected();
    callback move_selected_up();
    callback delete_selected();
    callback link_selected();
    callback search_changed(string);
    callback search_submitted(string);
    callback clear_search();
    callback sort_changed(int);
    callback notice_closed();

    // ==================== 传输回调 ====================
    callback pause_task(int);
    callback resume_task(int);
    callback cancel_task(int);
    callback retry_task(int);
    callback remove_task(int);
    callback reveal_task(int);
    callback clear_finished_tasks();
    callback toggle_transfer_panel();
    callback open_download_dir();
    callback transfer_filter_changed(int);

    // ==================== 设置 / 其它 ====================
    callback copy_link(string);
    callback clear_links();
    /// 用系统默认浏览器打开某条直链
    callback open_link(string);
    /// 复制全部直链（每行一条）
    callback copy_all_links();
    callback theme_changed(int);
    /// 0=自动 1=简中 2=繁中 3=英文 4=日文；落盘与切包由控制器负责
    callback language_changed(int);
    callback reduce_motion_changed(bool);
    /// (下载分片数, 上传分片数)：越界值由控制器钳制到 1..=8
    callback thread_count_changed(int, int);
    callback choose_download_dir();
    callback open_config_dir();
    callback open_log_dir();
    callback copy_text(string);
    callback logout();

    // ==================== 确认对话框 ====================
    callback dialog_confirm();
    callback dialog_cancel();

    // ==================== 拖拽 ====================
    callback files_dropped(string);
    pure callback make_drag_data(string, string, bool) -> data-transfer;
    callback drop_can_accept(DropEvent, string) -> DragAction;
    callback drop_requested(DropEvent, string) -> DragAction;

    // ==================== 布局状态 ====================
    // 折叠断点：导航栏折叠后内容区仍有足够宽度显示文件名
    // 判定放进 LayoutMetrics（单一来源），README 与文档一律以它为准
    property <bool> nav-compact: LayoutMetrics.nav-compact-of(root.width);
    // 内容区可用宽度：整窗宽度减去左侧导航栏（折叠 56px / 展开 248px）
    property <length> content-width: root.width - (root.nav-compact ? Theme.nav-width-compact : Theme.nav-width);
    // 文件列表次要列分级：量的是内容区宽度，不是整窗宽度
    // （整窗宽度里有一段属于导航栏，按它算会把默认 1180px 窗口误判成四列）
    property <int> detail-level: LayoutMetrics.detail-level-of(root.content-width);
    property <bool> account-menu-open: false;
    // 右键菜单状态（由控制器写入，菜单面板按此定位）
    in-out property <bool> context-open: false;
    in-out property <length> context-x: 0px;
    in-out property <length> context-y: 0px;
    in-out property <string> context-item-id: "";
    in-out property <string> context-item-name: "";
    in-out property <bool> context-is-dir: false;

    // ==================== 右键菜单的键盘导航 ====================
    /// 上下键当前停留的菜单项序号（-1 = 没有）。
    ///
    /// 序号是**声明顺序上的固定常量**，不是"渲染出来的第几行"：分隔线不占序号，
    /// 隐藏项（文件夹时不渲染"下载/提取直链"）也不占新序号，所以同一个常量在
    /// 两种场景下始终指向同一项，`highlighted: ctx-highlight == N` 直接可比。
    property <int> ctx-highlight: -1;

    changed context-open => {
        // 每次打开都从"无高亮"重新开始。
        // 若默认点亮第一项，菜单一出现的像素就和改动前不同（高亮会染上底色），
        // 而这条轨道要求"打开瞬间无视觉变化"——所以初始 -1，第一次按方向键才点亮。
        if (root.context-open) {
            root.ctx-highlight = -1;
        }
    }

    /// 序号 → 该项此刻是否"可跳过"（可见且 enabled）
    ///
    /// 必须和下面 `ctx-layout` 里每个菜单项的 `if` / `enabled` 表达式逐条对应：
    /// 增删菜单项时，这里、`ctx-trigger` 与那两侧的序号要一起改。
    /// 0=打开 1=下载(仅文件) 2=重命名 3=复制 4=移到上级 5=提取直链(仅文件)
    /// 6=全选 7=取消选择 8=删除
    pure function ctx-item-usable(idx: int) -> bool {
        idx == 0 || idx == 3 || idx == 6 || idx == 8 ? true
            : idx == 1 || idx == 5 ? !root.context-is-dir
            : idx == 2 ? root.selected-count == 1
            : idx == 4 ? root.crumbs.length > 1
            : idx == 7 ? root.selected-count > 0
            : false
    }

    /// 把任意整数折回 0..8 的槽位（负数也要正确绕回，所以是 `((i mod 9) + 9) mod 9`）
    ///
    /// Slint 没有 `%` 运算符（只有 `Math.mod`），且 `Math.mod` 沿用 Rust 的取余语义
    /// （负数结果为负），因此不能省掉那个 `+ 9`。
    pure function ctx-slot(idx: int) -> int {
        Math.mod(Math.mod(idx, 9) + 9, 9)
    }

    /// 从 start 起**向后**找第一个可用项，最多探 9 个槽位；全不可用返回 -1
    ///
    /// Slint 的函数体没有 while/for，所以把 9 次探测展开成三元链：啰嗦但完全可预测，
    /// 也不需要为了"找下一项"引入模型或数组。
    pure function ctx-scan-forward(start: int) -> int {
        root.ctx-item-usable(root.ctx-slot(start)) ? root.ctx-slot(start)
            : root.ctx-item-usable(root.ctx-slot(start + 1)) ? root.ctx-slot(start + 1)
            : root.ctx-item-usable(root.ctx-slot(start + 2)) ? root.ctx-slot(start + 2)
            : root.ctx-item-usable(root.ctx-slot(start + 3)) ? root.ctx-slot(start + 3)
            : root.ctx-item-usable(root.ctx-slot(start + 4)) ? root.ctx-slot(start + 4)
            : root.ctx-item-usable(root.ctx-slot(start + 5)) ? root.ctx-slot(start + 5)
            : root.ctx-item-usable(root.ctx-slot(start + 6)) ? root.ctx-slot(start + 6)
            : root.ctx-item-usable(root.ctx-slot(start + 7)) ? root.ctx-slot(start + 7)
            : root.ctx-item-usable(root.ctx-slot(start + 8)) ? root.ctx-slot(start + 8)
            : -1
    }

    /// 从 start 起**向前**找第一个可用项（上方向键用，方向必须真的反过来）
    pure function ctx-scan-backward(start: int) -> int {
        root.ctx-item-usable(root.ctx-slot(start)) ? root.ctx-slot(start)
            : root.ctx-item-usable(root.ctx-slot(start - 1)) ? root.ctx-slot(start - 1)
            : root.ctx-item-usable(root.ctx-slot(start - 2)) ? root.ctx-slot(start - 2)
            : root.ctx-item-usable(root.ctx-slot(start - 3)) ? root.ctx-slot(start - 3)
            : root.ctx-item-usable(root.ctx-slot(start - 4)) ? root.ctx-slot(start - 4)
            : root.ctx-item-usable(root.ctx-slot(start - 5)) ? root.ctx-slot(start - 5)
            : root.ctx-item-usable(root.ctx-slot(start - 6)) ? root.ctx-slot(start - 6)
            : root.ctx-item-usable(root.ctx-slot(start - 7)) ? root.ctx-slot(start - 7)
            : root.ctx-item-usable(root.ctx-slot(start - 8)) ? root.ctx-slot(start - 8)
            : -1
    }

    /// ↓：下一个可用项；还没有高亮时落到第一个可用项
    function ctx-move-down() {
        root.ctx-highlight = root.ctx-scan-forward(root.ctx-highlight + 1);
    }

    /// ↑：上一个可用项；还没有高亮时落到最后一个可用项（WinUI 的菜单习惯）
    function ctx-move-up() {
        root.ctx-highlight = root.ctx-scan-backward(root.ctx-highlight <= 0 ? -1 : root.ctx-highlight - 1);
    }

    /// 回车：按高亮序号触发对应项。
    ///
    /// 每个分支都调用与菜单项 `triggered` **同一个**函数，避免"鼠标点"和"回车按"
    /// 两条路径各写一份逻辑后慢慢分叉。
    function ctx-trigger(idx: int) {
        if (!root.ctx-item-usable(idx)) {
            return;
        }
        if (idx == 0) {
            root.ctx-open();
        } else if (idx == 1) {
            root.ctx-download();
        } else if (idx == 2) {
            root.ctx-rename();
        } else if (idx == 3) {
            root.ctx-copy();
        } else if (idx == 4) {
            root.ctx-move-to-parent();
        } else if (idx == 5) {
            root.ctx-link();
        } else if (idx == 6) {
            root.ctx-select-all();
        } else if (idx == 7) {
            root.ctx-clear-selection();
        } else if (idx == 8) {
            root.ctx-delete();
        }
    }

    // 右键菜单的动作：鼠标点击与回车共用这一份实现
    function ctx-open() {
        root.context-open = false;
        root.open_item(root.context-item-id, root.context-item-name, root.context-is-dir);
    }
    function ctx-download() {
        root.context-open = false;
        root.download_selected();
    }
    function ctx-rename() {
        root.context-open = false;
        root.rename_selected();
    }
    function ctx-copy() {
        root.context-open = false;
        root.copy_selected();
    }
    /// 移到上级目录（**动作**；与方向键上移高亮的 `ctx-move-up` 是两回事，故独立命名）
    function ctx-move-to-parent() {
        root.context-open = false;
        root.move_selected_up();
    }
    function ctx-link() {
        root.context-open = false;
        root.link_selected();
    }
    function ctx-select-all() {
        root.context-open = false;
        root.select_all();
    }
    function ctx-clear-selection() {
        root.context-open = false;
        root.clear_selection();
    }
    function ctx-delete() {
        root.context-open = false;
        root.delete_selected();
    }
    property <string> capacity-text: root.total-space == "" ? "" : (root.used-space + " / " + root.total-space);
    property <int> capacity-percent: Math.round(Math.min(1.0, Math.max(0.0, root.capacity-ratio)) * 100.0);

    // ==================== 未登录 ====================
    if !root.logged-in: LoginPage {
        login-error: root.login-error;
        login-loading: root.login-loading;
        qr-mode: root.qr-mode;
        captcha-image: root.captcha-image;
        show-captcha: root.show-captcha;
        qr-image: root.qr-image;
        qr-status: root.qr-status;
        qr-state: root.qr-state;
        status-hint: root.status-text;
        saved-accounts: root.saved-accounts;

        do-login(user, pass, captcha, save) => {
            root.login_request(user, pass, captcha, save);
        }
        do-switch-mode(qr) => {
            root.switch_mode(qr);
        }
        do-qr-refresh => {
            root.qr_refresh();
        }
        do-quick-login(name) => {
            root.quick_login(name);
        }
    }

    // ==================== 页面转场（配方 B，见 theme/tokens.slint） ====================
    // 页面容器里的所有页面都是常驻元素（切换只改 visible，不重建），因此重播入场动画
    // 只能由 current-page 的变化驱动：先把不透明度目标落到 0，再由 1ms 单次 Timer 在
    // 下一帧抬回 1 —— 同一帧里改两次属性不会产生动画，必须跨帧。
    // 这条配方只驱动 opacity，不碰任何几何，所以几何回归与采图都不受影响；
    // 状态与定时器放在窗口根部（而不是页面容器里），保证未登录时也不存在访问空元素的问题。
    private property <bool> page-shown: true;

    page-fade := Timer {
        interval: 1ms;
        running: !root.page-shown;
        triggered => {
            root.page-shown = true;
        }
    }

    changed current-page => {
        root.page-shown = false;
        // 切页时收起 Tooltip：气泡由文件末尾的窗口级浮层渲染，而行内按钮（传输行、
        // 直链行里的图标按钮）随页面一起隐藏时**不会**产生 has-hover=false，
        // 气泡会原地常驻、指向一个已经不存在的控件。清零点放在这里与页面转场并列，
        // 互不影响：一个驱动 opacity，一个只关气泡。
        TooltipState.visible = false;
    }

    // ==================== 已登录 ====================
    if root.logged-in: HorizontalLayout {
        // ---------------- 导航栏 ----------------
        nav := Rectangle {
            width: root.nav-compact ? Theme.nav-width-compact : Theme.nav-width;
            // 无障碍：把导航栏标成一个导航区域，辅助技术可以整体跳过或整体进入
            accessible-role: navigation;
            accessible-label: @tr("主导航");
            background: Theme.layer-bg;
            border-width: 1px;
            border-color: Theme.divider;

            animate width {
                duration: Theme.motion-normal;
                easing: ease-in-out;
            }

            VerticalLayout {
                padding-left: root.nav-compact ? Theme.space-1 : Theme.space-2;
                padding-right: root.nav-compact ? Theme.space-1 : Theme.space-2;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-2;
                spacing: Theme.space-05;

                // 品牌
                brand-row := Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-control;
                    background: transparent;

                    Rectangle {
                        x: root.nav-compact ? (parent.width - self.width) / 2 : 4px;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: Theme.accent;

                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: IconName.cloud;
                            size: Theme.icon-sm;
                            icon-color: Theme.text-on-accent;
                        }
                    }

                    if !root.nav-compact: Text {
                        x: 40px;
                        y: 0;
                        width: parent.width - 48px;
                        height: parent.height;
                        text: @tr("天翼云盘");
                        font-family: Theme.font-family;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: Theme.space-2;
                    width: 1px;
                    background: transparent;
                }

                FluentNavItem {
                    icon: IconName.home;
                    label: @tr("个人云");
                    compact: root.nav-compact;
                    selected: root.current-page == 0;
                    clicked => {
                        root.current-page = 0;
                        root.switch_space("personal");
                    }
                }

                FluentNavItem {
                    icon: IconName.people;
                    label: @tr("家庭云");
                    compact: root.nav-compact;
                    selected: root.current-page == 1;
                    clicked => {
                        root.current-page = 1;
                        root.switch_space("family");
                    }
                }

                FluentNavItem {
                    icon: IconName.transfer;
                    label: @tr("传输任务");
                    compact: root.nav-compact;
                    selected: root.current-page == 2;
                    badge: root.active-transfers;
                    clicked => {
                        root.current-page = 2;
                    }
                }

                FluentNavItem {
                    icon: IconName.link;
                    label: @tr("下载直链");
                    compact: root.nav-compact;
                    selected: root.current-page == 3;
                    badge: root.links.length;
                    clicked => {
                        root.current-page = 3;
                    }
                }

                FluentNavItem {
                    icon: IconName.settings;
                    label: @tr("设置");
                    compact: root.nav-compact;
                    selected: root.current-page == 4;
                    clicked => {
                        root.current-page = 4;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    width: 1px;
                    background: transparent;
                }

                // 存储：紧凑信息块（已用 / 总量 / 进度），不再占用大量垂直空间
                if !root.nav-compact: storage-card := Rectangle {
                    height: 62px;
                    border-radius: Theme.radius-card;
                    background: Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.stroke;

                    VerticalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        padding-top: Theme.space-1;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-1;
                        alignment: center;

                        HorizontalLayout {
                            spacing: Theme.space-1;
                            cross-axis-alignment: center;

                            Icon {
                                name: IconName.storage;
                                size: Theme.icon-sm;
                                icon-color: Theme.text-tertiary;
                            }

                            Text {
                                text: @tr("存储");
                                font-family: Theme.font-family;
                                font-size: Theme.font-caption;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: root.total-space == "" ? "—" : root.capacity-percent + "%";
                                font-family: Theme.font-family;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-semibold;
                                color: root.capacity-ratio > 0.9 ? Theme.danger : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        FluentProgressBar {
                            value: root.capacity-ratio * 100.0;
                            bar-height: 3px;
                            bar-color: root.capacity-ratio > 0.9 ? Theme.danger : Theme.accent;
                        }

                        Text {
                            text: root.total-space == "" ? @tr("未获取到容量信息") : root.capacity-text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-caption;
                            color: Theme.text-tertiary;
                            overflow: elide;
                        }
                    }
                }

                // 折叠态：只保留一个可悬停查看的存储指示，不做成"点了没反应"的假按钮
                if root.nav-compact: storage-compact := Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-control;
                    background: storage-ta.has-hover ? Theme.hover-bg : transparent;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: IconName.storage;
                        size: Theme.icon-sm;
                        icon-color: root.capacity-ratio > 0.9 ? Theme.danger : Theme.text-secondary;
                    }

                    storage-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.owner = "storage";
                                TooltipState.text = root.total-space == "" ? @tr("未获取到容量信息")
                                    : @tr("存储 {0}% · {1}", root.capacity-percent, root.capacity-text);
                                TooltipState.x = self.absolute-position.x + self.width + 8px;
                                TooltipState.y = self.absolute-position.y;
                                TooltipState.visible = true;
                            } else if (TooltipState.owner == "storage") {
                                // 只熄灭自己点亮的那盏：鼠标可能已移到别的控件上
                                TooltipState.visible = false;
                            }
                        }
                    }
                }

                // 账号行
                account-row := Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-control;
                    background: account-ta.has-hover || root.account-menu-open ? Theme.hover-bg : transparent;

                    Rectangle {
                        x: root.nav-compact ? (parent.width - self.width) / 2 : 6px;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.accent-soft;

                        Text {
                            text: root.account-initial;
                            font-family: Theme.font-family;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-semibold;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if !root.nav-compact: Text {
                        x: 42px;
                        y: 0;
                        width: parent.width - 72px;
                        height: parent.height;
                        text: root.account-name;
                        font-family: Theme.font-family;
                        font-size: Theme.font-body;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if !root.nav-compact: Icon {
                        x: parent.width - 26px;
                        y: (parent.height - self.height) / 2;
                        name: IconName.more;
                        filled: true;
                        size: Theme.icon-sm;
                        icon-color: Theme.text-tertiary;
                    }

                    account-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.account-menu-open = !root.account-menu-open;
                        }
                    }
                }
            }
        }

        // ---------------- 内容区 ----------------
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // 传输抽屉
            // 展开动效（配方 A）：高度从 0 拉到 260px，视觉上是"拉帘"把内容区往下推。
            // 起点落在"下一帧"（1ms 单次 Timer）：属性的首次求值在 init 之后，init 里直接
            // 抬值等于没有变化，animate 不会启动（实测硬切）。
            // clip 必须开——动画途中内容比容器高，不裁会盖到下面的页面上。
            // 收起仍立即消失：元素由 `if` 销毁，退场动画需要 Rust 侧延迟销毁，本轮不做。
            if root.transfer-panel-open: drawer := Rectangle {
                property <float> reveal: 0.0;

                drawer-timer := Timer {
                    interval: 1ms;
                    running: drawer.reveal < 1.0;
                    triggered => {
                        drawer.reveal = 1.0;
                    }
                }

                height: 260px * (Theme.reduce-motion ? 1.0 : self.reveal);
                clip: true;
                background: Theme.layer-bg;
                border-width: 1px;
                border-color: Theme.divider;

                animate height {
                    duration: Theme.motion-slow;
                    easing: ease-out;
                }

                VerticalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-2;

                    HorizontalLayout {
                        height: 28px;
                        spacing: Theme.space-2;
                        cross-axis-alignment: center;

                        Icon {
                            name: IconName.transfer;
                            size: Theme.icon-sm;
                            icon-color: Theme.accent;
                        }

                        Text {
                            text: @tr("进行中的传输 {0}", root.active-transfers);
                            font-family: Theme.font-family;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-semibold;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 1px;
                            background: transparent;
                        }

                        FluentButton {
                            text: @tr("全部任务");
                            subtle: true;
                            clicked => {
                                root.current-page = 2;
                                root.transfer-panel-open = false;
                            }
                        }

                        FluentIconButton {
                            icon: IconName.chevron-down;
                            tooltip: @tr("收起传输面板");
                            clicked => {
                                root.transfer-panel-open = false;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        if root.active-transfer-list.length > 0: ListView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;

                            // 滚动即收起 Tooltip：行被 ListView 回收时行内按钮不会收到
                            // has-hover=false，气泡会挂在旧位置指着已回收的行。
                            // 滚轮/拖动滚动条/触摸板滑动都会改 viewport-y，因此不必另加
                            // 全窗命中层去截 MouseWheel（那会吞掉点击）。
                            changed viewport-y => {
                                TooltipState.visible = false;
                            }

                            for task in root.active-transfer-list : TransferRow {
                                entry: task;
                                pause-clicked => {
                                    root.pause_task(task.id);
                                }
                                resume-clicked => {
                                    root.resume_task(task.id);
                                }
                                cancel-clicked => {
                                    root.cancel_task(task.id);
                                }
                                retry-clicked => {
                                    root.retry_task(task.id);
                                }
                                remove-clicked => {
                                    root.remove_task(task.id);
                                }
                                reveal-clicked => {
                                    root.reveal_task(task.id);
                                }
                            }
                        }

                        if root.active-transfer-list.length == 0: Text {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            text: @tr("当前没有进行中的传输任务");
                            font-family: Theme.font-family;
                            font-size: Theme.font-small;
                            color: Theme.text-tertiary;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // 页面容器：所有页面常驻，按 current-page 显示，避免切换时丢失滚动位置与输入状态
            //
            // 切页转场（配方 B，见 theme/tokens.slint）：只动 opacity，不动几何——
            // 页面是常驻元素，无法靠 `if` 重建来重播入场动画，只能由 current-page 的变化驱动。
            // 同一帧里把 opacity 目标改两次不会产生动画，所以用 1ms 单次 Timer 跨到下一帧。
            page-host := Rectangle {
                vertical-stretch: 1;
                background: Theme.window-bg;
                opacity: (Theme.reduce-motion || root.page-shown) ? 1.0 : 0.0;

                animate opacity {
                    duration: Theme.motion-normal;
                    easing: ease-out;
                }

                CloudPage {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.current-page < 2;
                    space-label: root.current-page == 1 ? @tr("家庭云") : @tr("个人云");
                    crumbs: root.crumbs;
                    rows: root.file-list;
                    renaming-id: root.renaming-id;
                    searching: root.searching;
                    list-state: root.list-state;
                    detail-level: root.detail-level;
                    selected-count: root.selected-count;
                    sort-key: root.sort-key;
                    sort-asc: root.sort-asc;
                    selection-index: root.selection-index;
                    status-text: root.status-text;
                    capacity-text: root.capacity-text;
                    active-transfers: root.active-transfers;
                    error-text: root.file-error;
                    drop-active: root.drop-active;
                    drop-target-name: root.drop-target-name;
                    context-menu-open: root.context-open;
                    search-text <=> root.search-keyword;

                    select-item(id, ctrl, shift) => {
                        root.select_item(id, ctrl, shift);
                    }
                    select-all => {
                        root.select_all();
                    }
                    move-selection(delta, extend) => {
                        root.move_selection(delta, extend);
                    }
                    clear-selection => {
                        root.clear_selection();
                    }
                    open-item(id, name, is-dir) => {
                        root.open_item(id, name, is-dir);
                    }
                    open-selected => {
                        root.open_selected();
                    }
                    context-requested(id, name, is-dir, x, y) => {
                        root.context_requested(id, name, is-dir, x, y);
                    }
                    navigate-crumb(idx) => {
                        root.navigate_crumb(idx);
                    }
                    navigate-up => {
                        root.navigate_up();
                    }
                    refresh => {
                        root.refresh_files();
                    }
                    cancel-loading => {
                        root.cancel_loading();
                    }
                    upload => {
                        root.upload_files();
                    }
                    create-folder => {
                        root.create_folder();
                    }
                    sort-changed(key) => {
                        root.sort_changed(key);
                    }
                    search-changed(kw) => {
                        root.search_changed(kw);
                    }
                    search-submitted(kw) => {
                        root.search_submitted(kw);
                    }
                    search-cleared => {
                        root.clear_search();
                    }
                    download-selected => {
                        root.download_selected();
                    }
                    rename-selected => {
                        root.rename_selected();
                    }
                    rename-submitted(id, name) => {
                        root.rename_submitted(id, name);
                    }
                    rename-cancelled(id) => {
                        root.rename_cancelled(id);
                    }
                    copy-selected => {
                        root.copy_selected();
                    }
                    move-selected-up => {
                        root.move_selected_up();
                    }
                    delete-selected => {
                        root.delete_selected();
                    }
                    link-selected => {
                        root.link_selected();
                    }
                    toggle-transfers => {
                        root.toggle_transfer_panel();
                    }
                    make-drag-data(id, name, is-dir) => {
                        root.make_drag_data(id, name, is-dir);
                    }
                    drop-can-accept(event, folder-id) => {
                        root.drop_can_accept(event, folder-id);
                    }
                    drop-requested(event, folder-id) => {
                        root.drop_requested(event, folder-id);
                    }
                }

                TransfersPage {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.current-page == 2;
                    rows: root.transfer-list;
                    filter <=> root.transfer-filter;
                    active-count: root.active-transfers;
                    finished-count: root.finished-transfers;

                    filter-changed(idx) => {
                        root.transfer_filter_changed(idx);
                    }
                    pause-task(id) => {
                        root.pause_task(id);
                    }
                    resume-task(id) => {
                        root.resume_task(id);
                    }
                    cancel-task(id) => {
                        root.cancel_task(id);
                    }
                    retry-task(id) => {
                        root.retry_task(id);
                    }
                    remove-task(id) => {
                        root.remove_task(id);
                    }
                    reveal-task(id) => {
                        root.reveal_task(id);
                    }
                    clear-finished => {
                        root.clear_finished_tasks();
                    }
                    open-download-dir => {
                        root.open_download_dir();
                    }
                }

                LinksPage {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.current-page == 3;
                    links: root.links;
                    status-text: root.status-text;

                    copy-link(url) => {
                        root.copy_link(url);
                    }
                    go-personal => {
                        root.current-page = 0;
                        root.switch_space("personal");
                    }
                    clear-links => {
                        root.clear_links();
                    }
                    open-link(url) => {
                        root.open_link(url);
                    }
                    copy-all-links => {
                        root.copy_all_links();
                    }
                }

                SettingsPage {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.current-page == 4;
                    account-name: root.account-name;
                    theme-index: root.theme-index;
                    language-index: root.language-index;
                    reduce-motion: root.reduce-motion;
                    download-dir: root.download-dir;
                    upload-thread: root.upload-thread;
                    download-thread: root.download-thread;
                    upload-thread-count: root.upload-thread-count;
                    download-thread-count: root.download-thread-count;
                    version-text: root.version-text;
                    config-dir: root.config-dir;
                    log-dir: root.log-dir;

                    theme-changed(idx) => {
                        root.theme_changed(idx);
                    }
                    language-changed(idx) => {
                        root.language_changed(idx);
                    }
                    reduce-motion-changed(on) => {
                        root.reduce_motion_changed(on);
                    }
                    thread-count-changed(download, upload) => {
                        root.thread_count_changed(download, upload);
                    }
                    choose-download-dir => {
                        root.choose_download_dir();
                    }
                    open-config-dir => {
                        root.open_config_dir();
                    }
                    open-log-dir => {
                        root.open_log_dir();
                    }
                    copy-text(text) => {
                        root.copy_text(text);
                    }
                    logout => {
                        root.logout();
                    }
                }
            }
        }
    }

    // ==================== Toast（不参与布局，避免页面跳动） ====================
    if root.notice-text != "": toast := Rectangle {
        // 入场动效（配方 A）：淡入 + 8px 上滑。Toast 不参与布局，也没有几何断言，
        // 因此这里可以动 y；其它浮层（右键菜单）只淡入，不动位置。
        property <float> enter-fade: 0.0;

        // 起点落在"下一帧"：属性首次求值在 init 之后，init 里直接抬值不会产生动画（实测硬切）
        Timer {
            interval: 1ms;
            running: toast.enter-fade < 1.0;
            triggered => {
                toast.enter-fade = 1.0;
            }
        }

        width: Math.min(420px, root.width - 32px);
        height: toast-layout.preferred-height;
        x: root.width - self.width - 16px;
        // 底部让开状态栏：状态栏右下角是可点的传输胶囊（cloud.slint 的 task-chip，
        // 点开传输抽屉），Toast 原来恰好盖在它上面 3–8 秒，用户点不到。
        // 未登录页没有状态栏，保持原来的 16px；入场动效的 8px 上滑仍然叠加在最后。
        y: root.height - self.height - 16px
            - (root.logged-in ? Theme.statusbar-height + Theme.space-2 : 0px)
            + (1 - self.enter-fade) * 8px;
        opacity: Theme.reduce-motion ? 1.0 : self.enter-fade;
        border-radius: Theme.radius-card;
        background: Theme.flyout-bg;
        border-width: 1px;
        border-color: root.notice-kind == "error" ? Theme.danger
            : root.notice-kind == "success" ? Theme.success
            : root.notice-kind == "warning" ? Theme.warning
            : Theme.stroke-strong;

        animate opacity {
            duration: Theme.motion-slow;
            easing: ease-out;
        }

        animate y {
            duration: Theme.motion-slow;
            easing: ease-out;
        }

        toast-layout := HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-1;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-2;
            cross-axis-alignment: center;

            Icon {
                name: root.notice-kind == "error" || root.notice-kind == "warning" ? IconName.warning
                    : root.notice-kind == "success" ? IconName.success
                    : IconName.info;
                size: Theme.icon-sm;
                icon-color: root.notice-kind == "error" ? Theme.danger
                    : root.notice-kind == "success" ? Theme.success
                    : root.notice-kind == "warning" ? Theme.warning
                    : Theme.accent;
            }

            Text {
                text: root.notice-text + (root.notice-count > 1 ? " ×" + root.notice-count : "");
                font-family: Theme.font-family;
                font-size: Theme.font-small;
                color: Theme.text-primary;
                horizontal-stretch: 1;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            FluentIconButton {
                icon: IconName.close;
                tooltip: @tr("关闭提示");
                size: 24px;
                icon-size: Theme.icon-xs;
                clicked => {
                    root.notice_closed();
                }
            }
        }
    }

    // ==================== 确认对话框 ====================
    if root.dialog-open: FluentContentDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: root.dialog-title;
        message: root.dialog-message;
        confirm-text: root.dialog-confirm-text;
        danger: root.dialog-danger;

        confirm => {
            root.dialog_confirm();
        }
        cancel => {
            root.dialog_cancel();
        }
    }

    // ==================== 遮罩层：账号菜单 ====================
    if root.account-menu-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => {
                root.account-menu-open = false;
            }
        }
    }

    if root.account-menu-open: menu := Rectangle {
        // 入场淡入（配方 A）。只动 opacity：菜单的位置由导航栏几何反推，
        // 位移会改变"点开就在鼠标位置"的预期。
        property <float> enter-fade: 0.0;

        // 起点落在"下一帧"：属性首次求值在 init 之后，init 里直接抬值不会产生动画（实测硬切）
        Timer {
            interval: 1ms;
            running: menu.enter-fade < 1.0;
            triggered => {
                menu.enter-fade = 1.0;
            }
        }
        opacity: Theme.reduce-motion ? 1.0 : self.enter-fade;

        animate opacity {
            duration: Theme.motion-normal;
            easing: ease-out;
        }

        x: root.nav-compact ? Theme.nav-width-compact + 4px : 12px;
        y: root.height - menu.height - 12px;
        width: 232px;
        height: menu-layout.preferred-height;
        border-radius: Theme.radius-flyout;
        background: Theme.flyout-bg;
        border-width: 1px;
        border-color: Theme.stroke-strong;

        menu-layout := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            Rectangle {
                height: 30px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.account-name;
                        font-family: Theme.font-family;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            FluentMenuDivider {
            }

            FluentMenuItem {
                modal: true;
                icon: IconName.settings;
                label: @tr("设置");
                triggered => {
                    root.account-menu-open = false;
                    root.current-page = 4;
                }
            }

            FluentMenuItem {
                modal: true;
                icon: IconName.folder-open;
                label: @tr("下载目录");
                triggered => {
                    root.account-menu-open = false;
                    root.open_download_dir();
                }
            }

            FluentMenuDivider {
            }

            FluentMenuItem {
                modal: true;
                icon: IconName.logout;
                label: @tr("退出登录");
                danger: true;
                triggered => {
                    root.account-menu-open = false;
                    root.logout();
                }
            }
        }
    }

    // ==================== 遮罩层：文件右键菜单 ====================
    if root.context-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => {
                root.context-open = false;
            }
        }
    }

    if root.context-open: ctx := Rectangle {
        // 入场淡入（配方 A）。**不要**给它加位移/尺寸动画：
        // ui_tests.rs 的 check_context_menu 断言的是本元素的绝对位置与四角是否越界，
        // 位置类动画会让断言读到动画中间态（8px 的余量挡不住）。
        property <float> enter-fade: 0.0;

        // 起点落在"下一帧"：属性首次求值在 init 之后，init 里直接抬值不会产生动画（实测硬切）
        Timer {
            interval: 1ms;
            running: ctx.enter-fade < 1.0;
            triggered => {
                ctx.enter-fade = 1.0;
            }
        }
        opacity: Theme.reduce-motion ? 1.0 : self.enter-fade;

        animate opacity {
            duration: Theme.motion-normal;
            easing: ease-out;
        }

        x: Math.max(8px, Math.min(root.context-x, root.width - self.width - 8px));
        y: Math.max(8px, Math.min(root.context-y, root.height - self.height - 8px));
        width: 236px;
        height: ctx-layout.preferred-height;
        border-radius: Theme.radius-flyout;
        background: Theme.flyout-bg;
        border-width: 1px;
        border-color: Theme.stroke-strong;

        // Esc / ↑↓ / 回车的键盘层。
        //
        // 这一层必须是**菜单内容的祖先**：Slint 沿焦点元素的祖先链派发 key_event
        // （i-slint-core-1.17.1 window.rs:1108-1120），做成平级兄弟时焦点一旦落到某个
        // 菜单项（Tab 或点击都会把焦点移进去），键盘就再也回不到这层。
        // FocusScope 不渲染，给足父级几何后布局与原来逐像素一致。
        //
        // 刻意不套用 components/activate-scope.slint：本层没有"激活"动作，
        // 只有 Esc / 导航键。
        ctx-focus := FocusScope {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            init => {
                self.focus();
            }
            // 焦点一旦被别处拿走（例如用户 Tab 到工具栏），剩下那一下点击不能被它
            // 当成"点我一下给你焦点"吞掉。
            focus-on-click: false;

            KeyBinding {
                keys: @keys(Escape);
                activated => {
                    root.context-open = false;
                }
            }

            // —— 上下键高亮 ——
            //
            // 高亮是**独立于焦点**的状态（`ctx-highlight`），因为菜单项本身不移动焦点：
            // 焦点留在这一层，上下键只改"回车会触发哪一项"，与 WinUI 菜单一致。
            // 初始值 -1 = 没有任何一项高亮，打开菜单的瞬间外观与改动前逐像素相同；
            // 第一次按下方向键才点亮（写进 `changed context-open` 的重置里）。
            KeyBinding {
                keys: @keys(DownArrow);
                activated => {
                    root.ctx-move-down();
                }
            }
            KeyBinding {
                keys: @keys(UpArrow);
                activated => {
                    root.ctx-move-up();
                }
            }
            KeyBinding {
                keys: @keys(Return);
                activated => {
                    root.ctx-trigger(root.ctx-highlight);
                }
            }

            ctx-layout := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                Rectangle {
                    height: 24px;
                    background: transparent;

                    Text {
                        x: 8px;
                        y: 0;
                        width: parent.width - 16px;
                        text: root.context-item-name;
                        font-family: Theme.font-family;
                        font-size: Theme.font-caption;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                FluentMenuDivider {
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 0;
                    icon: root.context-is-dir ? IconName.folder-open : IconName.file;
                    label: root.context-is-dir ? @tr("打开文件夹") : @tr("预览 / 打开");
                    triggered => {
                        root.ctx-open();
                    }
                }

                if !root.context-is-dir: FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 1;
                    icon: IconName.download;
                    label: @tr("下载到本地");
                    triggered => {
                        root.ctx-download();
                    }
                }

                if !root.context-is-dir: FluentMenuDivider {
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 2;
                    icon: IconName.rename;
                    label: @tr("重命名");
                    shortcut: "F2";
                    enabled: root.selected-count == 1;
                    triggered => {
                        root.ctx-rename();
                    }
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 3;
                    icon: IconName.copy;
                    label: @tr("复制到当前目录");
                    triggered => {
                        root.ctx-copy();
                    }
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 4;
                    icon: IconName.folder;
                    label: @tr("移动到上级目录");
                    enabled: root.crumbs.length > 1;
                    triggered => {
                        root.ctx-move-to-parent();
                    }
                }

                if !root.context-is-dir: FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 5;
                    icon: IconName.link;
                    label: @tr("提取直链");
                    triggered => {
                        root.ctx-link();
                    }
                }

                FluentMenuDivider {
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 6;
                    icon: IconName.select-all;
                    label: @tr("全选");
                    shortcut: "Ctrl+A";
                    triggered => {
                        root.ctx-select-all();
                    }
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 7;
                    icon: IconName.close;
                    label: @tr("取消选择");
                    shortcut: "Esc";
                    enabled: root.selected-count > 0;
                    triggered => {
                        root.ctx-clear-selection();
                    }
                }

                FluentMenuDivider {
                }

                FluentMenuItem {
                    modal: true;
                    highlighted: root.ctx-highlight == 8;
                    icon: IconName.delete;
                    label: @tr("删除");
                    shortcut: "Del";
                    danger: true;
                    triggered => {
                        root.ctx-delete();
                    }
                }
            }
        }
    }

    // ==================== 顶层：轻量 Tooltip 浮层 ====================
    // 显示延迟只做在渲染端：写点仍立即写入 text / owner / 坐标，隐藏也立即生效。
    // 悬停必须持续到延迟结束才弹出，鼠标掠过密集控件（工具栏图标）时不再闪烁。
    tip-delay := Timer {
        interval: Theme.reduce-motion ? 0ms : 450ms;
        running: TooltipState.visible && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
        }
    }

    changed tip-visible => {
        if (!root.tip-visible) {
            root.tip-shown = false;
        }
    }

    if TooltipState.visible && root.tip-shown && TooltipState.text != "": tooltip := Rectangle {
        // 出场柔化（配方 A，最短档）：显示延迟（450ms）已经由上面的 Timer 负责，
        // 这段只负责"出现那一瞬"不要硬闪。
        property <float> enter-fade: 0.0;

        // 起点落在"下一帧"：属性首次求值在 init 之后，init 里直接抬值不会产生动画（实测硬切）
        Timer {
            interval: 1ms;
            running: tooltip.enter-fade < 1.0;
            triggered => {
                tooltip.enter-fade = 1.0;
            }
        }
        opacity: Theme.reduce-motion ? 1.0 : self.enter-fade;

        animate opacity {
            duration: Theme.motion-fast;
            easing: ease-out;
        }

        width: Math.min(tip-layout.preferred-width, 420px);
        height: tip-layout.preferred-height;
        x: Math.max(4px, Math.min(TooltipState.x, root.width - self.width - 4px));
        y: Math.min(TooltipState.y, root.height - self.height - 4px);
        border-radius: Theme.radius-control;
        background: Theme.tooltip-bg;
        border-width: 1px;
        border-color: Theme.tooltip-stroke;

        tip-layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: TooltipState.text;
                font-family: Theme.font-family;
                font-size: Theme.font-caption;
                color: Theme.tooltip-text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

