// Fluent 开关（ToggleSwitch）
//
// 语义：用于"立即生效的布尔设置"（如减少动画）。
// 轨道 40x20，滑块 12px，开启态使用强调色；关闭态使用中性描边。

import { Theme } from "../theme/tokens.slint";
import { InputMode } from "../types.slint";
import { ActivateScope } from "activate-scope.slint";

export component FluentSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> text: "";

    callback toggled();

    // 无障碍：开关自身通常没有文字（标签在调用方的行标题里），
    // 因此可读名称由调用方通过内建的 accessible-label 传入；
    // 状态必须映射到 accessible-checked，动作等价于点一下。
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    height: 24px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        alignment: end;
        cross-axis-alignment: center;
        spacing: Theme.space-2;

        if root.text != "": Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 40px;
            height: 20px;
            horizontal-stretch: 0;
            border-radius: 10px;
            background: root.checked ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
                : (touch.has-hover ? Theme.stroke-strong : Theme.stroke-control);

            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            Rectangle {
                y: 3px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.checked ? Theme.text-on-accent : Theme.switch-knob;
                x: root.checked ? track.width - self.width - 3px : 3px;

                animate x {
                    duration: Theme.motion-fast;
                    easing: ease-out;
                }

                // 滑块颜色也要跟着过渡：只动画 x 的话，白↔强调色的切换仍是硬跳
                animate background {
                    duration: Theme.motion-fast;
                    easing: ease-out;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本控件的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // —— 键盘可达性 ——
    // 键盘层与「focus-on-click 为什么必须是 false」的说明都在 activate-scope.slint；
    // Tab 遍历由 Slint 运行时完成。
    fs := ActivateScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        active: root.enabled;
        // Space / Return 与鼠标点击等价：翻转 + 通知
        activated => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
