// Fluent 开关（ToggleSwitch）
//
// 语义：用于"立即生效的布尔设置"（如减少动画）。
// 轨道 40x20，滑块 12px，开启态使用强调色；关闭态使用中性描边。

import { Theme } from "../theme/tokens.slint";
import { InputMode } from "../types.slint";

export component FluentSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> text: "";

    callback toggled();

    // 无障碍：开关自身通常没有文字（标签在调用方的行标题里），
    // 因此可读名称由调用方通过内建的 accessible-label 传入；
    // 状态必须映射到 accessible-checked，动作等价于点一下。
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    height: 24px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        alignment: end;
        cross-axis-alignment: center;
        spacing: Theme.space-2;

        if root.text != "": Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 40px;
            height: 20px;
            horizontal-stretch: 0;
            border-radius: 10px;
            background: root.checked ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
                : (touch.has-hover ? Theme.stroke-strong : Theme.stroke-control);

            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            Rectangle {
                y: 3px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.checked ? Theme.text-on-accent : (Theme.dark ? #C8C8C8 : #FFFFFF);
                x: root.checked ? track.width - self.width - 3px : 3px;

                animate x {
                    duration: Theme.motion-fast;
                    easing: ease-out;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
            }
        }
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // —— 键盘可达性 ——
    // FocusScope 不渲染、不参与布局；Tab 遍历由 Slint 运行时完成。
    // key-pressed: accept = 已处理并终止传递，reject = 交回上一级。
    fs := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;

        // 焦点来源判定交给 InputMode 的单一入口（Tab 进入=键盘，其余=鼠标）
        focus-changed-event(reason) => {
            InputMode.track-focus(reason);
        }

        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
