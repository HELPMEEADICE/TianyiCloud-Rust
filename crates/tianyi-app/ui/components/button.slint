// Fluent 按钮：标准 / 强调 / 次要（无边框）/ 危险 四种外观
//
// 尺寸与 Win11 一致：高 32px、圆角 4px、左右内边距 12px、正文 14px。
// 四种视觉状态（hover / pressed / disabled / busy）都由令牌驱动，不允许页面本地覆盖颜色。

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { FluentSpinner } from "spinner.slint";
import { InputMode, TooltipState } from "../types.slint";
import { ActivateScope } from "activate-scope.slint";

export component FluentButton inherits Rectangle {
    in property <string> text: "";
    /// 强调按钮（主操作，蓝底白字）
    in property <bool> accent: false;
    /// 危险操作（删除等）
    in property <bool> danger: false;
    /// 无边框、无底色，仅悬停时出现底色
    in property <bool> subtle: false;
    in property <bool> enabled: true;
    /// 处理中：显示进度环并禁用点击
    in property <bool> busy: false;
    /// 前置图标（可选）
    in property <IconName> icon: IconName.none;
    /// 最小宽度（主操作按钮用它保持视觉节奏，不应设置成"铺满父容器"）
    in property <length> min-w: 0px;
    /// 悬停提示 / 无文字时的兜底可读名称（传空字符串不显示气泡）
    ///
    /// 窄窗口下批量操作按钮会隐藏文字只留图标（`cloud.slint` 的 `root.narrow`），
    /// 此时按钮的可读名称与悬停说明都只能来自这里。
    in property <string> tooltip: "";

    callback clicked();

    // Tooltip 归属键：文案 + 本实例的绝对位置（与 icon-button.slint 同一套机制）。
    //
    // 只按文案做键时，文案相同的两个实例会互相关灯：后点亮的一方改写 owner 之后，
    // 先悬停的那个实例收尾时关不掉自己的灯，或者干脆把别人的气泡关掉。位置让键
    // 变成实例唯一；文案保留在键里便于调试辨认。点亮与熄灭两处都只读这一个属性，
    // 保证两边用的是**同一个**表达式。
    // 坐标要除以 1px 才是可拼接的纯数字：Slint 不允许把 length 隐式转成 string。
    private property <string> tip-owner: "tip:" + root.tooltip + "@"
        + (self.absolute-position.x / 1px) + "," + (self.absolute-position.y / 1px);

    // 无障碍：暴露 button 角色，可读名称优先取按钮文字，其次取 tooltip。
    // 两者都为空时退化成通用的"按钮"——屏幕阅读器读到一个空名称的按钮，
    // 是比读"按钮"更糟的结果（用户无法判断这一格是什么）。
    // 辅助技术触发的"默认动作"等价于鼠标点一下，走同一个 callback。
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : (root.tooltip != "" ? root.tooltip : "按钮");
    accessible-action-default => {
        root.clicked();
    }

    height: Theme.control-height;
    min-width: root.min-w;
    border-radius: Theme.radius-control;
    border-width: root.subtle || root.accent || root.danger ? 0px : 1px;
    border-color: root.enabled ? Theme.stroke-control : Theme.control-bg-disabled;
    opacity: root.enabled ? 1.0 : 0.45;

    background: !root.enabled ? Theme.control-bg-disabled
        : root.accent ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger ? (touch.pressed ? Theme.danger-pressed : touch.has-hover ? Theme.danger-hover : Theme.danger-soft)
        : root.subtle ? (touch.pressed ? Theme.pressed-bg : touch.has-hover ? Theme.control-bg-hover : transparent)
        : (touch.pressed ? Theme.control-bg-pressed : touch.has-hover ? Theme.control-bg-hover : Theme.control-bg);

    animate background {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        if root.busy: FluentSpinner {
            size: 14px;
            stroke-width: 1.8px;
            tint: root.accent ? Theme.text-on-accent : Theme.accent;
        }

        if !root.busy && root.icon != IconName.none: Icon {
            name: root.icon;
            size: Theme.icon-sm;
            disabled: !root.enabled;
            icon-color: root.accent ? Theme.text-on-accent : (root.danger ? Theme.danger : Theme.text-primary);
        }

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-body-large;
            font-weight: root.accent ? Theme.weight-medium : Theme.weight-regular;
            color: root.accent ? Theme.text-on-accent : (root.danger ? Theme.danger : (root.enabled ? Theme.text-primary : Theme.text-disabled));
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本按钮的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.clicked();
        }

        // 悬停提示：与 `icon-button.slint` 同一套 TooltipState 归属机制
        // （owner / text / x / y / visible），收尾只关自己点亮的那盏灯——
        // 相邻按钮同时收到 has-hover 变化时，谁后熄灭是运行时不保证的顺序。
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                TooltipState.owner = root.tip-owner;
                TooltipState.text = root.tooltip;
                TooltipState.x = self.absolute-position.x;
                TooltipState.y = self.absolute-position.y + self.height + 4px;
                TooltipState.visible = true;
            } else if (TooltipState.owner == root.tip-owner) {
                TooltipState.visible = false;
            }
        }
    }

    // —— 键盘可达性 ——
    // 键盘层（不渲染、不参与布局）与「focus-on-click 为什么必须是 false」的完整说明
    // 都收在 activate-scope.slint 里；这里只给几何与开关。
    // Tab / Shift-Tab 由 Slint 运行时在所有 FocusScope 之间自动移动焦点（见
    // i-slint-core window.rs 的 Tab 分支）。
    fs := ActivateScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        // 禁用/忙时既不可 Tab 到达，也不响应按键（等价于原来在 key-pressed 里判
        // root.busy：busy 时按键照旧被 reject 交回上一级，只是不再响应激活）。
        enabled: root.enabled && !root.busy;
        activated => {
            root.clicked();
        }
    }

    // 焦点环：绝对定位的叠加层，边框画在自身边界内侧，
    // 因此不参与布局，控件的尺寸/位置/内边距/背景一律不变。
    // 只在键盘模式出现（鼠标点击不显示，对齐 WinUI）；不使用动画，reduce-motion 下天然成立。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
