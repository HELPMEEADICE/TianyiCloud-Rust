// Fluent 复选盒（登录页“保存账号”、设置页开关项）

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { InputMode } from "../types.slint";

export component FluentCheckBox inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;

    callback toggled();

    // 无障碍：复选盒的选中态必须跟着实际状态走，否则屏幕阅读器会一直报"未选中"。
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    height: 24px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: root.checked ? Theme.accent : (touch.has-hover ? Theme.control-bg-hover : Theme.control-bg);
            border-width: 1px;
            border-color: root.checked ? Theme.accent : (touch.has-hover ? Theme.accent : Theme.stroke-control);

            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            if root.checked: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: IconName.check;
                size: Theme.icon-xs;
                icon-color: Theme.text-on-accent;
            }
        }

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本控件的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // —— 键盘可达性 ——
    // FocusScope 不渲染、不参与布局；Tab 遍历由 Slint 运行时完成。
    // key-pressed: accept = 已处理并终止传递，reject = 交回上一级。
    fs := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        // 鼠标点击的焦点由 TouchArea 在按下时显式移交。
        // 保留 focus-on-click 会让这个覆盖全控件、且声明在 TouchArea 之后的 FocusScope
        // 把第一次按下吞成"只给焦点"（EventAccepted 终止派发），控件要点第二次才响应。
        focus-on-click: false;

        // 焦点来源判定交给 InputMode 的单一入口（Tab 进入=键盘，其余=鼠标）
        focus-changed-event(reason) => {
            InputMode.track-focus(reason);
        }

        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}