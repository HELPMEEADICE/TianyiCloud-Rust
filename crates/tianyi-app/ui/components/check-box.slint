// Fluent 复选盒（登录页“保存账号”、设置页开关项）

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { InputMode } from "../types.slint";
import { ActivateScope } from "activate-scope.slint";

export component FluentCheckBox inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;

    callback toggled();

    // 无障碍：复选盒的选中态必须跟着实际状态走，否则屏幕阅读器会一直报"未选中"。
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    height: 24px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: root.checked ? Theme.accent : (touch.has-hover ? Theme.control-bg-hover : Theme.control-bg);
            border-width: 1px;
            border-color: root.checked ? Theme.accent : (touch.has-hover ? Theme.accent : Theme.stroke-control);

            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            // 背景在过渡、边框也必须跟着过渡，否则悬停时会出现"底色渐变、描边瞬跳"
            animate border-color {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            // 勾一旦出现就常驻，只动画不透明度：`if` 创建/销毁没有中间态，做不出过渡。
            // 减少动画时 animate 时长为 0，等价于原来的硬切。
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: IconName.check;
                size: Theme.icon-xs;
                icon-color: Theme.text-on-accent;
                opacity: root.checked ? 1.0 : 0.0;

                animate opacity {
                    duration: Theme.motion-fast;
                    easing: ease-out;
                }
            }
        }

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本控件的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // —— 键盘可达性 ——
    // 键盘层与「focus-on-click 为什么必须是 false」的说明都在 activate-scope.slint；
    // Tab 遍历由 Slint 运行时完成。
    fs := ActivateScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        active: root.enabled;
        // Space / Return 与鼠标点击等价：翻转 + 通知
        activated => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
