// Fluent 上下文菜单项与分隔线
//
// 菜单面板本身由调用方（MainWindow）负责定位、圆角与阴影，
// 这里只提供可复用的行与分隔线。

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { InputMode } from "../types.slint";
import { ActivateScope } from "activate-scope.slint";

export component FluentMenuItem inherits Rectangle {
    in property <IconName> icon: IconName.none;
    in property <string> label: "";
    in property <string> shortcut: "";
    in property <bool> danger: false;
    in property <bool> enabled: true;
    /// 菜单项是否位于浮层内部：浮层打开时背景控件要让出 Tab 序列，
    /// 菜单项必须照常可聚焦、可回车触发（见 components/activate-scope.slint）。
    /// 每个实例都显式传 true——漏传只会掉键盘可达性（鼠标仍可点），所以不做隐式默认。
    in property <bool> modal: false;
    /// 键盘上下键当前是否停在本项上。
    ///
    /// 只改底色，不动几何、不加焦点环：高亮与键盘焦点是两件事（焦点一直留在菜单的
    /// FocusScope 上，上下键只改"回车会触发哪一项"），所以不能复用焦点环那条路径。
    in property <bool> highlighted: false;

    callback triggered();

    // 无障碍：Slint 没有 menuitem 角色，用 button 表达"可触发的菜单行"；
    // 快捷键不是按钮文字的一部分，放进 description 供辅助技术附加朗读。
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-action-default => {
        root.triggered();
    }

    height: 32px;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1.0 : 0.4;

    // 高亮与悬停共用同一档底色（危险项共用 danger-soft）：两者都是"下一次点击/回车
    // 会作用在这一项上"，用两套颜色只会让人以为菜单有两层状态。颜色全部来自令牌，
    // 本文件不出现颜色字面量。
    background: !root.enabled ? transparent
        : ta.pressed ? Theme.pressed-bg
        : (ta.has-hover || root.highlighted) ? (root.danger ? Theme.danger-soft : Theme.control-bg-hover)
        : transparent;

    // 菜单行此前完全没有过渡：鼠标划过是硬切。与其它可点控件统一到最快速率。
    animate background {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        cross-axis-alignment: center;

        if root.icon != IconName.none: Icon {
            name: root.icon;
            size: Theme.icon-sm;
            icon-color: root.danger ? Theme.danger : Theme.text-secondary;
            disabled: !root.enabled;
        }

        Text {
            text: root.label;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: root.danger ? Theme.danger : (root.enabled ? Theme.text-primary : Theme.text-disabled);
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.shortcut != "": Text {
            text: root.shortcut;
            font-family: Theme.font-family;
            font-size: Theme.font-caption;
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本行的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.triggered();
        }
    }

    // —— 键盘可达性 ——
    // 键盘层与「focus-on-click 为什么必须是 false」（右键菜单"点不动"的根因）
    // 的完整说明都在 activate-scope.slint；Tab 遍历由 Slint 运行时完成。
    fs := ActivateScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        active: root.enabled;
        modal: root.modal;
        activated => {
            root.triggered();
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}

export component FluentMenuDivider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

