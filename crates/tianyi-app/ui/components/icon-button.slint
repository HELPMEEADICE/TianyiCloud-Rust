// Fluent 图标按钮：32x32 点击区 + 悬停底色 + 工具提示
//
// 图标按钮不承载文字，因此 tooltip 必须给出可读名称（传空字符串不会显示气泡）。

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { InputMode, TooltipState } from "../types.slint";

export component FluentIconButton inherits Rectangle {
    in property <IconName> icon: IconName.none;
    in property <string> tooltip: "";
    in property <bool> enabled: true;
    /// 选中态（如“传输面板已展开”）
    in property <bool> checked: false;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> filled: false;
    in property <length> icon-size: 16px;
    in property <length> size: 32px;

    callback clicked();

    // 无障碍：图标按钮没有文字，可读名称取 tooltip；tooltip 为空时退化成通用的"按钮"，
    // 避免屏幕阅读器读出一个空名称的按钮。
    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : "按钮";
    accessible-action-default => {
        root.clicked();
    }

    width: root.size;
    height: root.size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1.0 : 0.4;

    background: !root.enabled ? transparent
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.control-bg-hover
        : root.checked ? Theme.accent-soft : transparent;

    animate background {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        name: root.icon;
        size: root.icon-size;
        filled: root.filled;
        disabled: !root.enabled;
        icon-color: root.accent ? Theme.accent
            : root.danger ? Theme.danger
            : root.checked ? Theme.accent : Theme.text-primary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
                // 焦点在按下时显式移交给本控件的 FocusScope（见下方 fs 处的说明）
                fs.focus();
            }
        }
        clicked => {
            root.clicked();
        }

        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                // 抢占 + 归属判定：先认领归属键再点亮，收尾只关自己点亮的那盏
                TooltipState.owner = "tip:" + root.tooltip;
                TooltipState.text = root.tooltip;
                TooltipState.x = self.absolute-position.x;
                TooltipState.y = self.absolute-position.y + self.height + 4px;
                TooltipState.visible = true;
            } else if (TooltipState.owner == "tip:" + root.tooltip) {
                TooltipState.visible = false;
            }
        }
    }

    // —— 键盘可达性 ——
    // FocusScope 不渲染、不参与布局；Tab 遍历由 Slint 运行时完成。
    // key-pressed: accept = 已处理并终止传递，reject = 交回上一级。
    fs := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        // 鼠标点击的焦点由 TouchArea 在按下时显式移交。
        // 保留 focus-on-click 会让这个覆盖全控件、且声明在 TouchArea 之后的 FocusScope
        // 把第一次按下吞成"只给焦点"（EventAccepted 终止派发），控件要点第二次才响应。
        focus-on-click: false;

        // 焦点来源判定交给 InputMode 的单一入口（Tab 进入=键盘，其余=鼠标）
        focus-changed-event(reason) => {
            InputMode.track-focus(reason);
        }

        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
