// Fluent 导航项（NavigationView item）
//
// 展开态：图标 + 文本 + 可选徽章；折叠态：仅图标（悬停显示 Tooltip）。
// 选中态：柔和强调底 + 左侧 3px 强调指示条 + 强调色文字 + Filled 图标。
//
// 布局说明：所有子元素都显式定位（不混用布局与自由子元素），
// 触摸层放在最后以保证位于最上层，指针事件稳定命中。
//
// —— 历史缺陷（已修复，不要退回旧写法）——
// 徽章曾经写成 `Rectangle { min-width: 18px; height: 18px; }`，没有给 width。
// Slint 里非布局子元素的 width 默认是「父容器宽度的 100%」，于是徽章从
// `root.width - 34px` 开始又往后铺满一整个导航项宽度，被侧边栏边界裁掉后
// 在「下载直链」/「传输任务」右侧留下一条横向蓝色/灰色胶囊。
// 现在：宽度按位数显式给定（1 位 18px / 2 位 26px / 3 位以上 34px），
// 位置用 `root.width - self.width - 12px` 由自身宽度反推，任何窗口宽度下都
// 完整落在导航项内部，不会被裁切，也不会再出现"拉伸到边界"的假象。

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { InputMode, TooltipState } from "../types.slint";

export component FluentNavItem inherits Rectangle {
    in property <IconName> icon: IconName.none;
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    /// 徽章数字（0 表示不显示）
    in property <int> badge: 0;

    callback clicked();

    // 无障碍：导航项在辅助技术里是"按钮"（Slint 没有 navigation-item 角色）。
    // 折叠态没有文字，accessible-label 刚好补回可读名称；
    // 选中态用描述字段说明"当前页面"，而不是依赖左侧那条纯视觉的指示条。
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? "当前页面" : "";
    accessible-action-default => {
        root.clicked();
    }

    // 徽章尺寸：固定三档，避免尺寸随内容抖动（与 WinUI InfoBadge 一致）
    property <int> badge-tier: root.badge > 99 ? 3 : root.badge > 9 ? 2 : 1;
    property <length> badge-w: root.badge-tier == 3 ? 34px : root.badge-tier == 2 ? 26px : 18px;

    height: Theme.nav-item-height;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1.0 : 0.4;

    background: touch.pressed ? Theme.pressed-bg
        : touch.has-hover && root.enabled ? Theme.hover-bg
        : root.selected ? Theme.accent-soft
        : transparent;

    animate background {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    // 左侧选中指示条（Fluent 2 的 NavigationView 指示器，完整位于组件内）
    Rectangle {
        x: 0;
        y: (root.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.selected ? 1.0 : 0.0;

        animate opacity {
            duration: Theme.motion-normal;
            easing: ease-out;
        }
    }

    // 图标：官方 Fluent 图标，20px（WinUI NavigationView 标准），
    // 选中态切官方 Filled 变体，画布一致所以尺寸与位置完全不变。
    Icon {
        x: root.compact ? (root.width - self.width) / 2 : 12px;
        y: (root.height - self.height) / 2;
        name: root.icon;
        filled: root.selected;
        size: Theme.icon-md;
        icon-color: root.selected ? Theme.accent : Theme.text-primary;
        disabled: !root.enabled;
    }

    // 文本：图标 12px 起 + 20px 图标 + 12px 间距 = 44px
    if !root.compact: Text {
        x: 44px;
        y: 0;
        width: root.width - 44px - (root.badge > 0 ? root.badge-w + 20px : 12px);
        height: root.height;
        text: root.label;
        font-family: Theme.font-family;
        font-size: Theme.font-body-large;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
        color: root.selected ? Theme.accent : Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    // 徽章：宽度显式给定，位置由自身宽度反推，永远在导航项内部
    if !root.compact && root.badge > 0: Rectangle {
        x: root.width - self.width - 12px;
        y: (root.height - 18px) / 2;
        width: root.badge-w;
        height: 18px;
        border-radius: 9px;
        background: root.selected ? Theme.accent : Theme.control-bg-pressed;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.badge > 99 ? "99+" : root.badge;
            font-family: Theme.font-family;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-semibold;
            color: root.selected ? Theme.text-on-accent : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 折叠态的"有任务"小圆点
    if root.compact && root.badge > 0: Rectangle {
        x: root.width - 16px;
        y: 7px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    touch := TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        // 鼠标按下即离开键盘模式：焦点即使仍留在本控件上，焦点环也不显示
        changed pressed => {
            if (self.pressed) {
                InputMode.track-focus(FocusReason.pointer-click);
            }
        }
        clicked => {
            root.clicked();
        }

        // 折叠态没有文字，用 Tooltip 补回可读名称
        // 抢占 + 归属判定：先认领归属键再点亮，收尾只关自己点亮的那盏
        changed has-hover => {
            if (self.has-hover && root.compact && root.label != "") {
                TooltipState.owner = "nav:" + root.label;
                TooltipState.text = root.label;
                TooltipState.x = self.absolute-position.x + self.width + 8px;
                TooltipState.y = self.absolute-position.y + (self.height - 24px) / 2;
                TooltipState.visible = true;
            } else if (TooltipState.owner == "nav:" + root.label) {
                TooltipState.visible = false;
            }
        }
    }

    // —— 键盘可达性 ——
    // FocusScope 不渲染、不参与布局；Tab 遍历由 Slint 运行时完成。
    // key-pressed: accept = 已处理并终止传递，reject = 交回上一级。
    fs := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;

        // 焦点来源判定交给 InputMode 的单一入口（Tab 进入=键盘，其余=鼠标）
        focus-changed-event(reason) => {
            InputMode.track-focus(reason);
        }

        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
