// 空状态 / 加载态 / 错误态占位
//
// 三种场景共用一套版式：图标 → 标题 → 说明 → 可选行动按钮。

import { Theme } from "../theme/tokens.slint";
import { Icon } from "../theme/icons.slint";
import { FluentButton } from "button.slint";

export component FluentEmptyState inherits Rectangle {
    in property <string> glyph: "";
    in property <string> title: "";
    in property <string> description: "";
    in property <string> action-text: "";
    /// 大图标底色（空列表用中性色，错误用警告色由 tint 控制）
    in property <brush> tint: Theme.text-tertiary;
    callback action();

    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 24px;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: Theme.dark ? #303030 : #F0F0F0;

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: root.glyph;
                size: 26px;
                thickness: 1.5px;
                icon-color: root.tint;
            }
        }

        Text {
            text: root.title;
            font-family: Theme.font-family;
            font-size: Theme.font-subtitle;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.description;
            font-family: Theme.font-family;
            font-size: Theme.font-body;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.action-text != "": FluentButton {
            text: root.action-text;
            accent: true;
            min-w: 112px;
            clicked => {
                root.action();
            }
        }
    }
}
