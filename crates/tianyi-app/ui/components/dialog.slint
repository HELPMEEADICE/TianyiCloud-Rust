// Fluent 内容对话框（危险操作确认）
//
// 用于删除文件等不可撤销操作：遮罩 + 居中卡片 + 标题/说明 + 取消/确认。
// 卡片宽度随窗口收缩（不超过 420px），保证窄窗口下不越界。

import { Theme } from "../theme/tokens.slint";
import { Icon, IconName } from "../theme/icons.slint";
import { FluentButton } from "button.slint";

export component FluentContentDialog inherits Rectangle {
    in property <string> title: "";
    in property <string> message: "";
    in property <string> confirm-text: @tr("确定");
    in property <string> cancel-text: @tr("取消");
    /// 危险操作：确认按钮使用危险配色并显示警示图标
    in property <bool> danger: false;

    callback confirm();
    callback cancel();

    // 入场淡入（配方 A，见 theme/tokens.slint 的动效说明）：遮罩与卡片一起从 0 淡到 1。
    // 起点必须落在"下一帧"：属性的首次求值发生在 init 之后，若 init 里直接把值抬到终值，
    // 就没有"变化"可言，animate 不会启动（实测是硬切）。所以用 1ms 单次 Timer 跨帧抬值。
    // 不做 WinUI 那种"卡片放大"——Slint 没有 transform，缩放只能动宽高，而宽高是布局输入。
    property <float> enter-fade: 0.0;

    enter-timer := Timer {
        interval: 1ms;
        running: root.enter-fade < 1.0;
        triggered => {
            root.enter-fade = 1.0;
        }
    }

    // 减少动画时直接取终值，不留"闪一帧全透明"
    opacity: Theme.reduce-motion ? 1.0 : root.enter-fade;

    animate opacity {
        duration: Theme.motion-slow;
        easing: ease-out;
    }

    background: Theme.overlay-scrim;

    /// 两个按钮之间的 Tab 循环
    ///
    /// 为什么必须自己做：Slint 的 `FocusScope` **不拦 Tab**。`window.rs` 在按键
    /// 走完 item 链之后才处理 Tab 分支，直接调 `focus_next_item()` → `move_focus()`
    /// 沿整棵 item 树找下一个可聚焦元素（i-slint-core-1.17.1 window.rs:1315-1343）。
    /// 背景控件那侧由 `ActivateScope` 的 `ModalsApi.blocking` 挡掉了，但普通的
    /// `FocusScope`（例如云盘页的 `list-area`）不在 `ActivateScope` 的管辖内，
    /// 不截住 Tab 的话焦点仍会从对话框里溜出去。
    ///
    /// 顺序：取消 → 确认 → 回到取消；反向（Shift+Tab / Backtab）对称。
    /// 焦点还停在外层 Scope 上（刚打开）时，正向落到"取消"、反向落到"确认"，
    /// 与 WinUI 对话框"默认焦点在撤销项"的约定一致。
    function focus-step(forward: bool) {
        if (forward) {
            if (cancel-btn.has-keyboard-focus()) {
                confirm-btn.take-focus();
            } else {
                cancel-btn.take-focus();
            }
        } else if (confirm-btn.has-keyboard-focus()) {
            cancel-btn.take-focus();
        } else {
            confirm-btn.take-focus();
        }
    }

    // 遮罩与卡片整体包在一层 FocusScope 里。
    //
    // 包起来（而不是像原先那样让 FocusScope 与卡片平级）是为了让这层成为**卡片内
    // 所有可聚焦控件的祖先**：Slint 沿焦点元素的祖先链派发 key_event
    // （window.rs:1108-1120），只有祖先上的 KeyBinding 才收得到 Tab。
    // FocusScope 不渲染，给足父级几何后布局与原来逐像素一致。
    focus-scope := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        init => {
            self.focus();
        }
        // 这层只负责收 Esc / Enter / Tab，不是可点的东西：不管焦点在哪，
        // 点遮罩都必须真的执行"取消"，不能被它当成"点我一下给你焦点"吞掉。
        focus-on-click: false;

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.cancel();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                // 危险操作（删除等）不可撤销：Enter 不能是执行键，
                // 否则连按两下回车就会误删。取消才是这里的默认动作。
                if (root.danger) {
                    root.cancel();
                } else {
                    root.confirm();
                }
            }
        }

        // Tab 拦截必须放在 enabled 上而不是 activated 里 if：KeyBinding 在捕获阶段
        // 判定，条件不成立时按键要能正常往下传（同 pages/cloud.slint 里的总表注释）。
        KeyBinding {
            keys: @keys(Tab);
            activated => {
                root.focus-step(true);
            }
        }

        // Shift+Tab 在 Windows 上以「Tab + shift 修饰键」送达（winit 没有 Backtab
        // 这个 NamedKey，见 i-slint-common key_codes.rs:33/36 与 backend-winit
        // event_loop.rs 的 winit_key_to_char：Tab 有 winit 码，Backtab 一栏是空的），
        // 而 `Keys::matches` 是**精确比对修饰键**（input.rs:764-780）。
        // 某些 X11 布局会直接送 Backtab 的键码，因此两种都绑，行为一致。
        KeyBinding {
            keys: @keys(Shift+Tab);
            activated => {
                root.focus-step(false);
            }
        }

        KeyBinding {
            keys: @keys(Backtab);
            activated => {
                root.focus-step(false);
            }
        }

        // 点击遮罩等同取消
        dismiss := TouchArea {
            clicked => {
                root.cancel();
            }
        }

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                alignment: center;

                card := Rectangle {
                    width: Math.min(420px, root.width - 48px);
                    border-radius: Theme.radius-card;
                    background: Theme.flyout-bg;
                    border-width: 1px;
                    border-color: Theme.stroke-strong;
                    // 投影只加在**卡片**上，不加在 `root`（铺满窗口的遮罩 Rectangle）：
                    // 给遮罩投影等于沿窗口四边描一圈阴影，而遮罩本身就是一层半透明填充，
                    // 描边在它上面完全看不见，只会白白多画一遍 alpha 混合。
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-blur: Theme.shadow-blur;
                    drop-shadow-offset-y: Theme.shadow-offset-y;

                    // 卡片自身吞掉点击，避免穿透到遮罩
                    TouchArea {
                    }

                    VerticalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        padding-top: Theme.space-5;
                        padding-bottom: Theme.space-4;
                        spacing: Theme.space-2;

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            cross-axis-alignment: center;

                            if root.danger: Icon {
                                name: IconName.warning;
                                size: Theme.icon-md;
                                icon-color: Theme.danger;
                            }

                            Text {
                                text: root.title;
                                font-family: Theme.font-family;
                                font-size: Theme.font-subtitle;
                                font-weight: Theme.weight-semibold;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        Text {
                            text: root.message;
                            font-family: Theme.font-family;
                            font-size: Theme.font-body;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: Theme.space-4;
                            width: 1px;
                            background: transparent;
                        }

                        HorizontalLayout {
                            alignment: end;
                            cross-axis-alignment: center;
                            spacing: Theme.space-2;
                            height: Theme.control-height;

                            cancel-btn := FluentButton {
                                text: root.cancel-text;
                                min-w: 80px;
                                modal: true;
                                clicked => {
                                    root.cancel();
                                }
                            }

                            confirm-btn := FluentButton {
                                text: root.confirm-text;
                                accent: !root.danger;
                                danger: root.danger;
                                min-w: 80px;
                                modal: true;
                                clicked => {
                                    root.confirm();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
