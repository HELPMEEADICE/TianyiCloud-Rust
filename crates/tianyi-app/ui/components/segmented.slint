// Fluent 分段控件（Segmented Control）
//
// 用于登录方式切换与传输任务筛选。Win11 样式：浅色沟槽 + 选中段浮起的浅色药丸。

import { Theme } from "../theme/tokens.slint";
import { InputMode } from "../types.slint";

export component FluentSegmented inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;

    callback changed(int);

    height: Theme.control-height;
    border-radius: Theme.radius-control;
    background: Theme.dark ? #2A2A2A : #F0F0F0;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for item[idx] in root.items : Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-control - 1px;
            background: root.current == idx ? (root.enabled ? Theme.card-bg : transparent)
                : seg-ta.has-hover && root.enabled ? Theme.control-bg-hover
                : transparent;

            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            Text {
                text: item;
                font-family: Theme.font-family;
                font-size: Theme.font-body;
                font-weight: root.current == idx ? Theme.weight-semibold : Theme.weight-regular;
                color: root.current == idx ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            seg-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                // 鼠标按下即离开键盘模式（整个分段控件共享一个键盘模式状态）
                changed pressed => {
                    if (self.pressed) {
                        InputMode.track-focus(FocusReason.pointer-click);
                        // 焦点在按下时显式移交给整组的 FocusScope（见下方 fs 处的说明）
                        fs.focus();
                    }
                }
                clicked => {
                    if (root.current != idx) {
                        root.current = idx;
                        root.changed(idx);
                    }
                }
            }
        }
    }

    // —— 键盘可达性 ——
    //
    // 取舍：不给每个分段单独加 FocusScope。分段是"单选组"语义（同一时刻只有一个
    // current），逐段可聚焦会产生 N 个 Tab 停靠点，还会让"当前段"和"焦点段"两个
    // 状态各自漂移。因此整组一个 FocusScope + 左右方向键切换 current：
    // Tab 到达整组，方向键改选中段，语义与 WinUI 的单选组一致。
    //
    // Space / Return 在这里返回 reject（不吞掉）：分段本身没有"激活"动作，
    // 交给父级处理（例如登录页的 Enter 提交），避免把按键吃掉。
    fs := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        // 鼠标点击的焦点由各分段的 TouchArea 在按下时显式移交。
        // 保留 focus-on-click 会让这个覆盖整组、且声明在分段之后（= 命中测试在前）的
        // FocusScope 把第一次按下吞成"只给焦点"（EventAccepted 终止派发），
        // 于是切换筛选项/登录方式要点第二次才生效。
        focus-on-click: false;

        // 焦点来源判定交给 InputMode 的单一入口（Tab 进入=键盘，其余=鼠标）
        focus-changed-event(reason) => {
            InputMode.track-focus(reason);
        }

        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                if (root.current + 1 < root.items.length) {
                    root.current += 1;
                    root.changed(root.current);
                }
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                if (root.current > 0) {
                    root.current -= 1;
                    root.changed(root.current);
                }
                return accept;
            }
            return reject;
        }
    }

    // 焦点环：叠加层 + 内侧边框，不撑大布局；仅键盘模式可见；无动画。
    if fs.has-focus && InputMode.keyboard: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius-control;
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
